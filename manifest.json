{
	"name": "SinleUI",
	"appid": "__UNI__B140C8B",
	"description": "一个简洁、轻巧的现代移动应用UI框架。",
	"versionName": "2.0.4",
	"versionCode": "204",
	"uni-app-x": {
		"styleIsolationVersion": "2",
		"vapor": true,
		"vapor-render-target": "bytecode",
		"vapor-default-script-lang": "ts"
	},
	/* 快应用特有相关 */
	"quickapp": {},
	/* 小程序特有相关 */
	"mp-weixin": {
		"appid": "",
		"setting": {
			"urlCheck": false
		},
		"usingComponents": true,
		"uniStatistics": {
			"enable": false
		}
	},
	"mp-alipay": {
		"usingComponents": true,
		"uniStatistics": {
			"enable": false
		}
	},
	"mp-baidu": {
		"usingComponents": true
	},
	"mp-toutiao": {
		"usingComponents": true
	},
	"uniStatistics": {
		"enable": false,
		"version": "2",
		"type": "public",
		"debug": false,
		"reportInterval": "10"
	},
	"vueVersion": "3",
	"app": {
		"defaultAppTheme": "auto",
		"distribute": {
			"android": {
				"packagename": "com.singmy.sinleui",
				"abiFilters": [
					"arm64-v8a"
				],
				"minSdkVersion": "21",
				"targetSdkVersion": "33"
			},
			"icons": {
				"android": {
					"hdpi": "unpackage/res/icons/72x72.png",
					"xhdpi": "unpackage/res/icons/96x96.png",
					"xxhdpi": "unpackage/res/icons/144x144.png",
					"xxxhdpi": "unpackage/res/icons/192x192.png"
				},
				"ios": {
					"appstore": "unpackage/res/icons/1024x1024.png"
				}
			},
			"splashScreens": {
				"android": {
					"xhdpi": "",
					"xxhdpi": "unpackage/res/splash/splash.9.png",
					"xxxhdpi": ""
				}
			},
			"modules": {
				"uni-ad": {}
			}
		}
	},
	"web": {
		"title": "SinleUI",
		"router": {
			"mode": "hash",
			"base": "/demo/"
		},
		"unipush": {
			"enable": false
		},
		"optimization": {
			"treeShaking": {
				"enable": true
			}
		},
		"devServer": {
			"port": "9865",
			"https": true
		},
		"uniStatistics": {
			"enable": false
		}
	},
	"h5": {
		"title": "SinleUI",
		"router": {
			"mode": "hash",
			"base": "/demo/"
		},
		"optimization": {
			"treeShaking": {
				"enable": true
			}
		}
	},
	"app-android": {
		"distribute": {
			"packagename": "com.singmy.sinleui",
			"abiFilters": [
				"arm64-v8a"
			],
			"minSdkVersion": "21",
			"targetSdkVersion": "33",
			"modules": {},
			"icons": {
				"hdpi": "unpackage/res/icons/72x72.png",
				"xhdpi": "unpackage/res/icons/96x96.png",
				"xxhdpi": "unpackage/res/icons/144x144.png",
				"xxxhdpi": "unpackage/res/icons/192x192.png"
			},
			"splashScreens": {
				"default": {
					"xhdpi": "",
					"xxhdpi": "unpackage/res/splash/splash.9.png",
					"xxxhdpi": ""
				}
			}
		},
		"uniStatistics": {
			"enable": false
		}
	},
	"app-ios": {
		"distribute": {
			"modules": {},
			"icons": {
				"appstore": "unpackage/res/icons/1024x1024.png"
			},
			"splashScreens": {}
		},
		"uniStatistics": {
			"enable": false
		}
	},
	"app-harmony": {
		"distribute": {
			"bundleName": "com.singmy.sinleui"
		},
		"uniStatistics": {
			"enable": false
		}
	}
}