<template>
	<sn-page :title="t('snTabbar.title')" :show-back="false">
		<demo-card :title="t('snTabbar.demoDefaultTitle')" :subtitle="t('snTabbar.demoDefaultSub')" />
		<sn-tabbar v-model:height="inlineHeight" :data="basicData" :fixed="false" custom-contain-style="margin:0 16px;" @change="onBasicChange" @heightchange="onInlineHeightChange" />

		<sn-line margin="24" />

		<demo-card :title="t('snTabbar.demoSizesTitle')" :subtitle="t('snTabbar.demoSizesSub')" />
		<sn-tabbar
			:data="styleData"
			:fixed="false"
			margin="10px"
			padding="$10"
			border="1px solid var(--sn-line)"
			border-radius="$18"
			item-padding="$6"
			item-spacing="$8"
			item-border-radius="$12"
			item-active-bg-color="$primaryLight"
			custom-style="box-shadow:0 8px 24px 0 rgba(0,0,0,0.06);"
			custom-contain-style="margin:0 16px;padding:0 2px;"
		/>

		<sn-line margin="24" />

		<demo-card :title="t('snTabbar.demoColorSizeTitle')" :subtitle="t('snTabbar.demoColorSizeSub')" />
		<sn-tabbar
			:data="mediaData"
			:fixed="false"
			custom-contain-style="margin:0 16px;"
			:bg-color="colorDemoBg"
			:item-bg-color="$transparent"
			:item-active-bg-color="$infoLight"
			:text-color="$textLight"
			:active-text-color="$title"
			:icon-color="$textLight"
			:active-icon-color="$primary"
			text-size="$12"
			icon-size="$24"
			image-size="$24"
		/>

		<sn-line margin="24" />

		<demo-card :title="t('snTabbar.demoTxtTitle')" :subtitle="t('snTabbar.demoTxtSub')" />
		<sn-tabbar :data="textOnlyData" :fixed="false" custom-contain-style="margin:0 16px;" text-size="$13" />

		<sn-line margin="24" />

		<demo-card :title="t('snTabbar.demoIconTitle')" :subtitle="t('snTabbar.demoIconSub')" />
		<sn-tabbar :data="iconOnlyData" :fixed="false" custom-contain-style="margin:0 16px;" icon-size="$24" />

		<sn-line margin="24" />

		<demo-card :title="t('snTabbar.demoFeatureTitle')" :subtitle="t('snTabbar.demoFeatureSub')" />
		<sn-tabbar
			:data="featureData"
			:fixed="false"
			custom-contain-style="margin:0 16px;"
			:show-pages="false"
			item-padding="$4"
			hover-style="background-color: var(--sn-primary-light); transform: scale(0.985);"
			:hover-start-time="0"
			:hover-stay-time="60"
			hover-trans-time="$120"
			:hover-stop-propagation="true"
			@change="onFeatureChange"
		/>

		<sn-line margin="24" />

		<demo-card :title="t('snTabbar.demoDisabledTitle')" :subtitle="t('snTabbar.demoDisabledSub')" />
		<sn-tabbar :data="disabledData" :fixed="false" custom-contain-style="margin:0 16px;" :disabled="true" />

		<sn-line margin="24" />

		<demo-card :title="t('snTabbar.demoHeightTitle')" :subtitle="t('snTabbar.demoHeightSub')">
			<view class="event-log" flatten>
				<sn-text v-if="eventLog != ''" font-size="$13" color="$primary" flatten>{{ eventLog }}</sn-text>
				<sn-text v-else font-size="$13" type="text-light" flatten>{{ t('snTabbar.eventLogHint') }}</sn-text>
			</view>
			<view class="metric-row" flatten>
				<view class="metric-chip" flatten>
					<sn-text font-size="$12" type="text-light" flatten>{{ t('snTabbar.inlineHeightLabel') }}</sn-text>
					<sn-text font-size="$13" bold custom-style="margin-top:4px;" flatten>{{ inlineHeight }}</sn-text>
				</view>
			</view>
		</demo-card>
	</sn-page>
</template>

<script lang="uts" setup>
import { computed } from 'vue'
import { useI18n } from 'vue-i18n'
import { $snui, snu } from '@/uni_modules/sinle-ui'
import type { SnBadgeParams, SnTabbarItem } from '@/uni_modules/sinle-ui/core/types/index.uts'

const { t } = useI18n()

const eventLog = ref<string>('')
const inlineHeight = ref<string>(t('snTabbar.inlineHeightInit'))

const basicData = computed<SnTabbarItem[]>(() => [
	{ icon: 'home-5-line', text: t('snTabbar.home'), activeIcon: 'home-5-fill' },
	{ icon: 'apps-2-line', text: t('snTabbar.discover'), activeIcon: 'apps-2-fill' },
	{ icon: 'message-3-line', text: t('snTabbar.message'), activeIcon: 'message-3-fill' },
	{ icon: 'user-3-line', text: t('snTabbar.mine'), activeIcon: 'user-3-fill' }
])

const pageData = computed<SnTabbarItem[]>(() => [
	{ icon: 'home-5-line', text: t('snTabbar.home'), activeIcon: 'home-5-fill' },
	{ icon: 'community-line', text: t('snTabbar.community'), activeIcon: 'community-fill' },
	{ icon: 'message-3-line', text: t('snTabbar.message'), activeIcon: 'message-3-fill' },
	{ icon: 'user-3-line', text: t('snTabbar.mine'), activeIcon: 'user-3-fill' }
])

const styleData = computed<SnTabbarItem[]>(() => [
	{ icon: 'compass-3-line', text: t('snTabbar.explore'), activeIcon: 'compass-3-fill' },
	{ icon: 'layout-grid-line', text: t('snTabbar.channel'), activeIcon: 'layout-grid-fill' },
	{ icon: 'shopping-bag-3-line', text: t('snTabbar.mall'), activeIcon: 'shopping-bag-3-fill' },
	{ icon: 'user-settings-line', text: t('snTabbar.account'), activeIcon: 'user-settings-fill' }
])

const mediaData = computed<SnTabbarItem[]>(() => {
	return [
		{ icon: 'home-5-line', text: t('snTabbar.home'), activeIcon: 'home-5-fill' },
		{ icon: 'sparkling-2-line', text: t('snTabbar.inspiration'), activeIcon: 'sparkling-2-fill' },
		{ image: '/static/images/logo-inactive.png', activeImage: activeLogo.value, text: t('snTabbar.brand'), activeText: t('snTabbar.brand') },
		{ icon: 'notification-3-line', text: t('snTabbar.remind'), activeIcon: 'notification-3-fill' },
		{ icon: 'user-3-line', text: t('snTabbar.mine'), activeIcon: 'user-3-fill' }
	] as SnTabbarItem[]
})

const textOnlyData = computed<SnTabbarItem[]>(() => [
	{ text: t('snTabbar.home') },
	{ text: t('snTabbar.discover') },
	{ text: t('snTabbar.message') },
	{ text: t('snTabbar.mine') }
])

const iconOnlyData: SnTabbarItem[] = [
	{ icon: 'home-5-line', activeIcon: 'home-5-fill' },
	{ icon: 'search-line', activeIcon: 'search-fill' },
	{ icon: 'notification-3-line', activeIcon: 'notification-3-fill' },
	{ icon: 'settings-3-line', activeIcon: 'settings-3-fill' }
]

const featureData = computed<SnTabbarItem[]>(() => {
	return [
		{ icon: 'home-5-line', text: t('snTabbar.home'), activeIcon: 'home-5-fill' },
		{
			icon: 'community-line',
			text: t('snTabbar.community'),
			activeIcon: 'community-fill',
			interceptor: (): boolean => {
				eventLog.value = t('snTabbar.eventIntercept')
				snu.showToast({ text: t('snTabbar.toastIntercept') })
				return false
			}
		},
		{ image: '/static/images/logo-inactive.png', activeImage: activeLogo.value },
		{
			icon: 'message-3-line',
			text: t('snTabbar.message'),
			activeIcon: 'message-3-fill',
			badge: { value: 6 } as SnBadgeParams
		},
		{ icon: 'user-3-line', text: t('snTabbar.mine'), activeIcon: 'user-3-fill' }
	] as SnTabbarItem[]
})

const disabledData = computed<SnTabbarItem[]>(() => [
	{ icon: 'home-5-line', text: t('snTabbar.home'), activeIcon: 'home-5-fill' },
	{ icon: 'calendar-line', text: t('snTabbar.schedule'), activeIcon: 'calendar-fill' },
	{ icon: 'mail-line', text: t('snTabbar.mail'), activeIcon: 'mail-fill' },
	{ icon: 'settings-3-line', text: t('snTabbar.settingsTag'), activeIcon: 'settings-3-fill' }
])

const activeLogo = computed<string.ImageURIString>(() => {
	return $snui.theme == 'light' ? '/static/images/logo-active-light.png' : '/static/images/logo-active-dark.png'
})

const colorDemoBg = computed<string>(() => {
	return $snui.theme == 'light' ? 'rgba(36, 99, 235, 0.06)' : 'rgba(96, 165, 250, 0.12)'
})

function updateEventLog(text: string): void {
	eventLog.value = text
}

function onBasicChange(index: number): void {
	updateEventLog(t('snTabbar.eventBasic', { index: index } as UTSJSONObject))
}

function onPageChange(index: number): void {
	updateEventLog(t('snTabbar.eventPage', { index: index } as UTSJSONObject))
}

function onFeatureChange(index: number): void {
	updateEventLog(t('snTabbar.eventFeature', { index: index } as UTSJSONObject))
}

function onInlineHeightChange(height: number): void {
	inlineHeight.value = `${height}px`
}
</script>

<style lang="scss">
.event-log {
	margin-top: 4px;
	padding: 14px 16px;
	border-radius: 12px;
	background-color: var(--sn-info-light);
	flex-direction: row;
	align-items: center;
}

.metric-row {
	margin-top: 12px;
	flex-direction: row;
	align-items: stretch;
}

.metric-chip {
	flex: 1;
	padding: 12px 14px;
	border-radius: 12px;
	background-color: var(--sn-front);
	flex-direction: column;
	margin-right: 0;
}
</style>
