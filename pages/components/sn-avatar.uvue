</template>

<script lang="uts" setup>
import { useI18n } from 'vue-i18n'

const { t } = useI18n()
const lastEvent = ref<string>(t('snAvatar.noEvent'))

function onClick(e: UniPointerEvent): void {
	lastEvent.value = 'click'
}

function onDbClick(e: UniPointerEvent): void {
	lastEvent.value = t('snAvatar.dbclick')
}

function onLongpress(e: UniEvent): void {
	lastEvent.value = t('snAvatar.longpress')
}

function onLoad(e: UniImageLoadEvent): void {
	lastEvent.value = t('snAvatar.eventLoad', { width: e.detail.width, height: e.detail.height } as UTSJSONObject)
}

function onError(e: UniImageErrorEvent): void {
	lastEvent.value = t('snAvatar.eventError', { msg: e.detail.errMsg } as UTSJSONObject)
}
</script>

<style lang="scss">
