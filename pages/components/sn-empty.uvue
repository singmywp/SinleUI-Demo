<template>
	<sn-page :title="t('snEmpty.title')" :show-back="true">
		<demo-card :title="t('snEmpty.demoTitle')">
			<sn-form-field :label="t('snEmpty.emptyMode')" :custom-style="rowLineStyle">
				<sn-select v-model="modeIndex" :data="modeOptions" custom-style="flex:1;" />
			</sn-form-field>
			<sn-form-field :label="t('snEmpty.showSlot')" :custom-style="rowLineStyle">
				<sn-switch v-model="showSlot" />
			</sn-form-field>
			<sn-form-field :label="t('snEmpty.themeColor')" :custom-style="rowLastStyle">
				<sn-input v-model="themeColor" custom-style="flex:1;" />
			</sn-form-field>
			<sn-empty :mode="getModeId()" :text="getContent(getModeId())" :theme-color="themeColor"
				custom-style="margin-top:16px;">
				<template #action>
					<sn-button v-if="showSlot" :text="t('snEmpty.back')" custom-style="width:100px;margin:30px auto;" />
				</template>
			</sn-empty>
		</demo-card>

		<demo-card :title="t('snEmpty.externalTitle')" :subtitle="t('snEmpty.externalDesc')">
			<sn-empty mode="data" :text="t('snEmpty.externalClassText')" text-class="demo-empty-text" style="margin-bottom: 12px" />
			<sn-empty mode="search" :text="t('snEmpty.externalStyleText')" text-style="font-weight: bold;" />
		</demo-card>
	</sn-page>
</template>

<script lang="uts" setup>

import { useI18n } from 'vue-i18n'


import type { SnDataItem } from '@/uni_modules/sinle-ui/core/types/index.uts'

const { t } = useI18n()

const modeOptions: SnDataItem[] = [
	{ id: 'schedule', text: t('snEmpty.modeSchedule') },
	{ id: 'card', text: t('snEmpty.modeCard') },
	{ id: 'favor', text: t('snEmpty.modeFavor') },
	{ id: 'coupon', text: t('snEmpty.modeCoupon') },
	{ id: 'data', text: t('snEmpty.modeData') },
	{ id: 'location', text: t('snEmpty.modeLocation') },
	{ id: 'fail', text: t('snEmpty.modeFail') },
	{ id: 'folder', text: t('snEmpty.modeFolder') },
	{ id: 'page1', text: t('snEmpty.modePage1') },
	{ id: 'page2', text: t('snEmpty.modePage2') },
	{ id: 'loading', text: t('snEmpty.modeLoading') },
	{ id: 'message', text: t('snEmpty.modeMessage') },
	{ id: 'star', text: t('snEmpty.modeStar') },
	{ id: 'permission', text: t('snEmpty.modePermission') },
	{ id: 'record', text: t('snEmpty.modeRecord') },
	{ id: 'search', text: t('snEmpty.modeSearch') },
	{ id: 'server', text: t('snEmpty.modeServer') },
	{ id: 'shopping', text: t('snEmpty.modeShopping') },
	{ id: 'network', text: t('snEmpty.modeNetwork') },
	{ id: 'slow', text: t('snEmpty.modeSlow') }
]

const contents: Map<string, string> = new Map([
	['schedule', t('snEmpty.contentSchedule')],
	['card', t('snEmpty.contentCard')],
	['favor', t('snEmpty.contentFavor')],
	['coupon', t('snEmpty.contentCoupon')],
	['data', t('snEmpty.contentData')],
	['location', t('snEmpty.contentLocation')],
	['fail', t('snEmpty.contentFail')],
	['folder', t('snEmpty.contentFolder')],
	['page1', t('snEmpty.contentPage1')],
	['page2', t('snEmpty.contentPage2')],
	['loading', t('snEmpty.contentLoading')],
	['message', t('snEmpty.contentMessage')],
	['star', t('snEmpty.contentStar')],
	['permission', t('snEmpty.contentPermission')],
	['record', t('snEmpty.contentRecord')],
	['search', t('snEmpty.contentSearch')],
	['server', t('snEmpty.contentServer')],
	['shopping', t('snEmpty.contentShopping')],
	['network', t('snEmpty.contentNetwork')],
	['slow', t('snEmpty.contentSlow')]
])

const modeIndex = ref<number>(0)
const showSlot = ref<boolean>(false)
const themeColor = ref<string>('$primary')


const rowLineStyle = 'padding-top:10px;padding-bottom:10px;border-bottom-width:0.5px;border-bottom-style:solid;border-bottom-color:rgba(127,127,127,0.15);'
const rowLastStyle = 'padding-top:10px;padding-bottom:10px;'


function getModeId(): string {
	const list = modeOptions
	const idx = modeIndex.value
	if (idx >= 0 && idx < list.length) {
		const item = list[idx]
		if (item.id != null && item.id != '') {
			return item.id!
		}
	}
	return 'data'
}


function getContent(id: string): string {
	const v = contents.get(id)
	return v != null ? v : ''
}
</script>

<style lang="scss">
.demo-empty-text {
	font-weight: bold;
	letter-spacing: 1px;
}
</style>
