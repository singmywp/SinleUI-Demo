<template>
	<sn-page>
		<sn-topbar :title="t('snTabs.title')"></sn-topbar>

		<demo-card :title="t('snTabs.demoBasicTitle')" :subtitle="t('snTabs.demoBasicSub')">
			<sn-tabs v-model="v1" :data="d1"></sn-tabs>
			<sn-text type="text-light" :font-size="12" :text="t('snTabs.currentSelected', { val: v1 } as UTSJSONObject)" custom-style="margin-top:12px;" flatten />
		</demo-card>

		<demo-card :title="t('snTabs.demoScrollTitle')" :subtitle="t('snTabs.demoScrollSub')">
			<sn-tabs v-model="v2" scrollable :data="d2"></sn-tabs>
			<sn-text type="text-light" :font-size="12" :text="t('snTabs.currentSelected', { val: v2 } as UTSJSONObject)" custom-style="margin-top:12px;" flatten />
		</demo-card>

		<demo-card :title="t('snTabs.demoAniTitle')" :subtitle="t('snTabs.demoAniSub')">
			<sn-tabs v-model="v5" scrollable mode="push" :data="d5"></sn-tabs>
			<sn-text type="text-light" :font-size="12" :text="t('snTabs.currentSelected', { val: v5 } as UTSJSONObject)" custom-style="margin-top:12px;" flatten />
		</demo-card>

		<demo-card :title="t('snTabs.demoDisabledTitle')" :subtitle="t('snTabs.demoDisabledSub')">
			<sn-tabs v-model="v3" :data="d3"></sn-tabs>
			<sn-text type="text-light" :font-size="12" :text="t('snTabs.currentSelected', { val: v3 } as UTSJSONObject)" custom-style="margin-top:12px;" flatten />
		</demo-card>

		<demo-card :title="t('snTabs.demoBadgeTitle')" :subtitle="t('snTabs.demoBadgeSub')">
			<sn-tabs v-model="v4" :data="d4"></sn-tabs>
			<sn-text type="text-light" :font-size="12" :text="t('snTabs.currentSelected', { val: v4 } as UTSJSONObject)" custom-style="margin-top:12px;" flatten />
		</demo-card>

		<demo-card :title="t('snTabs.demoExtTitle')" :subtitle="t('snTabs.demoExtSub')">
			<sn-tabs v-model="v1" :data="d1" item-class="demo-tabs-active"
				active-item-class="demo-tabs-plain" style="margin-bottom: 12px;"></sn-tabs>
			<sn-tabs v-model="v1" :data="d1"
				item-style="background-color: var(--sn-primary-light); border-radius: 6px;"
				active-item-style="opacity: 0.55;"></sn-tabs>
			<sn-tabs v-model="v1" :data="d1" text-class="demo-tabs-text-bold" style="margin-top: 12px;"></sn-tabs>
			<sn-tabs v-model="v1" :data="d1" text-style="color: #f56c6c; font-weight: bold;" style="margin-top: 12px;"></sn-tabs>
			<sn-text flatten type="text-light" :font-size="12" style="margin-top: 12px;" :text="t('snTabs.currentExt', { val: v1 } as UTSJSONObject)" />
		</demo-card>
	</sn-page>
</template>

<script lang="uts" setup>

import { computed } from 'vue'
import { useI18n } from 'vue-i18n'
import type { SnTabParams } from '@/uni_modules/sinle-ui/core/types/index.uts'

const { t } = useI18n()

const v1 = ref<number>(0)
const v2 = ref<number>(0)
const v3 = ref<number>(0)
const v4 = ref<number>(0)
const v5 = ref<number>(0)

const d1 = computed<SnTabParams[]>(() => [
	{ id: 'd1tab1', text: t('snTabs.optionText', { n: 1 } as UTSJSONObject) },
	{ id: 'd1tab2', text: t('snTabs.optionText', { n: 2 } as UTSJSONObject) },
	{ id: 'd1tab3', text: t('snTabs.optionText', { n: 3 } as UTSJSONObject) }
])

const d2 = computed<SnTabParams[]>(() => {
	const arr: SnTabParams[] = []
	for (let i = 1; i <= 8; i++) {
		arr.push({ id: `d2tab${i}`, text: t('snTabs.optionText', { n: i } as UTSJSONObject) })
	}
	return arr
})

const d5 = computed<SnTabParams[]>(() => [
	{ id: 'd5tab1', text: t('snTabs.optA1') },
	{ id: 'd5tab2', text: t('snTabs.optA2') },
	{ id: 'd5tab3', text: t('snTabs.optA3') },
	{ id: 'd5tab4', text: t('snTabs.optA4') },
	{ id: 'd5tab5', text: t('snTabs.optA5') },
	{ id: 'd5tab6', text: t('snTabs.optA6') },
	{ id: 'd5tab7', text: t('snTabs.optA7') },
	{ id: 'd5tab8', text: t('snTabs.optA8') }
])

const d3 = computed<SnTabParams[]>(() => [
	{ id: 'd3tab1', text: t('snTabs.optionText', { n: 1 } as UTSJSONObject) },
	{ id: 'd3tab2', text: t('snTabs.optionText', { n: 2 } as UTSJSONObject), disabled: true },
	{ id: 'd3tab3', text: t('snTabs.optionText', { n: 3 } as UTSJSONObject) },
	{ id: 'd3tab4', text: t('snTabs.optionText', { n: 4 } as UTSJSONObject) }
])

const d4 = computed<SnTabParams[]>(() => [
	{ id: 'd4tab1', text: t('snTabs.optionText', { n: 1 } as UTSJSONObject) },
	{
		id: 'd4tab2',
		text: t('snTabs.optionText', { n: 2 } as UTSJSONObject),
		badgeConfig: {
			mode: 'text',
			text: t('snTabs.badgeHot')
		}
	},
	{
		id: 'd4tab3',
		text: t('snTabs.optionText', { n: 3 } as UTSJSONObject),
		badgeConfig: {
			value: 66
		}
	},
	{
		id: 'd4tab4',
		text: t('snTabs.optionText', { n: 4 } as UTSJSONObject),
		badgeConfig: {
			mode: 'dot',
			size: '7px',
			bgColor: '$primary'
		}
	}
])
</script>

<style lang="scss">
.demo-tabs-active {
	background-color: var(--sn-primary-light);
	border-radius: 6px;
}

.demo-tabs-plain {
	opacity: 0.55;
}

.demo-tabs-text-bold {
	font-weight: bold;
}
</style>
