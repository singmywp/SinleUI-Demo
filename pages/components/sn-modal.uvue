<template>
	<sn-page :title="t('snModal.title')" :show-back="true">

		<sn-alert type="primary" custom-style="margin-left:16px;margin-right:16px;margin-bottom:16px;">
			<sn-text font-size="$12" color="$primary" flatten>{{ t('snModal.alert1') }}</sn-text>
			<sn-text font-size="$12" color="$primary" custom-style="margin-top:4px;" flatten>{{ t('snModal.alert2') }}</sn-text>
			<sn-text font-size="$12" color="$primary" custom-style="margin-top:4px;" flatten>{{ t('snModal.alert3') }}</sn-text>
			<sn-text font-size="$12" color="$primary" custom-style="margin-top:4px;" flatten>{{ t('snModal.alert4') }}</sn-text>
		</sn-alert>

		<demo-card :title="t('snModal.basicTitle')" :subtitle="t('snModal.basicSubtitle')">
			<view class="config-row" flatten>
				<sn-button :text="t('snModal.openModal')" type="primary" custom-style="flex:1;" @click="openModal" />
				<sn-button :text="t('snModal.closeModal')" type="info" custom-style="flex:1;margin-left:10px;" @click="closeModal" />
			</view>
			<sn-text font-size="$12" :color="descColor" custom-style="margin-top:8px;" flatten>{{ t('snModal.basicDesc') }}</sn-text>
		</demo-card>

		<demo-card :title="t('snModal.positionTitle')" :subtitle="t('snModal.positionSubtitle')">
			<view class="btn-row" flatten>
				<sn-button type="info" :text="t('snModal.centerPos')" custom-style="margin-right:8px;flex:1;" @click="openPos('center')" />
				<sn-button type="info" :text="t('snModal.topPos')" custom-style="margin-right:8px;flex:1;" @click="openPos('top')" />
				<sn-button type="info" :text="t('snModal.bottomPos')" custom-style="flex:1;" @click="openPos('bottom')" />
			</view>
			<view class="btn-row" flatten>
				<sn-button type="info" :text="t('snModal.leftPos')" custom-style="margin-right:8px;flex:1;" @click="openPos('left')" />
				<sn-button type="info" :text="t('snModal.rightPos')" custom-style="flex:1;" @click="openPos('right')" />
			</view>
		</demo-card>

		<demo-card :title="t('snModal.btnConfigTitle')" :subtitle="t('snModal.btnConfigSubtitle')">
			<view class="btn-row" flatten>
				<sn-button type="success" :text="t('snModal.onlyConfirmBtn')" custom-style="margin-right:8px;flex:1;" @click="openOnlyConfirm" />
				<sn-button type="error" :text="t('snModal.onlyCancelBtn')" custom-style="flex:1;" @click="openOnlyCancel" />
			</view>
			<view class="btn-row" flatten>
				<sn-button type="warning" :text="t('snModal.customBtnText')" custom-style="margin-right:8px;flex:1;" @click="openCustomText" />
				<sn-button type="primary" :text="t('snModal.floatBtn')" custom-style="flex:1;" @click="openFloat" />
			</view>
		</demo-card>

		<demo-card :title="t('snModal.styleTitle')" :subtitle="t('snModal.styleSubtitle')">
			<view class="btn-row" flatten>
				<sn-button type="primary" :text="t('snModal.customTheme')" custom-style="margin-right:8px;flex:1;" @click="openCustomStyle" />
				<sn-button type="info" :text="t('snModal.disabledBtn')" custom-style="flex:1;" @click="openDisabled" />
			</view>
		</demo-card>

		<demo-card :title="t('snModal.maskTitle')" :subtitle="t('snModal.maskSubtitle')">
			<view class="btn-row" flatten>
				<sn-button type="info" :text="t('snModal.clickMaskClose')" custom-style="margin-right:8px;flex:1;" @click="openMaskClose" />
				<sn-button type="info" :text="t('snModal.darkMask')" custom-style="flex:1;" @click="openDarkMask" />
			</view>
			<view class="btn-row" flatten>
				<sn-button type="warning" :text="t('snModal.preventBack')" custom-style="flex:1;" @click="openPreventBack" />
			</view>
		</demo-card>

		<demo-card :title="t('snModal.eventTitle')" :subtitle="t('snModal.eventSubtitle')">
			<view class="config-row" flatten>
				<sn-text :text="t('snModal.eventResult')" custom-style="width:80px;" flatten />
				<sn-text bold font-size="$14" :text="eventResult" flatten />
			</view>
			<sn-button type="primary" :text="t('snModal.triggerEventDemo')" custom-style="margin-top:10px;flex:1;" @click="openEventModal" />
		</demo-card>

		<demo-card :title="t('snModal.slotTitle')" :subtitle="t('snModal.slotSubtitle')">
			<sn-button type="primary" :text="t('snModal.openSlotModal')" custom-style="flex:1;" @click="openSlotModal" />
			<sn-text font-size="$12" :color="descColor" custom-style="margin-top:8px;" flatten>{{ t('snModal.slotDesc') }}</sn-text>
		</demo-card>

		<demo-card :title="t('snModal.animTitle')" :subtitle="t('snModal.animSubtitle')">
			<view class="btn-row" flatten>
				<sn-button type="primary" :text="t('snModal.bounceIn')" custom-style="margin-right:8px;flex:1;" @click="openBounceModal" />
				<sn-button type="info" :text="t('snModal.flipIn')" custom-style="flex:1;" @click="openFlipModal" />
			</view>
			<sn-text font-size="$12" :color="descColor" custom-style="margin-top:8px;">{{ t('snModal.animDesc') }}</sn-text>
		</demo-card>

		<demo-card :title="t('snModal.longTextTitle')" :subtitle="t('snModal.longTextSubtitle')">
			<view class="btn-row" flatten>
				<sn-button type="primary" :text="t('snModal.chuShiBiao')" custom-style="margin-right:8px;flex:1;" @click="openLongText1" />
				<sn-button type="info" :text="t('snModal.xiaoYaoYou')" custom-style="flex:1;" @click="openLongText4" />
			</view>
			<sn-text font-size="$12" :color="descColor" custom-style="margin-top:8px;">{{ t('snModal.longTextDesc') }}</sn-text>
		</demo-card>

		<demo-card :title="t('snModal.sceneTitle')" :subtitle="t('snModal.sceneSubtitle')">
			<view class="scene-box" :style="sceneBoxStyle">
				<sn-icon name="delete-bin-line" :size="28" color="$error" />
				<sn-text bold font-size="$14" color="$title" :text="t('snModal.deleteNote')" custom-style="margin-top:8px;" />
				<sn-text font-size="$12" color="$textLight" :text="t('snModal.deleteNoteTip')" custom-style="margin-top:4px;" />
			</view>
			<sn-button type="error" :text="t('snModal.deleteNote')" custom-style="margin-top:12px;flex:1;" @click="openDelete" />
		</demo-card>

		
		<sn-modal ref="basicModalRef" :position="posC" :title="basicTitle" :content="basicContent"
			:show-cancel="basicShowCancel" :show-confirm="basicShowConfirm" :confirm-text="basicConfirmText"
			:cancel-text="basicCancelText" :confirm-text-color="basicConfirmColor" :cancel-text-color="basicCancelColor"
			:button-type="basicButtonType" :bg-color="basicBgColor" :border-radius="basicRadius"
			:button-border="basicButtonBorder" :disabled="basicDisabled" :mask-close="basicMaskClose"
			:mask-opacity="basicMaskOpacity" :prevent-back="basicPreventBack"
			@open="onEvent('open')" @close="onEvent('close')" @confirm="onEvent('confirm')"
			@cancel="onEvent('cancel')" @click-mask="onEvent('clickMask')" />

		
		<sn-modal ref="slotModalRef" :mask-close="false" @confirm="onEvent('slot confirm')" @cancel="onEvent('slot cancel')">
			<template #header>
				<view class="slot-header" flatten>
					<sn-icon name="gift-line" :size="20" color="$warning" />
					<sn-text bold font-size="$15" color="$title" :text="t('snModal.exclusiveOffer')" custom-style="margin-left:8px;flex:1" />
				</view>
			</template>
			<template #content>
				<view class="slot-content">
					<sn-text font-size="$13" color="$text" :text="t('snModal.couponCongrats')" custom-style="text-align:center;" />
					<view class="coupon-box" :style="couponStyle" flatten>
						<sn-text bold font-size="$24" color="$error" text="¥20" />
						<sn-text font-size="$12" color="$textLight" :text="t('snModal.minOrder')" custom-style="margin-left:10px;" />
					</view>
					<sn-text font-size="$12" color="$textLight" :text="t('snModal.validUntil')" custom-style="text-align:center;" />
				</view>
			</template>
			<template #actions>
				<view class="slot-actions" style="padding: 15px;" flatten>
					<sn-button type="warning" level="second" :text="t('snModal.useLater')" custom-style="flex:1;margin-right:10px;" @click="closeSlotModal" />
					<sn-button type="warning" :text="t('snModal.useNow')" custom-style="flex:1;" @click="closeSlotModal" />
				</view>
			</template>
		</sn-modal>
		
		<sn-modal ref="bounceModalRef" :mask-close="false" :open-animation="bounceOpenAnim"
			:close-animation="bounceCloseAnim">
			<template #header>
				<sn-text bold font-size="$15" color="$title" :text="t('snModal.bounceIn')" />
			</template>
			<template #content>
				<sn-text font-size="$13" color="$textLight" :text="t('snModal.bounceContent')" custom-style="text-align:center;" />
			</template>
		</sn-modal>

		<sn-modal ref="flipModalRef" :mask-close="false" :open-animation="flipOpenAnim"
			:close-animation="flipCloseAnim">
			<template #header>
				<sn-text bold font-size="$15" color="$title" :text="t('snModal.flipIn')" />
			</template>
			<template #content>
				<sn-text font-size="$13" color="$textLight" :text="t('snModal.flipContent')" custom-style="text-align:center;" />
			</template>
		</sn-modal>
	</sn-page>
</template>

<script lang="uts" setup>

import { useI18n } from 'vue-i18n'
import { useTheme } from '@/uni_modules/sinle-ui/index.uts'
import { longText1, longText4 } from '@/source/longtext.uts'
import type { ComponentPublicInstance } from 'vue'

const { isDark } = useTheme()
const { t } = useI18n()

const descColor = computed<string>(() => isDark.value ? '#CBD5E1' : '#334155')


const basicModalRef = ref<ComponentPublicInstance | null>(null)
const slotModalRef = ref<ComponentPublicInstance | null>(null)
const bounceModalRef = ref<ComponentPublicInstance | null>(null)
const flipModalRef = ref<ComponentPublicInstance | null>(null)


const posC = ref<string>('center')
	const basicTitle = ref<string>(t('snModal.basicModalTitle'))
	const basicContent = ref<string>(t('snModal.basicModalContent'))
	const basicShowCancel = ref<boolean>(true)
	const basicShowConfirm = ref<boolean>(true)
	const basicConfirmText = ref<string>(t('snModal.confirm'))
	const basicCancelText = ref<string>(t('snModal.cancel'))
	const basicConfirmColor = ref<string>('')
	const basicCancelColor = ref<string>('')
	const basicButtonType = ref<string>('embed')
	const basicBgColor = ref<string>('')
	const basicRadius = ref<string>('')
	const basicButtonBorder = ref<string>('')
	const basicDisabled = ref<boolean>(false)
	const basicMaskClose = ref<boolean>(false)
	const basicMaskOpacity = ref<number>(0.4)
	const basicPreventBack = ref<boolean>(false)


	const eventResult = ref<string>(t('snModal.noEvent'))




function openModal(): void {
	resetAll()
	basicTitle.value = t('snModal.basicModalTitle')
	basicContent.value = t('snModal.basicModalContent')
	basicModalRef.value?.$callMethod('open')
}

function closeModal(): void {
	basicModalRef.value?.$callMethod('close')
}

function openPos(position: string): void {
	resetAll()
	posC.value = position
	basicTitle.value = t('snModal.positionDemo')
	basicContent.value = t('snModal.positionContent', { position: position } as UTSJSONObject)
	basicModalRef.value?.$callMethod('open')
}

function openOnlyConfirm(): void {
	resetAll()
	basicTitle.value = t('snModal.onlyConfirm')
	basicContent.value = t('snModal.onlyConfirmContent')
	basicShowCancel.value = false
	basicShowConfirm.value = true
	basicModalRef.value?.$callMethod('open')
}

function openOnlyCancel(): void {
	resetAll()
	basicTitle.value = t('snModal.onlyCancel')
	basicContent.value = t('snModal.onlyCancelContent')
	basicShowCancel.value = true
	basicShowConfirm.value = false
	basicModalRef.value?.$callMethod('open')
}

function openCustomText(): void {
	resetAll()
	basicTitle.value = t('snModal.customBtn')
	basicContent.value = t('snModal.customBtnContent')
	basicConfirmText.value = t('snModal.agree')
	basicCancelText.value = t('snModal.lookAgain')
	basicConfirmColor.value = '$success'
	basicCancelColor.value = '$warning'
	basicModalRef.value?.$callMethod('open')
}

function openFloat(): void {
	resetAll()
	basicTitle.value = t('snModal.floatBtn')
	basicContent.value = t('snModal.floatBtnContent')
	basicButtonType.value = 'float'
	basicModalRef.value?.$callMethod('open')
}

function openCustomStyle(): void {
	resetAll()
	basicTitle.value = t('snModal.customTheme')
	basicContent.value = t('snModal.customThemeContent')
	basicBgColor.value = '$primaryLight'
	basicRadius.value = '$20'
	basicButtonBorder.value = '1px dashed $primary'
	basicModalRef.value?.$callMethod('open')
}

function openDisabled(): void {
	resetAll()
	basicTitle.value = t('snModal.disabledBtn')
	basicContent.value = t('snModal.disabledBtnContent')
	basicDisabled.value = true
	basicModalRef.value?.$callMethod('open')
}

function openMaskClose(): void {
	resetAll()
	basicTitle.value = t('snModal.clickMaskClose')
	basicContent.value = t('snModal.clickMaskCloseContent')
	basicMaskClose.value = true
	basicModalRef.value?.$callMethod('open')
}

function openDarkMask(): void {
	resetAll()
	basicTitle.value = t('snModal.darkMask')
	basicContent.value = t('snModal.darkMaskContent')
	basicMaskOpacity.value = 0.7
	basicModalRef.value?.$callMethod('open')
}

function openPreventBack(): void {
	resetAll()
	basicTitle.value = t('snModal.preventBack')
	basicContent.value = t('snModal.preventBackContent')
	basicPreventBack.value = true
	basicModalRef.value?.$callMethod('open')
}

function openEventModal(): void {
	resetAll()
	eventResult.value = t('snModal.noEvent')
	basicTitle.value = t('snModal.eventDemo')
	basicContent.value = t('snModal.eventDemoContent')
	basicMaskClose.value = true
	basicModalRef.value?.$callMethod('open')
}

function openDelete(): void {
	resetAll()
	basicTitle.value = t('snModal.deleteConfirm')
	basicContent.value = t('snModal.deleteConfirmContent')
	basicConfirmText.value = t('snModal.delete')
	basicConfirmColor.value = '$error'
	basicModalRef.value?.$callMethod('open')
}

function openLongText1(): void {
	resetAll()
	basicTitle.value = t('snModal.chuShiBiao')
	basicContent.value = longText1
	basicModalRef.value?.$callMethod('open')
}

function openLongText4(): void {
	resetAll()
	basicTitle.value = t('snModal.xiaoYaoYou')
	basicContent.value = longText4
	basicModalRef.value?.$callMethod('open')
}


function resetAll(): void {
	posC.value = 'center'
	basicTitle.value = ''
	basicContent.value = ''
	basicShowCancel.value = true
	basicShowConfirm.value = true
	basicConfirmText.value = t('snModal.confirm')
	basicCancelText.value = t('snModal.cancel')
	basicConfirmColor.value = ''
	basicCancelColor.value = ''
	basicButtonType.value = 'embed'
	basicBgColor.value = ''
	basicRadius.value = ''
	basicButtonBorder.value = ''
	basicDisabled.value = false
	basicMaskClose.value = false
	basicMaskOpacity.value = 0.4
	basicPreventBack.value = false
}



function onEvent(name: string): void {
	eventResult.value = t('snModal.event', { name: name } as UTSJSONObject)
}



function openSlotModal(): void {
	slotModalRef.value?.$callMethod('open')
}

function closeSlotModal(): void {
	slotModalRef.value?.$callMethod('close')
}



function openBounceModal(): void {
	bounceModalRef.value?.$callMethod('open')
}

function openFlipModal(): void {
	flipModalRef.value?.$callMethod('open')
}


const bounceOpenAnim = (mask: UniElement | null, content: UniElement | null, duration: number): void => {
	if (mask != null) {
		mask.animate(
			[{ opacity: '0' } as UniAnimationKeyframe, { opacity: '1' } as UniAnimationKeyframe],
			{ duration: duration, easing: 'ease-out', fill: 'forwards' }
		)
	}
	if (content != null) {
		content.animate(
			[
				{ transform: 'scale(0.6)' } as UniAnimationKeyframe,
				{ transform: 'scale(1.08)' } as UniAnimationKeyframe,
				{ transform: 'scale(1)' } as UniAnimationKeyframe
			],
			{ duration: duration, easing: 'ease-out', fill: 'forwards' }
		)
	}
}


const bounceCloseAnim = (mask: UniElement | null, content: UniElement | null, duration: number): void => {
	if (mask != null) {
		mask.animate(
			[{ opacity: '1' } as UniAnimationKeyframe, { opacity: '0' } as UniAnimationKeyframe],
			{ duration: duration, easing: 'ease-in', fill: 'forwards' }
		)
	}
	if (content != null) {
		content.animate(
			[
				{ transform: 'scale(1)' } as UniAnimationKeyframe,
				{ transform: 'scale(1.05)' } as UniAnimationKeyframe,
				{ transform: 'scale(0.4)' } as UniAnimationKeyframe
			],
			{ duration: duration, easing: 'ease-in', fill: 'forwards' }
		)
	}
}


const flipOpenAnim = (mask: UniElement | null, content: UniElement | null, duration: number): void => {
	if (mask != null) {
		mask.animate(
			[{ opacity: '0' } as UniAnimationKeyframe, { opacity: '1' } as UniAnimationKeyframe],
			{ duration: duration, easing: 'ease-out', fill: 'forwards' }
		)
	}
	if (content != null) {
		content.animate(
			[
				{ transform: 'rotateX(80deg)' } as UniAnimationKeyframe,
				{ transform: 'rotateX(0deg)' } as UniAnimationKeyframe
			],
			{ duration: duration, easing: 'ease-out', fill: 'forwards' }
		)
	}
}


const flipCloseAnim = (mask: UniElement | null, content: UniElement | null, duration: number): void => {
	if (mask != null) {
		mask.animate(
			[{ opacity: '1' } as UniAnimationKeyframe, { opacity: '0' } as UniAnimationKeyframe],
			{ duration: duration, easing: 'ease-in', fill: 'forwards' }
		)
	}
	if (content != null) {
		content.animate(
			[
				{ transform: 'rotateX(0deg)' } as UniAnimationKeyframe,
				{ transform: 'rotateX(-80deg)' } as UniAnimationKeyframe
			],
			{ duration: duration, easing: 'ease-in', fill: 'forwards' }
		)
	}
}

const couponStyle = computed((): Map<string, any> => {
	const styles = new Map<string, any>()
	styles.set('flexDirection', 'row')
	styles.set('alignItems', 'center')
	styles.set('justifyContent', 'center')
	styles.set('marginTop', '12px')
	styles.set('marginBottom', '12px')
	styles.set('paddingTop', '12px')
	styles.set('paddingBottom', '12px')
	styles.set('borderRadius', '10px')
	styles.set('backgroundColor', 'var(--sn-warning-light)')
	return styles
})

const sceneBoxStyle = computed((): Map<string, any> => {
	const styles = new Map<string, any>()
	styles.set('alignItems', 'center')
	styles.set('justifyContent', 'center')
	styles.set('paddingTop', '16px')
	styles.set('paddingBottom', '16px')
	styles.set('borderRadius', '12px')
	styles.set('backgroundColor', 'var(--sn-error-light)')
	return styles
})
</script>

<style lang="scss">
.config-row {
	flex-direction: row;
	align-items: center;
}
.btn-row {
	flex-direction: row;
	margin-bottom: 10px;
}
.scene-box {
	flex-direction: column;
}
.slot-header {
	padding: 10px 20px;
	flex-direction: row;
	align-items: center;
}
.slot-content {
	padding: 20px;
	flex-direction: column;
}
.coupon-box {
	flex-direction: row;
}
.slot-actions {
	flex-direction: row;
}
</style>
