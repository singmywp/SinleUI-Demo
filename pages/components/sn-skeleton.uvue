<template>
	<sn-page :title="t('snSkeleton.title')" :show-back="true">
		<demo-card :title="t('snSkeleton.demoBasicTitle')" :subtitle="t('snSkeleton.demoBasicSub')">
			<view class="demo-row" style="margin-bottom: 12px" flatten>
				<sn-skeleton width="44px" height="44px" border-radius="$12" margin="0 12px 0 0" />
				<view class="demo-col" flatten>
					<sn-skeleton width="70%" height="16px" border-radius="$4" margin="2px 0" />
					<sn-skeleton width="100%" height="14px" border-radius="$4" margin="2px 0" />
				</view>
			</view>
			<sn-skeleton width="100%" height="60px" border-radius="$8" />
		</demo-card>

		<demo-card :title="t('snSkeleton.demoGlowTitle')" :subtitle="t('snSkeleton.demoGlowSub')">
			<view class="demo-row" flatten>
				<sn-skeleton width="40px" height="40px" border-radius="$20" margin="0 12px 0 0" />
				<view class="demo-col" flatten>
					<sn-skeleton width="80%" height="16px" border-radius="$4" margin="2px 0" />
					<sn-skeleton width="100%" height="14px" border-radius="$4" margin="2px 0" />
					<sn-skeleton width="55%" height="14px" border-radius="$4" margin="2px 0" />
				</view>
			</view>
			<sn-skeleton width="100%" height="44px" border-radius="$8" margin="0 0 8px 0" />
			<sn-skeleton width="100%" height="44px" border-radius="$8" />
		</demo-card>

		<demo-card :title="t('snSkeleton.demoPulseTitle')" :subtitle="t('snSkeleton.demoPulseSub')">
			<view class="demo-row" style="margin-bottom: 12px" flatten>
				<sn-skeleton mode="pulse" width="40px" height="40px" border-radius="$20" margin="0 12px 0 0" />
				<view class="demo-col" flatten>
					<sn-skeleton mode="pulse" width="80%" height="16px" border-radius="$4" margin="2px 0" />
					<sn-skeleton mode="pulse" width="100%" height="14px" border-radius="$4" margin="2px 0" />
					<sn-skeleton mode="pulse" width="55%" height="14px" border-radius="$4" margin="2px 0" />
				</view>
			</view>
			<sn-skeleton mode="pulse" width="100%" height="44px" border-radius="$8" margin="0 0 8px 0" />
			<sn-skeleton mode="pulse" width="100%" height="44px" border-radius="$8" />
		</demo-card>

		<demo-card :title="t('snSkeleton.demoModeTitle')" :subtitle="t('snSkeleton.demoModeSub')">
			<view class="demo-row" style="margin-bottom: 12px" flatten>
				<sn-skeleton :mode="currentMode" width="44px" height="44px" border-radius="$22" margin="0 12px 0 0" />
				<view class="demo-col" flatten>
					<sn-skeleton :mode="currentMode" width="70%" height="16px" border-radius="$4" margin="2px 0" />
					<sn-skeleton :mode="currentMode" width="100%" height="14px" border-radius="$4" margin="2px 0" />
				</view>
			</view>
			<sn-button @click="toggleMode">
							{{ isPulse ? t('snSkeleton.modePulse') : t('snSkeleton.modeGlow') }}
						</sn-button>
		</demo-card>

		<demo-card :title="t('snSkeleton.demoLoadTitle')" :subtitle="t('snSkeleton.demoLoadSub')">
			<sn-button @click="loading = !loading" style="margin-bottom: 12px">{{ loading==false ? t('snSkeleton.reload') : t('snSkeleton.loadDone')}}</sn-button>
			<view v-if="loading" class="demo-row" flatten>
				<sn-skeleton width="48px" height="48px" border-radius="$1000" margin="0 12px 0 0" />
				<view class="demo-col" flatten>
					<sn-skeleton width="60%" height="16px" border-radius="$4" margin="2px 0" />
					<sn-skeleton width="100%" height="14px" border-radius="$4" margin="2px 0" />
				</view>
			</view>
			<view v-else class="demo-load-result" flatten>
				<sn-avatar src="https://sinleui.pages.dev/logo.png" size="48px" border-radius="$24" />
				<view class="demo-col" style="margin: 0 0 0 12px" flatten>
					<sn-text bold font-size="$15" color="$title" flatten>SinleUI 2.0</sn-text>
					<sn-text font-size="$12" color="$textLight" flatten>{{ t('snSkeleton.frameworkDesc') }}</sn-text>
				</view>
			</view>
		</demo-card>

		<demo-card :title="t('snSkeleton.demoSizeTitle')" :subtitle="t('snSkeleton.demoSizeSub')">
			<sn-skeleton width="100%" height="80px" border-radius="$20" margin="0 0 8px 0" />
			<sn-skeleton width="80%" height="40px" border-radius="$2" margin="0 0 8px 0" />
			<sn-skeleton width="60%" height="40px" border-radius="$20" />
		</demo-card>

		<demo-card :title="t('snSkeleton.demoAniTitle')" :subtitle="t('snSkeleton.demoAniSub')">
			<sn-skeleton width="100%" height="20px" border-radius="$4" ani-time="$500" margin="0 0 8px 0" />
			<sn-skeleton width="100%" height="20px" border-radius="$4" ani-time="$2000" margin="0 0 8px 0" />
			<sn-skeleton width="100%" height="20px" border-radius="$4" ani-time="0" />
		</demo-card>

		<demo-card :title="t('snSkeleton.demoSlotTitle')" :subtitle="t('snSkeleton.demoSlotSub')">
			<sn-skeleton width="100%" height="56px" border-radius="$12">
				<view class="demo-slot-content" flatten>
					<sn-text font-size="$11" color="$textLight" flatten>{{ t('snSkeleton.slotTip') }}</sn-text>
				</view>
			</sn-skeleton>
		</demo-card>
	</sn-page>
</template>

<script lang="uts" setup>
import { useI18n } from 'vue-i18n'

const { t } = useI18n()

const isPulse = ref<boolean>(false)

const currentMode = computed<string>(() => isPulse.value ? 'pulse' : 'glow')

function toggleMode(): void {
	isPulse.value = !isPulse.value
}

const loading = ref<boolean>(true)
</script>

<style lang="scss">
.demo-row {
	flex-direction: row;
	align-items: center;
}
.demo-col {
	flex: 1;
	flex-direction: column;
}
.demo-load-result {
	flex-direction: row;
	align-items: center;
}
.demo-slot-content {
	flex: 1;
	align-items: center;
	justify-content: center;
