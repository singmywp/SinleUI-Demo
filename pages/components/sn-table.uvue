				</sn-tr>
			</sn-table>
		</demo-card>

		<demo-card :title="t('snTable.demoWidthTitle')" :subtitle="t('snTable.demoWidthSub')">
			<sn-table underline>
				<sn-tr :custom-style="headerStyle">
					<sn-td flatten width="2"><text flatten class="td-head">ID</text></sn-td>
					<sn-td flatten width="2"><text flatten class="td-head">{{ t('snTable.headName') }}</text></sn-td>
					<sn-td flatten width="3"><text flatten class="td-head">{{ t('snTable.headCity') }}</text></sn-td>
