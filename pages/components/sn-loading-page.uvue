<template>
	<sn-page :title="t('snLoadingPage.title')" :show-back="true">
		<demo-card :title="t('snLoadingPage.basicTitle')" :subtitle="t('snLoadingPage.basicDesc')">
			<sn-button type="primary" size="normal" @click="openBasic">{{ t('snLoadingPage.openLoading') }}</sn-button>
		</demo-card>

		<demo-card :title="t('snLoadingPage.customTextTitle')" :subtitle="t('snLoadingPage.customTextDesc')">
			<sn-button type="primary" size="normal" @click="openCustomText">{{ t('snLoadingPage.openLoading') }}</sn-button>
		</demo-card>

		<demo-card :title="t('snLoadingPage.iconModeTitle')" :subtitle="t('snLoadingPage.iconModeDesc')">
			<sn-button type="primary" size="normal" @click="openIconMode">{{ t('snLoadingPage.openLoading') }}</sn-button>
		</demo-card>

		<demo-card :title="t('snLoadingPage.imageTitle')" :subtitle="t('snLoadingPage.imageDesc')">
			<view class="demo-row" flatten>
				<sn-button type="primary" size="normal" @click="openImage">{{ t('snLoadingPage.openImageLoading') }}</sn-button>
			</view>
			<sn-text flatten font-size="$12" color="$textLight" custom-style="margin-top:8px;">{{ t('snLoadingPage.imageHint') }}</sn-text>
		</demo-card>

		<demo-card :title="t('snLoadingPage.bgTitle')" :subtitle="t('snLoadingPage.bgDesc')">
			<view class="demo-row" flatten>
				<sn-button type="primary" level="second" size="normal" @click="openCustomBg">{{ t('snLoadingPage.darkBg') }}</sn-button>
				<view class="h-gap" flatten></view>
				<sn-button type="primary" level="second" size="normal" @click="openNoAni">{{ t('snLoadingPage.noAni') }}</sn-button>
			</view>
		</demo-card>

		<demo-card :title="t('snLoadingPage.sceneTitle')" :subtitle="t('snLoadingPage.sceneDesc')">
			<view class="scene-card" flatten>
				<sn-text flatten font-size="$13" color="$text">{{ t('snLoadingPage.dataLoading') }}</sn-text>
				<sn-button type="primary" size="normal" custom-style="margin-top:10px;" @click="openScene">{{ t('snLoadingPage.startLoading') }}</sn-button>
				<sn-text flatten font-size="$12" color="$textLight" custom-style="margin-top:8px;">{{ sceneLog }}</sn-text>
			</view>
		</demo-card>

		<sn-loading-page :show="showBasic" />

		<sn-loading-page :show="showCustomText" :text="t('snLoadingPage.loadingPleaseWait')" text-size="16px" />

		<sn-loading-page :show="showIconMode" mode="icon" icon-color="$primary" />

		<sn-loading-page :show="showImage" img-src="/static/logo-trans.png" text="SinleUI"
			text-style="margin-top:10px;font-weight:bold;" img-style="width:80px;height:80px;" />

		<sn-loading-page :show="showCustomBg" bg-color="$primaryDark" text-color="$primaryText" icon-color="$primaryText"
			:text="t('snLoadingPage.nightLoading')" />

		<sn-loading-page :show="showNoAni" ani-time="0" />

		<sn-loading-page :show="showScene" :text="t('snLoadingPage.pageLoading')" icon-color="$primary" />
	</sn-page>
</template>

<script lang="uts" setup>
import { useI18n } from 'vue-i18n'

const { t } = useI18n()
const showBasic = ref<boolean>(false)
const showCustomText = ref<boolean>(false)
const showIconMode = ref<boolean>(false)
const showImage = ref<boolean>(false)
const showCustomBg = ref<boolean>(false)
const showNoAni = ref<boolean>(false)
const showScene = ref<boolean>(false)

const sceneLog = ref<string>(t('snLoadingPage.sceneHint'))
let closeTimer: number | null = null


function openAndClose(target: Ref<boolean>): void {
	target.value = true
	if (closeTimer != null) {
		clearTimeout(closeTimer)
	}
	closeTimer = setTimeout((): void => {
		target.value = false
		closeTimer = null
	}, 2000)
}

function openBasic(): void {
	openAndClose(showBasic)
}

function openCustomText(): void {
	openAndClose(showCustomText)
}

function openIconMode(): void {
	openAndClose(showIconMode)
}

function openImage(): void {
	openAndClose(showImage)
}

function openCustomBg(): void {
	openAndClose(showCustomBg)
}

function openNoAni(): void {
	openAndClose(showNoAni)
}


function openScene(): void {
	sceneLog.value = t('snLoadingPage.pageLoadingMid')
	showScene.value = true
	if (closeTimer != null) {
		clearTimeout(closeTimer)
	}
	closeTimer = setTimeout((): void => {
		showScene.value = false
		sceneLog.value = t('snLoadingPage.loadComplete')
		closeTimer = null
	}, 2000)
}

onUnmounted((): void => {
	if (closeTimer != null) {
		clearTimeout(closeTimer)
		closeTimer = null
	}
})
</script>

<style lang="scss">
.demo-row {
	flex-direction: row;
	flex-wrap: wrap;
	align-items: center;
}
.h-gap {
	width: 8px;
	height: 8px;
}
.scene-card {
	padding: 14px;
	border-radius: 10px;
	background-color: var(--sn-front);
}
</style>