<template>
	<sn-page :title="t('snToast.title')" :show-back="true">

		<sn-alert type="primary" custom-style="margin-left:16px;margin-right:16px;margin-bottom:16px;">
			<sn-text font-size="$12" color="$primary" flatten>{{ t('snToast.apiNote1') }}</sn-text>
			<sn-text font-size="$12" color="$primary" custom-style="margin-top:4px;" flatten>{{ t('snToast.apiNote2') }}</sn-text>
		</sn-alert>

		<demo-card :title="t('snToast.basicTitle')" :subtitle="t('snToast.basicSubtitle')">
			<sn-text font-size="$13" :color="descColor" custom-style="margin-bottom:12px;" flatten>{{ t('snToast.clickHint') }}</sn-text>
			<view class="btn-row" flatten>
				<sn-button  type="primary" :text="t('snToast.showToast')" custom-style="flex:1;" @click="onShowToast" />
			</view>
		</demo-card>

		<demo-card :title="t('snToast.positionTitle')" :subtitle="t('snToast.positionSubtitle')">
			<view class="btn-row" flatten>
				<sn-button  type="info" :text="t('snToast.top')" custom-style="margin-right:10px;flex:1;" @click="onShowTop" />
				<sn-button  type="info" :text="t('snToast.center')" custom-style="margin-right:10px;flex:1;" @click="onShowCenter" />
				<sn-button  type="info" :text="t('snToast.bottom')" custom-style="flex:1;" @click="onShowBottom" />
			</view>
		</demo-card>

		<demo-card :title="t('snToast.iconTitle')" :subtitle="t('snToast.iconSubtitle')">
			<view class="btn-row" flatten>
				<sn-button  type="success" :text="t('snToast.successIcon')" custom-style="margin-right:10px;flex:1;" @click="onShowSuccess" />
				<sn-button  type="error" :text="t('snToast.errorIcon')" custom-style="margin-right:10px;flex:1;" @click="onShowError" />
				<sn-button  type="warning" :text="t('snToast.loading')" custom-style="flex:1;" @click="onShowLoading" />
			</view>
			<view class="btn-row" flatten>
				<sn-button  type="info" :text="t('snToast.closeLoading')" custom-style="margin-top:10px;flex:1;" @click="onCloseLoading" />
			</view>
		</demo-card>

		<demo-card :title="t('snToast.customTitle')" :subtitle="t('snToast.customSubtitle')">
			<view class="btn-row" flatten>
				<sn-button  type="primary" :text="t('snToast.customTheme')" custom-style="margin-right:10px;flex:1;" @click="onShowCustom" />
				<sn-button  type="info" :text="t('snToast.lightBg')" custom-style="flex:1;" @click="onShowLight" />
			</view>
			<view class="btn-row" flatten>
				<sn-button  type="info" :text="t('snToast.multiLine')" custom-style="margin-top:10px;flex:1;" @click="onShowMultiLine" />
			</view>
		</demo-card>

		<demo-card :title="t('snToast.overrideTitle')" :subtitle="t('snToast.overrideSubtitle')">
			<sn-text font-size="$12" :color="descColor" custom-style="margin-bottom:12px;" flatten>{{ t('snToast.overrideDesc') }}</sn-text>
			<view class="btn-row" flatten>
				<sn-button  type="success" :text="t('snToast.overrideSuccess')" custom-style="margin-right:10px;flex:1;" @click="onShowOverride" />
				<sn-button  type="warning" :text="t('snToast.overrideWarn')" custom-style="flex:1;" @click="onShowOverrideWarn" />
			</view>
		</demo-card>

		<demo-card :title="t('snToast.overlayTitle')" :subtitle="t('snToast.overlaySubtitle')">
			<view class="btn-row" flatten>
				<sn-button  type="primary" :text="t('snToast.overlayBtn')" custom-style="flex:1;" @click="onShowOverlay" />
			</view>
			<sn-text font-size="$12" :color="descColor" custom-style="margin-top:10px;" flatten>{{ t('snToast.overlayDesc') }}</sn-text>
		</demo-card>

		<demo-card :title="t('snToast.externalTitle')" :subtitle="t('snToast.externalSubtitle')">
			<view class="btn-row" flatten>
				<sn-button type="primary" :text="t('snToast.externalClass')" custom-style="margin-right:10px;flex:1;" @click="onShowToastClass" />
				<sn-button type="info" :text="t('snToast.externalStyle')" custom-style="flex:1;" @click="onShowToastStyle" />
			</view>
		</demo-card>

		<demo-card :title="t('snToast.sceneTitle')" :subtitle="t('snToast.sceneSubtitle')">
			<view class="scene-box" :style="sceneBoxStyle" flatten>
				<sn-icon flatten name="user-line" :size="28" color="$primary" />
				<sn-text bold font-size="$14" color="$title" :text="t('snToast.sceneTitle2')" custom-style="margin-top:8px;" flatten />
				<sn-text font-size="$12" color="$textLight" :text="t('snToast.sceneDesc')" custom-style="margin-top:4px;" flatten />
			</view>
			<sn-button  type="primary" :text="t('snToast.submitModify')" custom-style="margin-top:12px;flex:1;" @click="onSubmit" />
		</demo-card>

		<sn-toast ref="toastRef" :text="t('snToast.toastText')" />
		<sn-toast ref="toastClassRef" :text="t('snToast.toastClassText')" />
		<sn-toast ref="toastStyleRef" :text="t('snToast.toastStyleText')" custom-style="border:2px solid #ffffff;transform:scale(1.06);" />
	</sn-page>
</template>

<script lang="uts" setup>

import { useI18n } from 'vue-i18n'
import { useTheme } from '@/uni_modules/sinle-ui/index.uts'
import type { ComponentPublicInstance } from 'vue'
import type { SnToastParams } from '@/uni_modules/sinle-ui/core/types/index.uts'

const { t } = useI18n()
const { isDark } = useTheme()

const descColor = computed<string>(() => isDark.value ? '#CBD5E1' : '#334155')

const toastRef = ref<ComponentPublicInstance | null>(null)
const toastClassRef = ref<ComponentPublicInstance | null>(null)
const toastStyleRef = ref<ComponentPublicInstance | null>(null)

let submitTimer: number | null = null

function onShowToast(): void {
	toastRef.value?.$callMethod('show')
}

function onShowToastClass(): void {
	toastClassRef.value?.$callMethod('show')
}

function onShowToastStyle(): void {
	toastStyleRef.value?.$callMethod('show')
}

function onShowTop(): void {
	toastRef.value?.$callMethod('configShow', {
		text: t('snToast.topToast'),
		position: 'top'
	} as SnToastParams)
}

function onShowCenter(): void {
	toastRef.value?.$callMethod('configShow', {
		text: t('snToast.centerToast'),
		position: 'center'
	} as SnToastParams)
}

function onShowBottom(): void {
	toastRef.value?.$callMethod('configShow', {
		text: t('snToast.bottomToast'),
		position: 'bottom'
	} as SnToastParams)
}

function onShowSuccess(): void {
	toastRef.value?.$callMethod('configShow', {
		text: t('snToast.opSuccess'),
		icon: 'checkbox-circle-fill',
		iconColor: '#39c478'
	} as SnToastParams)
}

function onShowError(): void {
	toastRef.value?.$callMethod('configShow', {
		text: t('snToast.opFail'),
		icon: 'close-circle-fill',
		iconColor: '#fc5454'
	} as SnToastParams)
}

function onShowLoading(): void {
	toastRef.value?.$callMethod('configShow', {
		text: t('snToast.loadingDots'),
		loading: true
	} as SnToastParams)
}

function onCloseLoading(): void {
	toastRef.value?.$callMethod('close')
}

function onShowCustom(): void {
	toastRef.value?.$callMethod('configShow', {
		text: t('snToast.customToast'),
		bgColor: '$primary',
		textColor: '$primaryText',
		borderRadius: '$20',
		textSize: '$16'
	} as SnToastParams)
}

function onShowLight(): void {
	toastRef.value?.$callMethod('configShow', {
		text: t('snToast.lightToast'),
		bgColor: '#fff',
		textColor: '#2b2b2b',
		icon: 'information-fill',
		iconColor: '#4d82ff',
		borderRadius: '$12',
		padding: '$14px $20px'
	} as SnToastParams)
}

function onShowMultiLine(): void {
	toastRef.value?.$callMethod('configShow', {
		text: t('snToast.multiLineText'),
		textLines: 3,
		duration: 4000
	} as SnToastParams)
}


function onShowOverride(): void {
	toastRef.value?.$callMethod('configShow', {
		text: t('snToast.overrideSuccessToast'),
		bgColor: '$success',
		textColor: '$successText'
	} as SnToastParams)
}

function onShowOverrideWarn(): void {
	toastRef.value?.$callMethod('configShow', {
		text: t('snToast.overrideWarnToast'),
		bgColor: '$warning',
		textColor: '$warningText'
	} as SnToastParams)
}

function onShowOverlay(): void {
	toastRef.value?.$callMethod('configShow', {
		text: t('snToast.overlayToast'),
		overlay: true,
		duration: 2500
	} as SnToastParams)
}


function onSubmit(): void {
	toastRef.value?.$callMethod('configShow', {
		text: t('snToast.submitting'),
		loading: true
	} as SnToastParams)
	if (submitTimer != null) {
		clearTimeout(submitTimer)
		submitTimer = null
	}
	submitTimer = setTimeout((): void => {
		submitTimer = null
		toastRef.value?.$callMethod('configShow', {
			text: t('snToast.nicknameSuccess'),
			icon: 'checkbox-circle-fill',
			iconColor: '#39c478',
			duration: 1500
		} as SnToastParams)
	}, 2000)
}

onUnmounted((): void => {
	if (submitTimer != null) {
		clearTimeout(submitTimer)
		submitTimer = null
	}
})

const sceneBoxStyle = computed((): Map<string, any> => {
	const styles = new Map<string, any>()
	styles.set('alignItems', 'center')
	styles.set('justifyContent', 'center')
	styles.set('paddingTop', '16px')
	styles.set('paddingBottom', '16px')
	styles.set('borderRadius', '12px')
	styles.set('backgroundColor', 'var(--sn-info-light)')
	return styles
})
</script>

<style lang="scss">
.btn-row {
	flex-direction: row;
}
.demo-toast-class {
	border: 2px solid var(--sn-primary);
}
.scene-box {
	flex-direction: column;
}
</style>
