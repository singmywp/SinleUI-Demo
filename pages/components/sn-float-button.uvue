<template>
	<sn-page>
		<sn-topbar :title="t('snFloatButton.title')"></sn-topbar>

		<demo-card :title="t('snFloatButton.demoTitle')" :subtitle="t('snFloatButton.demoDesc')">
			
			<view class="config-row" flatten>
				<sn-text :text="t('snFloatButton.presetPos')" custom-style="width:120px;" flatten />
				<sn-switch v-model="configs.init" />
			</view>
			<view class="config-row" flatten>
				<sn-text :text="t('snFloatButton.absorb')" custom-style="width:120px;" flatten />
				<sn-switch v-model="configs.absorb" />
			</view>
			<view class="config-row" flatten>
				<sn-text :text="t('snFloatButton.disabled')" custom-style="width:120px;" flatten />
				<sn-switch v-model="configs.disabled" />
			</view>
			<view class="config-row" flatten>
				<sn-text :text="t('snFloatButton.positionLabel')" custom-style="width:120px;" flatten />
				<sn-select v-model="configs.position" :data="positions" width="160px" />
			</view>
			<view class="config-row" flatten>
				<sn-text :text="t('snFloatButton.aniTime')" custom-style="width:120px;" flatten />
				<sn-stepper v-model="configs.aniTime" :step="100" :min="100" />
			</view>
			<view class="config-row">
				<sn-text :text="t('snFloatButton.btnSize')" custom-style="width:120px;" />
				<sn-input v-model="configs.size" :placeholder="t('snFloatButton.defaultVal')" style="flex:1;" />
			</view>
			<view class="config-row">
				<sn-text :text="t('snFloatButton.bgColorLabel')" custom-style="width:120px;" />
				<sn-input v-model="configs.bgColor" :placeholder="t('snFloatButton.defaultVal')" style="flex:1;" />
			</view>
			<view class="config-row">
				<sn-text :text="t('snFloatButton.borderRadius')" custom-style="width:120px;" />
				<sn-input v-model="configs.borderRadius" :placeholder="t('snFloatButton.defaultVal')" style="flex:1;" />
			</view>
			<view class="config-row">
				<sn-text :text="t('snFloatButton.shadow')" custom-style="width:120px;" />
				<sn-input v-model="configs.boxShadow" :placeholder="t('snFloatButton.defaultVal')" style="flex:1;" />
			</view>
			<view class="config-row">
				<sn-text :text="t('snFloatButton.icon')" custom-style="width:120px;" />
				<sn-input v-model="configs.icon" :placeholder="t('snFloatButton.defaultVal')" style="flex:1;" />
			</view>
			<view class="config-row">
				<sn-text :text="t('snFloatButton.iconSize')" custom-style="width:120px;" />
				<sn-input v-model="configs.iconSize" :placeholder="t('snFloatButton.defaultVal')" style="flex:1;" />
			</view>
			<view class="config-row">
				<sn-text :text="t('snFloatButton.iconColor')" custom-style="width:120px;" />
				<sn-input v-model="configs.iconColor" :placeholder="t('snFloatButton.defaultVal')" style="flex:1;" />
			</view>
			<sn-text flatten type="text-light" :font-size="12" :text="posText" custom-style="margin-top:4px;" />
		</demo-card>

		<sn-gap :height="`${sizeNum + 40}px`"></sn-gap>
		<sn-float-button v-model="configs.model"
			:init="configs.init"
			:disabled="configs.disabled"
			:ani-time="`${configs.aniTime}ms`"
			:absorb="configs.absorb"
			:position="positionId"
			:bg-color="configs.bgColor"
			:size="configs.size"
			:icon="configs.icon"
			:icon-size="configs.iconSize"
			:icon-color="configs.iconColor"
			:box-shadow="configs.boxShadow"
			:border-radius="configs.borderRadius">
		</sn-float-button>
	</sn-page>
</template>

<script lang="uts" setup>

import { useI18n } from 'vue-i18n'
import { $snui, snu } from '@/uni_modules/sinle-ui/index.uts'
import type { SnDataItem } from '@/uni_modules/sinle-ui/core/types/index.uts'

const { t } = useI18n()

type Configs = {
	model: number[]
	init: boolean
	position: number
	absorb: boolean
	disabled: boolean
	boxShadow: string
	aniTime: number
	borderRadius: string
	icon: string
	iconSize: string
	iconColor: string
	size: string
	bgColor: string
}

const configs = ref<Configs>({
	model: [0, 0],
	init: true,
	position: 4,
	absorb: true,
	disabled: false,
	boxShadow: '0 0 15px -10px',
	aniTime: $snui.aniTimeLong,
	borderRadius: '',
	icon: 'add-line',
	iconSize: '',
	iconColor: 'white',
	size: '60px',
	bgColor: '$primary'
})

const positions: SnDataItem[] = [
	{ id: 'top-start', text: t('snFloatButton.posTopStart') },
	{ id: 'top', text: t('snFloatButton.posTop') },
	{ id: 'top-end', text: t('snFloatButton.posTopEnd') },
	{ id: 'right', text: t('snFloatButton.posRight') },
	{ id: 'bottom-end', text: t('snFloatButton.posBottomEnd') },
	{ id: 'bottom', text: t('snFloatButton.posBottom') },
	{ id: 'bottom-start', text: t('snFloatButton.posBottomStart') },
	{ id: 'left', text: t('snFloatButton.posLeft') }
]


const positionId = computed<string>(() => {
	const index = configs.value.position
	if (index >= 0 && index < positions.length) {
		return positions[index].id ?? 'bottom-end'
	}
	return 'bottom-end'
})


const posText = computed<string>(() => {
	return t('snFloatButton.pos', { x: Math.round(configs.value.model[0]), y: Math.round(configs.value.model[1]) } as UTSJSONObject)
})


const sizeNum = computed<number>(() => {
	const n = snu.getPx(configs.value.size)
	return n > 0 ? n : 60
})
</script>

<style lang="scss">
	
.config-row {
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	margin-bottom: 12px;
}
</style>
