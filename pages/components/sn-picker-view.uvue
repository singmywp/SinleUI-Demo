<template>
	<sn-page :title="t('snPickerView.title')" :show-back="true">
		<sn-alert type="primary" custom-style="margin:0 16px 16px 16px;">
			<sn-text font-size="$12" color="$primary" flatten>{{ t('snPickerView.alert') }}</sn-text>
		</sn-alert>

		<demo-card :title="t('snPickerView.basicTitle')" :subtitle="t('snPickerView.basicSubtitle')">
			<sn-picker-view v-model="pickerValue" :data="cityData" />
			<sn-text font-size="$12" :color="descColor" custom-style="margin-top:8px;" flatten>{{ t('snPickerView.selectedValue', { value: pickerValueText } as UTSJSONObject) }}</sn-text>
		</demo-card>

		<demo-card :title="t('snPickerView.disabledTitle')" :subtitle="t('snPickerView.disabledSubtitle')">
			<sn-picker-view v-model="pickerValue2" :data="disabledData" />
			<sn-text font-size="$12" :color="descColor" custom-style="margin-top:8px;" flatten>{{ t('snPickerView.disabledWuhan') }}</sn-text>
		</demo-card>

		<demo-card :title="t('snPickerView.customStyleTitle')" :subtitle="t('snPickerView.customStyleSubtitle')">
			<sn-picker-view v-model="pickerValue3" :data="styleData" item-text-size="$15" active-item-text-color="$primary"
				disabled-item-text-color="$disabledText" column-spacing="16px" item-height="44px"
				item-border-radius="$10" item-style="border-radius: 10px;" />
		</demo-card>

		<demo-card :title="t('snPickerView.disabledAllTitle')" :subtitle="t('snPickerView.disabledAllSubtitle')">
			<sn-picker-view v-model="pickerValue4" :data="cityData" disabled />
			<sn-text font-size="$12" :color="descColor" custom-style="margin-top:8px;" flatten>{{ t('snPickerView.disabledNoScroll') }}</sn-text>
		</demo-card>

		<demo-card :title="t('snPickerView.heightTitle')" :subtitle="t('snPickerView.heightSubtitle')">
			<sn-picker-view v-model="pickerValue5" :data="cityData" height="200px" column-spacing="30px" />
		</demo-card>
	</sn-page>
</template>

<script lang="uts" setup>
	
	import { useI18n } from 'vue-i18n'
	import { useTheme } from '@/uni_modules/sinle-ui/index.uts'
	import type { SnDataItem } from '@/uni_modules/sinle-ui/core/types/index.uts'

	const { isDark } = useTheme()
	const { t } = useI18n()

	const descColor = computed<string>(() => isDark.value ? '#CBD5E1' : '#334155')

	const pickerValue = ref<number[]>([0, 0])
	const pickerValue2 = ref<number[]>([1, 0])
	const pickerValue3 = ref<number[]>([0, 1])
	const pickerValue4 = ref<number[]>([2, 1])
	const pickerValue5 = ref<number[]>([1, 1])

	const pickerValueText = computed<string>(() => {
		return pickerValue.value.join(', ')
	})

	
	const cityData = [
	[
		{ id: 'newyork', text: t('snPickerView.cityNewYork') },
		{ id: 'london', text: t('snPickerView.cityLondon') },
		{ id: 'tokyo', text: t('snPickerView.cityTokyo') },
		{ id: 'paris', text: t('snPickerView.cityParis') },
		{ id: 'moscow', text: t('snPickerView.cityMoscow') },
		{ id: 'berlin', text: t('snPickerView.cityBerlin') }
	] as SnDataItem[],
	[
		{ id: 'guangzhou', text: t('snPickerView.cityGuangzhou') },
		{ id: 'shenzhen', text: t('snPickerView.cityShenzhen') },
		{ id: 'beijing', text: t('snPickerView.cityBeijing') },
		{ id: 'shanghai', text: t('snPickerView.cityShanghai') },
		{ id: 'chengdu', text: t('snPickerView.cityChengdu') },
		{ id: 'hangzhou', text: t('snPickerView.cityHangzhou') }
	] as SnDataItem[]
]

const disabledData = [
	[
		{ id: 'a1', text: t('snPickerView.optionOne') },
		{ id: 'a2', text: t('snPickerView.optionTwo') },
		{ id: 'a3', text: t('snPickerView.optionThree') },
		{ id: 'a4', text: t('snPickerView.optionFour') }
	] as SnDataItem[],
	[
		{ id: 'b1', text: t('snPickerView.cityBeijing') },
		{ id: 'b2', text: t('snPickerView.cityWuhan'), disabled: true },
		{ id: 'b3', text: t('snPickerView.cityGuangzhou') },
		{ id: 'b4', text: t('snPickerView.cityShenzhen') }
	] as SnDataItem[]
]

const styleData = [
	[
		{ id: 's1', text: t('snPickerView.monday') },
		{ id: 's2', text: t('snPickerView.tuesday') },
		{ id: 's3', text: t('snPickerView.wednesday') },
		{ id: 's4', text: t('snPickerView.thursday') },
		{ id: 's5', text: t('snPickerView.friday') }
	] as SnDataItem[],
	[
		{ id: 'm1', text: t('snPickerView.morning') },
		{ id: 'm2', text: t('snPickerView.afternoon') },
		{ id: 'm3', text: t('snPickerView.evening') }
	] as SnDataItem[]
]
</script>

