<template>
	<sn-page :title="t('snUploadMedia.title')" :show-back="true">
		<demo-card :title="t('snUploadMedia.basicTitle')" :subtitle="t('snUploadMedia.basicSubtitle')">
			<sn-upload-media ref="mediaRef" mode="image" :url="uploadUrl" :auto-upload="false" :timeout="8000"
				@image-chose="onImageChose" @uploaded="onUploaded" @upload-error="onUploadError" @choose-error="onChooseError" />
			<view class="ud-row" style="margin-top:10px;" flatten>
				<sn-button :text="t('snUploadMedia.upload')" type="primary" custom-style="flex:1; margin-right:8px;" @click="onUpload" />
			</view>
			<sn-text font-size="$12" color="$textLight" custom-style="margin-top:8px;" flatten>{{ t('snUploadMedia.choseImages', { count: imageChoseCount, tip: uploadTip } as UTSJSONObject) }}</sn-text>
		</demo-card>

		<demo-card :title="t('snUploadMedia.videoTitle')" :subtitle="t('snUploadMedia.videoSubtitle')">
			<sn-upload-media ref="videoRef" mode="video" :url="uploadUrl" width="120px" height="120px"
				@video-chose="onVideoChose" @uploaded="onVideoUploaded" @upload-error="onVideoUploadError" />
			<sn-text font-size="$12" color="$textLight" custom-style="margin-top:8px;" flatten>{{ t('snUploadMedia.choseVideos', { count: videoChoseCount, tip: videoUploadTip } as UTSJSONObject) }}</sn-text>
		</demo-card>

		<demo-card :title="t('snUploadMedia.mixTitle')" :subtitle="t('snUploadMedia.mixSubtitle')">
			<sn-upload-media mode="all" :max-count="4" :auto-upload="false" @file-chose="onFileChose" />
			<sn-text font-size="$12" color="$textLight" custom-style="margin-top:8px;" flatten>{{ t('snUploadMedia.fileCount', { count: fileChoseCount } as UTSJSONObject) }}</sn-text>
		</demo-card>

		<demo-card :title="t('snUploadMedia.cloudTitle')" :subtitle="t('snUploadMedia.cloudSubtitle')">
			<sn-upload-media-unicloud ref="cloudRef" mode="image" :auto-upload="false" directory="demoUpload/"
				@uploaded="onCloudUploaded" @upload-error="onCloudUploadError" @choose-error="onCloudChooseError" />
			<sn-button :text="t('snUploadMedia.upload')" type="primary" custom-style="margin-top:10px;" @click="onCloudUpload" />
			<sn-text font-size="$12" color="$textLight" custom-style="margin-top:8px;" flatten>{{ cloudTip }}</sn-text>
		</demo-card>

		<demo-card :title="t('snUploadMedia.customTitle')" :subtitle="t('snUploadMedia.customSubtitle')">
			<sn-upload-media mode="image" :auto-upload="false" width="225px" height="135px"
				item-bg-color="$primaryLight" item-border-radius="8px">
				<image src="/static/images/positive.png" mode="scaleToFill"
					style="width:100%;height:100%;border-radius:8px;" />
			</sn-upload-media>
		</demo-card>

		<demo-card :title="t('snUploadMedia.disableTitle')" :subtitle="t('snUploadMedia.disableSubtitle')">
			<view class="ud-row" flatten>
				<sn-upload-media mode="image" :auto-upload="false" disabled custom-style="margin-right:12px;" />
				<sn-upload-media mode="image" :auto-upload="false" :clearable="false" />
			</view>
		</demo-card>
	</sn-page>
</template>

<script lang="uts" setup>


import { useI18n } from 'vue-i18n'
import type { ComponentPublicInstance } from 'vue'
import type { SnFile } from '@/uni_modules/sinle-ui/core/types/index.uts'

const { t } = useI18n()




const uploadUrl = 'http://www.test.com/upload'
const mediaRef = ref<ComponentPublicInstance | null>(null)
const imageChoseCount = ref<number>(0)
const uploadTip = ref<string>(t('snUploadMedia.notUploaded'))

function onImageChose(): void {
	imageChoseCount.value++
	uploadTip.value = t('snUploadMedia.chooseThenClickUpload')
}

function onUpload(): void {
	mediaRef.value?.$callMethod('upload')
}

function onUploaded(): void {
	uploadTip.value = t('snUploadMedia.uploaded')
}

function onUploadError(err: UniError): void {
	const detail = err.cause != null && err.cause.message != '' ? `：${err.cause.message}` : ''
	uploadTip.value = t('snUploadMedia.uploadFail', { code: err.errCode, detail } as UTSJSONObject)
}

function onChooseError(err: UniError): void {
	uploadTip.value = t('snUploadMedia.chooseFail', { code: err.errCode } as UTSJSONObject)
}


const videoRef = ref<ComponentPublicInstance | null>(null)
const videoChoseCount = ref<number>(0)
const videoUploadTip = ref<string>(t('snUploadMedia.notUploaded'))

function onVideoChose(): void {
	videoChoseCount.value++
	videoUploadTip.value = t('snUploadMedia.videoUploading')
}

function onVideoUploaded(): void {
	videoUploadTip.value = t('snUploadMedia.uploaded')
}

function onVideoUploadError(err: UniError): void {
	const detail = err.cause != null && err.cause.message != '' ? `：${err.cause.message}` : ''
	videoUploadTip.value = t('snUploadMedia.uploadFail', { code: err.errCode, detail } as UTSJSONObject)
}


const fileChoseCount = ref<number>(0)

function onFileChose(files: SnFile[]): void {
	fileChoseCount.value += files.length
}


const cloudRef = ref<ComponentPublicInstance | null>(null)
const cloudTip = ref<string>(t('snUploadMedia.cloudNotUploaded'))

function onCloudUpload(): void {
	cloudRef.value?.$callMethod('upload')
}

function onCloudUploaded(): void {
	cloudTip.value = t('snUploadMedia.cloudUploaded')
}

function onCloudUploadError(err: UniError): void {
	const detail = err.cause != null && err.cause.message != '' ? `：${err.cause.message}` : ''
	cloudTip.value = t('snUploadMedia.uploadFail', { code: err.errCode, detail } as UTSJSONObject)
}

function onCloudChooseError(err: UniError): void {
	cloudTip.value = t('snUploadMedia.chooseFail', { code: err.errCode } as UTSJSONObject)
}
</script>

<style lang="scss">
.ud-row {
	flex-direction: row;
	align-items: center;
}
</style>
