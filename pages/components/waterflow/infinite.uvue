<template>
	<sn-page :title="t('waterflowInfinite.title')" :show-back="true" fill-content>
		<sn-waterflow :list="items" :cross-axis-count="2" cross-axis-gap="10" main-axis-gap="12"
			:lower-threshold="8000" loadmore :show-loadmore="false" custom-style="margin: 0 10px;"
			v-model:loadmore-status="loadmoreStatus" @loadmore="onLoadmore">
			<template v-slot:default="slotProps">
				<view class="wf-card" :style="cardStyle" flatten>
					<view class="wf-cover" :style="coverStyle(slotProps.item)" flatten>
						<sn-text font-size="$16" color="#FFFFFF" bold flatten>{{ wfIndex(slotProps.item) }}</sn-text>
					</view>
					<view class="wf-desc" flatten>
						<sn-text font-size="$12" color="$title" bold flatten>{{ wfTitle(slotProps.item) }}</sn-text>
						<sn-text font-size="$11" color="$textLight" custom-style="margin-top:4px;" flatten>{{ t('waterflowInfinite.heightDesc', { height: wfHeight(slotProps.item) } as UTSJSONObject) }}</sn-text>
					</view>
				</view>
			</template>
		</sn-waterflow>
	</sn-page>
</template>

<script lang="uts" setup>
import { useI18n } from 'vue-i18n'
import { $snui } from '@/uni_modules/sinle-ui'

const { t } = useI18n()

type InfiniteItem = {
	id: string
	title: string
	height: number
	coverHeight: number
	color: string
}

type LoadSeqItem = {
	height: number
	color: string
}

const items = ref<InfiniteItem[]>([])
const loadmoreStatus = ref<string>('loadmore')
let loadTimer: number | null = null

const loadSeq: LoadSeqItem[] = [
	{ height: 150, color: '#4d82ff' },
	{ height: 230, color: '#06B6D4' },
	{ height: 190, color: '#10B981' },
	{ height: 260, color: '#F59E0B' },
	{ height: 170, color: '#8B5CF6' },
	{ height: 210, color: '#EC4899' },
	{ height: 240, color: '#14B8A6' },
	{ height: 160, color: '#F97316' },
	{ height: 220, color: '#6366F1' },
	{ height: 180, color: '#84CC16' }
]

function genItems(start: number, count: number): InfiniteItem[] {
	const arr: InfiniteItem[] = []
	for (let i = 0; i < count; i++) {
		const idx = start + i
		const s = loadSeq[idx % loadSeq.length]
		arr.push({
			id: `w${idx}`,
			title: t('waterflowInfinite.item', { index: idx + 1 } as UTSJSONObject),
			height: s.height + 58,
			coverHeight: s.height,
			color: s.color
		})
	}
	return arr
}

function wfIndex(item: any): string {
	return `${(item as InfiniteItem).coverHeight}`
}
function wfTitle(item: any): string {
	return (item as InfiniteItem).title
}
function wfHeight(item: any): string {
	return `${(item as InfiniteItem).coverHeight}`
}

const cardStyle = computed((): Map<string, any> => {
	const styles = new Map<string, any>()
	styles.set('width', '100%')
	styles.set('borderRadius', `${Math.round(12 * $snui.radiusFactor)}px`)
	styles.set('backgroundColor', 'var(--sn-front)')
	styles.set('padding', '8px')
	styles.set('flexDirection', 'column')
	return styles
})

function coverStyle(item: any): Map<string, any> {
	const styles = new Map<string, any>()
	const it = item as InfiniteItem
	styles.set('height', `${it.coverHeight}px`)
	styles.set('borderRadius', `${Math.round(8 * $snui.radiusFactor)}px`)
	styles.set('backgroundColor', it.color)
	styles.set('alignItems', 'center')
	styles.set('justifyContent', 'center')
	return styles
}

function onLoadmore(): void {
	if (loadTimer != null) {
		clearTimeout(loadTimer)
		loadTimer = null
	}
	loadTimer = setTimeout(() => {
		loadTimer = null
		const current = items.value.length
		const more = genItems(current, 20)
		for (let i = 0; i < more.length; i++) {
			items.value.push(more[i])
		}
		loadmoreStatus.value = 'loadmore'
	}, 400) as number
}

onMounted(() => {
	items.value = genItems(0, 40)
})
</script>

<style lang="scss">
.wf-card {
	flex-direction: column;
	width: 100%;
}
.wf-cover {
	flex-direction: row;
}
.wf-desc {
	flex-direction: column;
	width: 100%;
	padding: 8px 2px 2px 2px;
}
</style>