<template>
	<sn-page :title="t('snTextarea.title')" :show-back="true">
		<demo-card :title="t('snTextarea.basicTitle')" :subtitle="t('snTextarea.basicSubtitle')">
			<sn-textarea v-model="value1" :placeholder="t('snTextarea.placeholder')" />
			<sn-text font-size="$12" color="$textLight" custom-style="margin-top:8px;" flatten>{{ t('snTextarea.currentValue') }}：{{ value1 }}</sn-text>
		</demo-card>

		<demo-card :title="t('snTextarea.heightTitle')" :subtitle="t('snTextarea.heightSubtitle')">
			<sn-textarea v-model="value2" height="60px" :placeholder="t('snTextarea.smallHeight')" />
			<sn-textarea v-model="value3" height="150px" :placeholder="t('snTextarea.bigHeight')" custom-style="margin-top:12px;" />
			<sn-textarea v-model="value4" auto-height :placeholder="t('snTextarea.autoHeight')" custom-style="margin-top:12px;" />
		</demo-card>

		<demo-card :title="t('snTextarea.counterTitle')" :subtitle="t('snTextarea.counterSubtitle')">
			<sn-textarea v-model="value5" :maxlength="50" :placeholder="t('snTextarea.max50')" />
		</demo-card>

		<demo-card :title="t('snTextarea.borderTitle')" :subtitle="t('snTextarea.borderSubtitle')">
			<sn-textarea v-model="value6" show-border active-border :placeholder="t('snTextarea.focusBorder')" border-color="$info"
				active-border-color="$primary" bg-color="$front" />
			<sn-textarea v-model="value7" :active-border="false" :placeholder="t('snTextarea.noActiveBorder')"
				custom-style="margin-top:12px;" />
			<sn-textarea v-model="value8" :show-border="false" bg-color="$infoLight" :placeholder="t('snTextarea.noBorder')"
				custom-style="margin-top:12px;" />
		</demo-card>

		<demo-card :title="t('snTextarea.disabledTitle')" :subtitle="t('snTextarea.disabledSubtitle')">
			<sn-textarea v-model="valueDisabled" disabled :placeholder="t('snTextarea.disabledPh')" />
			<sn-textarea v-model="valueReadonly" readonly :placeholder="t('snTextarea.readonlyPh')" custom-style="margin-top:12px;" />
		</demo-card>

		<demo-card :title="t('snTextarea.colorTitle')" :subtitle="t('snTextarea.colorSubtitle')">
			<sn-textarea v-model="valueColor" :maxlength="30" :placeholder="t('snTextarea.successTheme')" border-color="$success"
				active-border-color="$success" bg-color="$successLight" active-bg-color="$successLight"
				counter-bg-color="$success" counter-color="$successText" />
			<sn-textarea v-model="valueColor2" :maxlength="30" :placeholder="t('snTextarea.infoTheme')" border-color="$infoDark"
				bg-color="$front" counter-bg-color="$infoDark" counter-color="#fff" custom-style="margin-top:12px;" />
		</demo-card>

		<demo-card :title="t('snTextarea.textStyleTitle')" :subtitle="t('snTextarea.textStyleSubtitle')">
			<sn-textarea v-model="valueStyle1" :placeholder="t('snTextarea.centerBig')" align="center" text-size="$16"
				border-radius="$16" />
			<sn-textarea v-model="valueStyle2" :placeholder="t('snTextarea.rightAlign')" align="right" border-radius="$4"
				custom-style="margin-top:12px;" />
		</demo-card>

		<demo-card :title="t('snTextarea.eventTitle')" :subtitle="t('snTextarea.eventSubtitle')">
			<sn-textarea v-model="valueEvent" :placeholder="t('snTextarea.inputHint')" @input="onInput" @focus="onFocus"
				@blur="onBlur" @linechange="onLinechange" />
			<sn-text font-size="$12" :color="eventColor" custom-style="margin-top:12px;" flatten>{{ eventLog }}</sn-text>
		</demo-card>

		<demo-card :title="t('snTextarea.externalTitle')" :subtitle="t('snTextarea.externalSubtitle')">
			<sn-textarea v-model="valueExt2" input-style="font-size: 18px; font-weight: bold;" :maxlength="20" :placeholder="t('snTextarea.inputStyle')" custom-style="margin-top:12px;" />
			<sn-textarea v-model="valueExt3" :maxlength="20" counter-class="demo-counter" :placeholder="t('snTextarea.counterClass')"
				custom-style="margin-top:12px;" />
			<sn-textarea v-model="valueExt4" :maxlength="20" counter-style="background-color:#ff6600;color:#fff;" :placeholder="t('snTextarea.counterStyle')" />
		</demo-card>

		<demo-card :title="t('snTextarea.sceneTitle')" :subtitle="t('snTextarea.sceneSubtitle')">
			<sn-textarea v-model="valueComment" auto-height :maxlength="200" :placeholder="t('snTextarea.commentPh')"
				border-radius="$12" />
		</demo-card>
	</sn-page>
</template>

<script lang="uts" setup>
import { useI18n } from 'vue-i18n'
import { $snui } from '@/uni_modules/sinle-ui'

const { t } = useI18n()
const value1 = ref<string>('')
const value2 = ref<string>('')
const value3 = ref<string>('')
const value4 = ref<string>('')
const value5 = ref<string>('')
const value6 = ref<string>('')
const value7 = ref<string>('')
const value8 = ref<string>('')
const valueDisabled = ref<string>(t('snTextarea.disabledContent'))
const valueReadonly = ref<string>(t('snTextarea.readonlyContent'))
const valueColor = ref<string>('')
const valueColor2 = ref<string>('')
const valueStyle1 = ref<string>('')
const valueStyle2 = ref<string>('')
const valueEvent = ref<string>('')
const valueExt2 = ref<string>('')
const valueExt3 = ref<string>('')
const valueExt4 = ref<string>('')
const valueComment = ref<string>('')
const eventLog = ref<string>(t('snTextarea.noEvent'))
const eventColor = ref<string>($snui.colors.textLight)

function setLog(text: string, color: string = $snui.colors.primary): void {
	eventLog.value = text
	eventColor.value = color
}

function onInput(e: UniInputEvent): void {
	setLog('input: ' + e.detail.value)
}

function onFocus(e: UniTextareaFocusEvent): void {
	setLog('focus: ' + e.detail.value, $snui.colors.success)
}

function onBlur(e: UniTextareaBlurEvent): void {
	setLog('blur: ' + e.detail.value, $snui.colors.textLight)
}

function onLinechange(e: UniTextareaLineChangeEvent): void {
	setLog(`linechange: ${t('snTextarea.lineCount', { count: e.detail.lineCount } as UTSJSONObject)}`, $snui.colors.warning)
}
</script>

<style lang="scss">
.demo-textarea-bold {
	font-weight: bold;
}
.demo-counter {
	border-width: 1px;
	border-style: solid;
	border-color: #ff6600;
}
</style>
