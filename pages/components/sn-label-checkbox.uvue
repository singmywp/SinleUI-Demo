<template>
	<sn-page :title="t('snLabelCheckbox.title')" :show-back="true">
		<demo-card :title="t('snLabelCheckbox.basicTitle')" :subtitle="t('snLabelCheckbox.basicDesc')">
			<sn-label-checkbox v-model="check1" :data="hobbyData" />
			<sn-text flatten font-size="$12" color="$textLight" custom-style="margin-top:8px;">{{ t('snLabelCheckbox.currentSelected') }}{{ check1Text }}</sn-text>
		</demo-card>

		<demo-card :title="t('snLabelCheckbox.defaultTitle')" :subtitle="t('snLabelCheckbox.defaultDesc')">
			<sn-label-checkbox v-model="check2" :data="hobbyData" />
			<sn-text flatten font-size="$12" color="$textLight" custom-style="margin-top:8px;">{{ t('snLabelCheckbox.initialSelected') }}{{ check2Text }}</sn-text>
		</demo-card>

		<demo-card :title="t('snLabelCheckbox.disabledTitle')" :subtitle="t('snLabelCheckbox.disabledDesc')">
			<sn-text flatten font-size="$12" color="$textLight">{{ t('snLabelCheckbox.disabledAll') }}</sn-text>
			<sn-label-checkbox v-model="check3" :data="hobbyData" disabled />
			<sn-text flatten font-size="$12" color="$textLight" custom-style="margin-top:10px;">{{ t('snLabelCheckbox.disabledSingle') }}</sn-text>
			<sn-label-checkbox v-model="check4" :data="disabledData" />
		</demo-card>

		<demo-card :title="t('snLabelCheckbox.iconPosTitle')" :subtitle="t('snLabelCheckbox.iconPosDesc')">
			<sn-text flatten font-size="$12" color="$textLight">{{ t('snLabelCheckbox.iconRight') }}</sn-text>
			<sn-label-checkbox v-model="check5" :data="hobbyData" icon-position="right" />
			<sn-label-checkbox v-model="check6" :data="hobbyData" custom-style="margin-top:10px;" />
		</demo-card>

		<demo-card :title="t('snLabelCheckbox.iconTitle')" :subtitle="t('snLabelCheckbox.iconDesc')">
			<sn-label-checkbox v-model="check7" :data="hobbyData" icon="heart-fill" icon-size="18" />
		</demo-card>

		<demo-card :title="t('snLabelCheckbox.colorTitle')" :subtitle="t('snLabelCheckbox.colorDesc')">
			<sn-label-checkbox v-model="check8" :data="hobbyData" item-bg-color="$successLight"
				active-item-bg-color="$success" text-color="$successDark" active-text-color="$successText"
				icon-color="$successText" />
		</demo-card>

		<demo-card :title="t('snLabelCheckbox.sizeTitle')" :subtitle="t('snLabelCheckbox.sizeDesc')">
			<sn-text flatten font-size="$12" color="$textLight">{{ t('snLabelCheckbox.largeLabel') }}</sn-text>
			<sn-label-checkbox v-model="check9" :data="hobbyData" item-padding="16px 28px" text-size="$16"
				icon-size="20" />
			<sn-label-checkbox v-model="check10" :data="hobbyData" item-padding="8px 12px" text-size="$12"
				custom-style="margin-top:10px;" />
		</demo-card>

		<demo-card :title="t('snLabelCheckbox.eventsTitle')" :subtitle="t('snLabelCheckbox.eventsDesc')">
			<sn-label-checkbox v-model="check11" :data="hobbyData" @change="onChange" />
			<sn-text flatten font-size="$13" color="$primary" custom-style="margin-top:10px;">{{ t('snLabelCheckbox.recentEvent') }}{{ changeLog }}</sn-text>
		</demo-card>

		<demo-card :title="t('snLabelCheckbox.sceneTitle')" :subtitle="t('snLabelCheckbox.sceneDesc')">
			<view class="scene-card" flatten>
				<sn-text flatten bold font-size="$14" color="$text">{{ t('snLabelCheckbox.selectCategory') }}</sn-text>
				<sn-label-checkbox v-model="filter" :data="filterData" custom-style="margin-top:10px;" />
				<sn-text flatten font-size="$12" color="$textLight" custom-style="margin-top:8px;">{{ t('snLabelCheckbox.selectedCount', { n: filter.length } as UTSJSONObject) }}{{ filterText }}</sn-text>
			</view>
		</demo-card>
	</sn-page>
</template>

<script lang="uts" setup>
import { useI18n } from 'vue-i18n'
import type { SnDataItem } from '@/uni_modules/sinle-ui/core/types/index.uts'

const { t } = useI18n()
const hobbyData = computed<SnDataItem[]>(() => [
	{ id: 'code', text: t('snLabelCheckbox.hobbyProgramming') },
	{ id: 'design', text: t('snLabelCheckbox.hobbyDesign') },
	{ id: 'music', text: t('snLabelCheckbox.hobbyMusic') },
	{ id: 'photo', text: t('snLabelCheckbox.hobbyPhoto') }
])

const disabledData = computed<SnDataItem[]>(() => [
	{ id: 'a', text: t('snLabelCheckbox.available') },
	{ id: 'b', text: t('snLabelCheckbox.disabledUnchecked'), disabled: true },
	{ id: 'c', text: t('snLabelCheckbox.disabledChecked'), disabled: true }
])

const filterData = computed<SnDataItem[]>(() => [
	{ id: 'phone', text: t('snLabelCheckbox.filterPhone') },
	{ id: 'home', text: t('snLabelCheckbox.filterHome') },
	{ id: 'fashion', text: t('snLabelCheckbox.filterFashion') },
	{ id: 'food', text: t('snLabelCheckbox.filterFood') }
])

const check1 = ref<number[]>([])
const check2 = ref<number[]>([0, 2])
const check3 = ref<number[]>([])
const check4 = ref<number[]>([2])
const check5 = ref<number[]>([])
const check6 = ref<number[]>([])
const check7 = ref<number[]>([])
const check8 = ref<number[]>([])
const check9 = ref<number[]>([])
const check10 = ref<number[]>([])
const check11 = ref<number[]>([])
const filter = ref<number[]>([])
const changeLog = ref<string>(t('snLabelCheckbox.noneEvent'))

const check1Text = computed<string>(() => '[' + check1.value.join(', ') + ']')
const check2Text = computed<string>(() => '[' + check2.value.join(', ') + ']')
const filterText = computed<string>(() => '[' + filter.value.join(', ') + ']')

function onChange(value: number[]): void {
	changeLog.value = 'change: [' + value.join(', ') + ']'
}
</script>

<style lang="scss">
.scene-card {
	padding: 14px;
	border-radius: 10px;
	background-color: var(--sn-front);
}
</style>