			<view class="hero-row" flatten>
				<sn-view bg-color="$primary" border-radius="$14" custom-style="flex:1;margin-right:10px;padding:14px 0;">
					<sn-view custom-style="flex-direction:column;align-items:center;">
						<sn-text font-size="$13" bold color="$primaryText" flatten>PRIMARY</sn-text>
