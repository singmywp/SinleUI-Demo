		<demo-card :title="t('snView.hoverTitle')" :subtitle="t('snView.hoverSubtitle')">
			
			<sn-view padding="18px" bg-color="$successLight" border-radius="$16" hover-class="none"
				hover-style="transform:scale(0.95);"
			 custom-style="flex-direction:row;align-items:center;margin-top:12px;">
				<sn-view bg-color="$success" border-radius="4px"
