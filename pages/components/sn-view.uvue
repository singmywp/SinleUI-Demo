			</sn-view>

			
			<sn-view padding="18px" bg-color="$warningLight" border-radius="$16" hover-class="none"
				hover-style="background-color:#ffa726;"
			 custom-style="flex-direction:row;align-items:center;margin-top:12px;">
				<sn-view bg-color="$warning" border-radius="4px"
					custom-style="width:8px;height:8px;margin-right:12px;"></sn-view>
				<sn-text font-size="$14" bold color="$warningDark" custom-style="flex:1;" flatten>{{ t('snView.hoverBg') }}</sn-text>
				<sn-text font-size="$16" color="$warning" custom-style="font-weight:bold;" flatten>›</sn-text>
			</sn-view>
