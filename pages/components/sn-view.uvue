		<demo-card :title="t('snView.gestureTitle')" :subtitle="t('snView.gestureSubtitle')">
			<sn-view custom-class="gesture-pad" bg-color="$infoDark" border-radius="$18"
				@down="onGestureDown" @click="onGestureClick" @dbclick="onGestureDbclick"
				@longpress="onGestureLongpress" @touchstart="onGestureTouchStart" @touchmove="onGestureTouchMove"
				@touchend="onGestureTouchEnd" @touchcancel="onGestureTouchCancel" custom-style="margin-bottom:12px;">
				<view class="gesture-live-row" flatten>
					<sn-view bg-color="#ff4d4f" custom-style="width:8px;height:8px;border-radius:4px;margin-right:6px;"></sn-view>
					<sn-text font-size="$10" bold color="$infoDarkText" custom-style="opacity:0.8;" flatten>LIVE</sn-text>
				</view>
				<sn-text font-size="$16" bold color="$infoText" custom-style="margin-top:10px;" flatten>{{ t('snView.touchPad') }}</sn-text>
				<sn-text font-size="$11" color="$infoDarkText" custom-style="margin-top:6px;opacity:0.7;" flatten>{{ t('snView.gestureHint') }}</sn-text>
			</sn-view>
			<view class="gesture-log" flatten>
				<text v-if="gestureLogs.length == 0" class="gesture-log-empty" flatten>{{ t('snView.noGestureEvent') }}</text>
				<text v-for="(item, index) in gestureLogs" :key="'log' + index" class="gesture-log-item"
					:style="getLogItemStyle(item)" flatten>{{ item.text }}</text>
			</view>
			<sn-button type="primary" level="second" :text="t('snView.demoInstance')" @click="goToGestureInstance"
				custom-style="margin-top:12px;"></sn-button>
		</demo-card>
	</sn-page>
</template>

<script lang="uts" setup>
import { useI18n } from 'vue-i18n'
import { $snui, snu } from '@/uni_modules/sinle-ui'
import type { SnPointerEvent, SnTouchEvent } from '@/uni_modules/sinle-ui'

const { t } = useI18n()
type LogItem = {
	text: string
	color: string
}

const viewLoading = ref<boolean>(false)
const viewDisabled = ref<boolean>(false)
const gestureLogs = ref<LogItem[]>([])

function toggleLoading(): void {
	viewLoading.value = !viewLoading.value
}

function toggleDisabled(): void {
	viewDisabled.value = !viewDisabled.value
}

function goToGestureInstance(): void {
	uni.navigateTo({
		url: '/pages/components/sn-view-instances'
	})
}

function onDisabledAreaClick(): void {
	snu.showToast({
		text: t('snView.disabledClicked')
	})
}


function pushLog(text: string, color: string = ''): void {
	const c = color != '' ? color : $snui.colors.textLight
	
	const list = gestureLogs.value.concat([])
	list.push({
		text: text,
		color: c
	} as LogItem)
	if (list.length > 8) {
		list.shift()
	}
	gestureLogs.value = list
}

function onGestureDown(e: SnPointerEvent): void {
	pushLog(`down   x=${Math.round(e.x)} y=${Math.round(e.y)}`, $snui.colors.primary)
}

function onGestureClick(e: SnPointerEvent): void {
	pushLog(`click  x=${Math.round(e.x)} y=${Math.round(e.y)}`, $snui.colors.success)
}

function onGestureDbclick(e: SnPointerEvent): void {
	pushLog('dbclick' + ' ' + t('snView.dbclick'), $snui.colors.error)
}

function onGestureLongpress(e: SnTouchEvent): void {
	pushLog('longpress' + ' ' + t('snView.longpress'), $snui.colors.warning)
}

function onGestureTouchStart(e: SnTouchEvent): void {
	e.event.preventDefault()
	if (e.touches.length > 0) {
		const t = e.touches[0]
		pushLog(`touchstart x=${Math.round(t.x)} y=${Math.round(t.y)}`)
	}
}

function onGestureTouchMove(e: SnTouchEvent): void {
	e.event.preventDefault()
	if (e.touches.length > 0) {
		const t = e.touches[0]
		pushLog(t('snView.touchmoveLog', { direction: t.direction, dx: Math.round(t.diffX).toString(), dy: Math.round(t.diffY).toString() } as UTSJSONObject))
	}
}

function onGestureTouchEnd(e: SnTouchEvent): void {
	e.event.preventDefault()
	pushLog('touchend')
}

function onGestureTouchCancel(e: SnTouchEvent): void {
	e.event.preventDefault()
	pushLog('touchcancel')
}

function getLogItemStyle(item: LogItem): Map<string, any> {
	const styles = new Map<string, any>()
	styles.set('color', item.color)
	styles.set('fontSize', '12px')
	styles.set('fontFamily', 'monospace')
	return styles
}
</script>

