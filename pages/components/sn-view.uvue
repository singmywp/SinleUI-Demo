			</view>
			<view class="hero-row offset-row" flatten>
				<sn-view bg-color="$warningLight" border-radius="$14" custom-style="flex:1;margin-right:10px;padding:12px 0;border-width:1px;border-style:solid;border-color:rgba(255,255,255,0.35);">
					<sn-view custom-style="flex-direction:column;align-items:center;">
