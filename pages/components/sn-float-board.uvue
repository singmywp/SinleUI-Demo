<template>
	<sn-page>
		<sn-topbar :title="t('snFloatBoard.title')"></sn-topbar>

		<demo-card :title="t('snFloatBoard.demoTitle')" :subtitle="t('snFloatBoard.demoDesc')">
			<view class="config-row" flatten>
				<sn-text :text="t('snFloatBoard.showLine')" custom-style="width:130px;" flatten />
				<sn-switch v-model="configs.showLine" />
			</view>
			<view class="config-row" flatten>
				<sn-text :text="t('snFloatBoard.positionLabel')" custom-style="width:130px;" flatten />
				<sn-radio-group v-model="configs.position" tag-type="primary" tag-level="least">
					<sn-radio-tag v-for="(p, i) in positions" :key="'pos' + i" :text="p.text" />
				</sn-radio-group>
			</view>
			<view class="config-row" flatten>
				<sn-text :text="t('snFloatBoard.aniTime')" custom-style="width:130px;" flatten />
				<sn-stepper v-model="configs.aniTime" :step="100" :min="100" style="flex: 1;" />
			</view>
			<sn-text type="text-light" :font-size="12" :text="t('snFloatBoard.dragTip')" custom-style="margin-top:4px;" flatten />
		</demo-card>

		<demo-card :title="t('snFloatBoard.sizeTitle')" :subtitle="t('snFloatBoard.sizeDesc')">
			<view class="config-row" flatten>
				<sn-text :text="t('snFloatBoard.expandWidth')" custom-style="width:130px;" flatten />
				<sn-stepper v-model="configs.maxWidth" :step="20" :min="0" style="flex: 1;" />
			</view>
			<view class="config-row" flatten>
				<sn-text flatten :text="t('snFloatBoard.expandHeight')" custom-style="width:130px;" />
				<sn-stepper v-model="configs.maxHeight" :step="20" :min="0" style="flex: 1;" />
			</view>
			<view flatten class="config-row">
				<sn-text flatten :text="t('snFloatBoard.foldWidth')" custom-style="width:130px;" />
				<sn-stepper v-model="configs.minWidth" :step="20" :min="0" style="flex: 1;" />
			</view>
			<view flatten class="config-row">
				<sn-text flatten :text="t('snFloatBoard.foldHeight')" custom-style="width:130px;" />
				<sn-stepper v-model="configs.minHeight" :step="20" :min="0" style="flex: 1;" />
			</view>
			<view flatten class="config-row">
				<sn-text flatten :text="t('snFloatBoard.slideW')" custom-style="width:130px;" />
				<sn-stepper v-model="configs.slideWidth" :step="20" :min="0" style="flex: 1;" />
			</view>
			<view flatten class="config-row">
				<sn-text flatten :text="t('snFloatBoard.slideH')" custom-style="width:130px;" />
				<sn-stepper v-model="configs.slideHeight" :step="20" :min="0" style="flex: 1;" />
			</view>
		</demo-card>

		<demo-card :title="t('snFloatBoard.colorTitle')" :subtitle="t('snFloatBoard.colorDesc')">
			<view flatten class="config-row">
				<sn-text flatten :text="t('snFloatBoard.bgColorLabel')" custom-style="width:130px;" />
				<sn-input v-model="configs.bgColor" :placeholder="t('snFloatBoard.defaultVal')" style="flex: 1;" />
			</view>
			<view flatten class="config-row">
				<sn-text flatten :text="t('snFloatBoard.lineColorLabel')" custom-style="width:130px;" />
				<sn-input v-model="configs.lineColor" :placeholder="t('snFloatBoard.defaultVal')" style="flex: 1;" />
			</view>
		</demo-card>

		<sn-gap :height="`${configs.maxHeight + 20}px`"></sn-gap>
	</sn-page>

	<sn-float-board :bg-color="configs.bgColor"
		:position="positions[configs.position].id"
		:line-color="configs.lineColor"
		:max-height="`${configs.maxHeight}px`"
		:max-width="`${configs.maxWidth}px`"
		:min-height="`${configs.minHeight}px`"
		:min-width="`${configs.minWidth}px`"
		:slide-height="`${configs.slideHeight}px`"
		:slide-width="`${configs.slideWidth}px`"
		:ani-time="`${configs.aniTime}ms`"
		:show-line="configs.showLine">
		<sn-view padding="25px 15px 10px 15px" style="flex: 1;" bg-color="$front" border-radius="$16">
			<sn-text flatten :text="t('snFloatBoard.bodyTitle')" :font-size="16" bold />
			<sn-text flatten type="text-light" :font-size="12" :text="t('snFloatBoard.floatTip')" custom-style="margin-top:8px;" />
