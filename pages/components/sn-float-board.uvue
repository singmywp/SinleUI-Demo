<script lang="uts" setup>

import { useI18n } from 'vue-i18n'
import { $snui } from '@/uni_modules/sinle-ui/index.uts'

const { t } = useI18n()

type PositionItem = {
	id: string
	text: string
}

type Configs = {
	showLine: boolean
	bgColor: string
	lineColor: string
	position: number
	maxHeight: number
	maxWidth: number
	minHeight: number
	minWidth: number
	slideHeight: number
	slideWidth: number
	aniTime: number
}

const configs = ref<Configs>({
	showLine: true,
	bgColor: '',
	lineColor: '',
	position: 0,
	maxHeight: 500,
	maxWidth: 300,
	minHeight: 50,
	minWidth: 50,
	slideHeight: 100,
	slideWidth: 100,
	aniTime: $snui.aniTimeLong
})

const positions: PositionItem[] = [
	{ id: 'bottom', text: t('snFloatBoard.dirBottom') },
	{ id: 'top', text: t('snFloatBoard.dirTop') },
	{ id: 'left', text: t('snFloatBoard.dirLeft') },
	{ id: 'right', text: t('snFloatBoard.dirRight') }
]
