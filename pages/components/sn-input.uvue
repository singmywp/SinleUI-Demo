<template>
	<sn-page :title="t('snInput.title')" :show-back="true">
		<demo-card :title="t('snInput.basicTitle')" :subtitle="t('snInput.basicDesc')">
			<sn-input v-model="value1" :placeholder="t('snInput.placeholderContent')" />
			<sn-text font-size="$12" color="$textLight" custom-style="margin-top:8px;" flatten>{{ t('snInput.currentValue') }}{{ value1 }}</sn-text>
		</demo-card>

		<demo-card :title="t('snInput.typeTitle')" :subtitle="t('snInput.typeDesc')">
			<sn-input v-model="valueNum" type="number" :placeholder="t('snInput.placeholderNum')" />
			<sn-input v-model="valueDigit" type="digit" :placeholder="t('snInput.placeholderDigit')" custom-style="margin-top:12px;" />
			<sn-input v-model="valueTel" type="tel" :placeholder="t('snInput.placeholderTel')" :maxlength="11" custom-style="margin-top:12px;" />
			<sn-input v-model="valueNickname" type="nickname" :placeholder="t('snInput.placeholderNickname')" custom-style="margin-top:12px;" />
		</demo-card>

		<demo-card :title="t('snInput.pwdTitle')" :subtitle="t('snInput.pwdDesc')">
			<sn-input v-model="valuePwd" password :placeholder="t('snInput.placeholderPwd')" />
		</demo-card>

		<demo-card :title="t('snInput.clearTitle')" :subtitle="t('snInput.clearDesc')">
			<sn-input v-model="valueClear" clearable :placeholder="t('snInput.placeholderClear')" />
		</demo-card>

		<demo-card :title="t('snInput.affixTitle')" :subtitle="t('snInput.affixDesc')">
			<sn-input v-model="valueSearch" prefix-icon="search-line" clearable :placeholder="t('snInput.placeholderSearch')"
				@prefix-click="onPrefixClick" @suffix-click="onSuffixClick" />
			<sn-input v-model="valueUser" prefix-icon="user-line" :placeholder="t('snInput.placeholderUser')" custom-style="margin-top:12px;" />
			<sn-input v-model="valueSms" prefix-icon="smartphone-line" suffix-icon="message-3-line"
				:placeholder="t('snInput.placeholderSms')" custom-style="margin-top:12px;" />
		</demo-card>

		<demo-card :title="t('snInput.loadTitle')" :subtitle="t('snInput.loadDesc')">
			<sn-input v-model="valueLoading" loading :placeholder="t('snInput.placeholderLoading')" />
		</demo-card>

		<demo-card :title="t('snInput.disableTitle')" :subtitle="t('snInput.disableDesc')">
			<sn-input v-model="valueDisabled" disabled :placeholder="t('snInput.placeholderDisabled')" />
			<sn-input v-model="valueReadonly" readonly :placeholder="t('snInput.placeholderReadonly')" custom-style="margin-top:12px;" />
		</demo-card>

		<demo-card :title="t('snInput.colorTitle')" :subtitle="t('snInput.colorDesc')">
			<sn-input v-model="valueColor" show-border show-active-border :placeholder="t('snInput.placeholderFocus')" border-color="$info" border-width="2px"
				active-border-color="$primary" bg-color="$front" active-bg-color="$front" />
			<sn-input v-model="valueColor2" :placeholder="t('snInput.placeholderSuccess')" active-border-color="$success"
				active-bg-color="$successLight" custom-style="margin-top:12px;" cursor-color="$success" text-color="$success" />
			<sn-input v-model="valueColor3" disabled :placeholder="t('snInput.placeholderDisabledColor')" disabled-bg-color="$disabledDark"
				disabled-text-color="$disabledDarkText" custom-style="margin-top:12px;" />
		</demo-card>

		<demo-card :title="t('snInput.sizeTitle')" :subtitle="t('snInput.sizeDesc')">
			<sn-input v-model="valueSize1" :placeholder="t('snInput.placeholderRadius')" border-radius="$16" padding="10px 16px" />
			<sn-input v-model="valueSize2" :placeholder="t('snInput.placeholderCenter')" align="center" text-size="$16"
				border-radius="$4" custom-style="margin-top:12px;" />
			<sn-input v-model="valueSize3" :placeholder="t('snInput.placeholderNoBorder')" :show-border="false" bg-color="$infoLight" custom-style="margin-top:12px;" />
		</demo-card>

		<demo-card :title="t('snInput.eventsTitle')" :subtitle="t('snInput.eventsDesc')">
			<sn-input v-model="valueEvent" :placeholder="t('snInput.placeholderEvent')" clearable @input="onInput" @focus="onFocus"
				@blur="onBlur" @confirm="onConfirm" />
			<sn-text font-size="$12" :color="eventColor" custom-style="margin-top:12px;" flatten>{{ eventLog }}</sn-text>
		</demo-card>

		<demo-card :title="t('snInput.externalTitle')" :subtitle="t('snInput.externalDesc')">
			<sn-input v-model="valueExt2" input-style="font-size: 18px; font-weight: bold;" :placeholder="t('snInput.placeholderInputStyle')" />
			<view style="margin-top: 12px" flatten>
				<sn-input v-model="valueExt3" prefix-icon="search-line" prefix-icon-class="demo-input-prefix-icon"
					:placeholder="t('snInput.placeholderPrefixClass')" />
			</view>
			<view style="margin-top: 12px" flatten>
				<sn-input v-model="valueExt4" prefix-icon="search-line" prefix-icon-style="color: #f56c6c;"
					:placeholder="t('snInput.placeholderPrefixStyle')" />
			</view>
			<view style="margin-top: 12px" flatten>
				<sn-input v-model="valueExt5" suffix-icon="close-circle-fill" suffix-icon-class="demo-input-suffix-icon"
					:placeholder="t('snInput.placeholderSuffixClass')" />
			</view>
			<view style="margin-top: 12px" flatten>
				<sn-input v-model="valueExt6" suffix-icon="close-circle-fill" suffix-icon-style="color: #67c23a;"
					:placeholder="t('snInput.placeholderSuffixStyle')" />
			</view>
			<sn-text flatten font-size="$12" color="$textLight" style="margin-top: 12px;">{{ t('snInput.extAffixHint') }}</sn-text>
		</demo-card>

		<demo-card :title="t('snInput.sceneTitle')" :subtitle="t('snInput.sceneDesc')">
			<sn-input v-model="loginUser" prefix-icon="user-line" clearable :placeholder="t('snInput.placeholderAccount')" />
			<sn-input v-model="loginPwd" prefix-icon="lock-line" password clearable :placeholder="t('snInput.placeholderPwd')" custom-style="margin-top:12px;" />
		</demo-card>
	</sn-page>
</template>

<script lang="uts" setup>
import { useI18n } from 'vue-i18n'
import { $snui } from '@/uni_modules/sinle-ui'

const { t } = useI18n()
const value1 = ref<string>('')
const valueNum = ref<string>('')
const valueDigit = ref<string>('')
const valueTel = ref<string>('')
const valueNickname = ref<string>('')
const valuePwd = ref<string>('')
const valueClear = ref<string>('')
const valueSearch = ref<string>('')
const valueUser = ref<string>('')
const valueSms = ref<string>('')
const valueLoading = ref<string>('')
const valueDisabled = ref<string>(t('snInput.disabledContent'))
const valueReadonly = ref<string>(t('snInput.readonlyContent'))
const valueColor = ref<string>('')
const valueColor2 = ref<string>('')
const valueColor3 = ref<string>('')
const valueSize1 = ref<string>('')
const valueSize2 = ref<string>('')
const valueSize3 = ref<string>('')
const valueEvent = ref<string>('')
const valueExt2 = ref<string>('')
const valueExt3 = ref<string>('')
const valueExt4 = ref<string>('')
const valueExt5 = ref<string>('')
const valueExt6 = ref<string>('')
const loginUser = ref<string>('')
const loginPwd = ref<string>('')
const eventLog = ref<string>(t('snInput.noneEvent'))
const eventColor = ref<string>($snui.colors.textLight)

function setLog(text: string, color: string = $snui.colors.primary): void {
	eventLog.value = text
	eventColor.value = color
}

function onPrefixClick(): void {
	setLog(t('snInput.prefixClick'), $snui.colors.warning)
}

function onSuffixClick(): void {
	setLog(t('snInput.suffixClick'), $snui.colors.warning)
}

function onInput(e: UniInputEvent): void {
	setLog('input: ' + e.detail.value)
}

function onFocus(e: UniInputFocusEvent): void {
	setLog('focus: ' + e.detail.value, $snui.colors.success)
}

function onBlur(e: UniInputBlurEvent): void {
	setLog('blur: ' + e.detail.value, $snui.colors.textLight)
}

function onConfirm(e: UniInputConfirmEvent): void {
	setLog('confirm: ' + e.detail.value, $snui.colors.error)
}
</script>

<style lang="scss">
.demo-input-bold {
	font-weight: bold;
}
.demo-input-prefix-icon {
	opacity: 0.5;
}
.demo-input-suffix-icon {
	background-color: var(--sn-primary-light);
	border-radius: 50%;
}
</style>