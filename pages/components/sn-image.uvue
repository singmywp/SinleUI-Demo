<template>
	<sn-page :title="t('snImage.title')" :show-back="true" padding="0 16px 32px 16px">
		<demo-card :title="t('snImage.basicTitle')" :subtitle="t('snImage.basicDesc')">
			<view class="demo-col" flatten>
				<sn-image custom-class="demo-stack"
					src="https://img1.baidu.com/it/u=2572795898,2432467619&fm=253&fmt=auto&app=138&f=JPEG?w=640&h=427" />
				<sn-image src="https://img2.baidu.com/it/u=3307857314,3539337404&fm=253&fmt=auto&app=120&f=JPEG?w=1280&h=800" />
			</view>
		</demo-card>

		<demo-card :title="t('snImage.modeTitle')" :subtitle="t('snImage.modeDesc')">
			<view class="mode-grid" flatten>
				<view v-for="item in modeItems" :key="item.mode" class="mode-item" flatten>
					<sn-image custom-class="mode-image" :mode="item.mode" :src="modeImage" width="80px" height="80px" />
					<sn-text flatten :text="item.label" font-size="$11" color="$textLight" custom-style="margin-top:6px;" />
				</view>
			</view>
		</demo-card>

		<demo-card :title="t('snImage.autoTitle')" :subtitle="t('snImage.autoDesc')">
			<view class="demo-col" flatten>
				<sn-image custom-class="demo-stack" src="https://img2.baidu.com/it/u=3307857314,3539337404&fm=253&fmt=auto&app=120&f=JPEG?w=1280&h=800" />
			</view>
			<view class="demo-row" flatten>
				<sn-image custom-class="auto-image-gap" src="https://img1.baidu.com/it/u=3587186811,3730884801&fm=253&fmt=auto&app=138&f=JPEG?w=424&h=600" />
				<sn-image custom-class="auto-image-gap" src="https://img0.baidu.com/it/u=854650116,3372822797&fm=253&fmt=auto&app=138&f=JPEG?w=500&h=667" />
			</view>
			<view class="demo-row" flatten>
				<view class="fixed-sibling" flatten><text class="fixed-sibling-text" flatten>80px</text></view>
				<sn-image custom-class="auto-image-gap" src="https://img2.baidu.com/it/u=448582925,1585814755&fm=253&fmt=auto&app=138&f=JPEG?w=333&h=500" />
				<sn-image custom-class="auto-image-gap" src="https://img1.baidu.com/it/u=1431796479,1028246143&fm=253&fmt=auto&app=138&f=JPEG?w=500&h=743" />
			</view>
			<sn-image src="https://img1.baidu.com/it/u=3587186811,3730884801&fm=253&fmt=auto&app=138&f=JPEG?w=424&h=600" width="150px" />
		</demo-card>

		<demo-card :title="t('snImage.loadingTitle')" :subtitle="t('snImage.loadingDesc')">
			<view class="demo-row" flatten>
				<sn-image custom-class="demo-img" src="https://img1.baidu.com/it/u=253682624,1679759773&fm=253&fmt=auto&app=138&f=JPEG?w=900&h=500"
					 :border-radius="12" loading-icon="loader-4-line" loading-bg-color="$primaryLight"
					loading-icon-color="$primary" />
				<sn-image custom-class="demo-img" src="https://img2.baidu.com/it/u=448582925,1585814755&fm=253&fmt=auto&app=138&f=JPEG?w=333&h=500"
					 loading-image="/static/logo-trans.png" loading-bg-color="$successLight" />
				<sn-image custom-class="demo-img" src="https://img1.baidu.com/it/u=1431796479,1028246143&fm=253&fmt=auto&app=138&f=JPEG?w=500&h=743"
					 loading-bg-color="$info">
					<template #loading>
						<sn-loading />
					</template>
				</sn-image>
			</view>
		</demo-card>

		<demo-card :title="t('snImage.lazyTitle')" :subtitle="t('snImage.lazyDesc')">
			<view class="demo-row">
				<sn-image custom-class="demo-img" src="https://img1.baidu.com/it/u=1431796479,1028246143&fm=253&fmt=auto&app=138&f=JPEG?w=500&h=743" width="140px" lazy-load />
				<sn-image custom-class="demo-img" src="https://img1.baidu.com/it/u=3587186811,3730884801&fm=253&fmt=auto&app=138&f=JPEG?w=424&h=600" width="120px" :fade-show="false" />
			</view>
		</demo-card>

		<demo-card :title="t('snImage.previewTitle')" :subtitle="t('snImage.previewDesc')">
			<sn-image src="https://img1.baidu.com/it/u=253682624,1679759773&fm=253&fmt=auto&app=138&f=JPEG?w=900&h=500" enable-preview />
		</demo-card>

		<demo-card :title="t('snImage.eventsTitle')" :subtitle="t('snImage.eventsDesc')">
				<view class="demo-col">
					<sn-image custom-class="demo-stack" src="https://img2.baidu.com/it/u=3307857314,3539337404&fm=253&fmt=auto&app=120&f=JPEG?w=1280&h=800"
						@load="onLoad" @error="onError" @click="onClick" @dbclick="onDbClick" @longpress="onLongpress" />
					<sn-text text-class="demo-stack" font-size="$13" color="$primary" flatten>{{ t('snImage.recentEvent') }}{{ lastEvent }}</sn-text>
					<sn-image custom-class="demo-stack" src="https://it.does.not.exist/the-picture.png" width="160px" @error="onError" />
					<sn-text font-size="$13" color="$textLight" flatten>{{ t('snImage.errorHint') }}</sn-text>
				</view>
			</demo-card>
	</sn-page>
</template>

<script lang="uts" setup>
import { useI18n } from 'vue-i18n'

const { t } = useI18n()
type ImageModeItem = {
	mode: string
	label: string
}

const modeImage: string.ImageURIString = 'https://img1.baidu.com/it/u=2572795898,2432467619&fm=253&fmt=auto&app=138&f=JPEG?w=640&h=427'
const modeItems: ImageModeItem[] = [
	{ mode: 'scaleToFill', label: 'scaleToFill' },
	{ mode: 'aspectFit', label: 'aspectFit' },
	{ mode: 'aspectFill', label: 'aspectFill' },
	{ mode: 'widthFix', label: 'widthFix' },
	{ mode: 'heightFix', label: 'heightFix' },
	{ mode: 'top', label: 'top' },
	{ mode: 'bottom', label: 'bottom' },
	{ mode: 'center', label: 'center' },
	{ mode: 'left', label: 'left' },
	{ mode: 'right', label: 'right' },
	{ mode: 'top left', label: 'top left' },
	{ mode: 'top right', label: 'top right' },
	{ mode: 'bottom left', label: 'bottom left' },
	{ mode: 'bottom right', label: 'bottom right' }
]
const lastEvent = ref<string>(t('snImage.noneEvent'))

function onLoad(event: UniImageLoadEvent): void {
	lastEvent.value = t('snImage.eventLoad', { w: event.detail.width, h: event.detail.height } as UTSJSONObject)
}

function onError(event: UniImageErrorEvent): void {
	lastEvent.value = t('snImage.eventError', { msg: event.detail.errMsg } as UTSJSONObject)
}

function onClick(event: UniPointerEvent): void {
	lastEvent.value = 'click'
}

function onDbClick(event: UniPointerEvent): void {
	lastEvent.value = t('snImage.eventDbclick')
}

function onLongpress(event: UniEvent): void {
	lastEvent.value = t('snImage.eventLongpress')
}
</script>

<style lang="scss">
.demo-col {
	flex-direction: column;
}

.demo-row {
	flex-direction: row;
	align-items: flex-start;
	margin-bottom: 12px;
}

.fixed-sibling {
	width: 80px;
	height: 80px;
	flex-shrink: 0;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	background-color: var(--sn-info-light);
}

.fixed-sibling-text {
	font-size: 12px;
	color: var(--sn-info-dark);
}

.auto-image-gap {
	margin-right: 12px;
}

.mode-grid {
	flex-direction: row;
	align-items: flex-start;
	flex-wrap: wrap;
}

.mode-item {
	width: 96px;
	flex-direction: column;
	align-items: center;
	margin-right: 6px;
	margin-bottom: 14px;
}

.mode-image {
	background-color: var(--sn-info);
}

.demo-img {
	margin-right: 16px;
	margin-bottom: 12px;
}

.demo-stack {
	margin-bottom: 12px;
}
</style>
