const pressedCat = ref<number>(-1)
const pressedDesign = ref<number>(-1)
const popupRef = ref<ComponentPublicInstance | null>(null)
const activeCat = ref<number>(-1)
const compCount = ref<number>(0)

function compEnName(url: string): string {
	const segs = url.split('/')
	let body = segs[segs.length - 1]
	if (body.startsWith('sn-e-')) {
		body = body.substring(5)
	} else if (body.startsWith('sn-')) {
		body = body.substring(3)
	}
	const camel = snu.kebabCaseToCamelCase(body)
	return camel.charAt(0).toUpperCase() + camel.slice(1)
}

function itemLabel(item: CompItem): string {
	const localName = t(item.name)
	if (appLocale.value == 'en') {
		return localName
	}
	const enName = compEnName(item.url)
	if (enName == localName) {
		return localName
	}
	return `${enName} ${localName}`
}

function compareName(a: string, b: string): number {
	const al = a.toLowerCase()
	const bl = b.toLowerCase()
	const len = Math.min(al.length, bl.length)
	for (let i = 0; i < len; i++) {
		const ca = al.charCodeAt(i)
		const cb = bl.charCodeAt(i)
		if (ca != cb) {
			return ca - cb
		}
	}
	return al.length - bl.length
}

function sortItems(items: CompItem[]): void {
	for (let i = 0; i < items.length; i++) {
		for (let j = i + 1; j < items.length; j++) {
			if (compareName(compEnName(items[j].url), compEnName(items[i].url)) < 0) {
				const tmp = items[i]
				items[i] = items[j]
				items[j] = tmp
			}
		}
	}
}

for (let i = 0; i < categories.length; i++) {
	sortItems(categories[i].items)
}

const apiCount = 109

function countComps(): number {
	let total = 0
	for (let i = 0; i < categories.length; i++) {
		const items = categories[i].items
		for (let j = 0; j < items.length; j++) {
			if (!items[j].url.startsWith('/pages/api')) {
				total++
			}
		}
	}
	return total
}
compCount.value = countComps()

const platformName = ref<string>('Web')

onMounted((): void => {
	try {
		const sysInfo = uni.getSystemInfoSync() as unknown as UTSJSONObject
		const platform = sysInfo['uniPlatform'] as string
		if (platform == 'web') {
			platformName.value = 'Web'
		} else if (platform == 'app') {
			const osName = sysInfo['osName'] as string
			if (osName == 'android') {
				platformName.value = 'Android'
			} else if (osName == 'ios') {
				platformName.value = 'iOS'
			} else {
				platformName.value = 'App'
			}
		} else if (platform == 'mp-weixin') {
			platformName.value = 'MP'
		} else if (platform != null) {
			platformName.value = platform
		}
	} catch (e) {
		platformName.value = 'Web'
	}
})

