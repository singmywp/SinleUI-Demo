function navTo(url: string): void {
	uni.navigateTo({
		url: url
	})
}

function onCatTouchStart(idx: number): void {
	pressedCat.value = idx
}

function onCatTouchEnd(): void {
	pressedCat.value = -1
}

function closeCatPopup(): void {
	popupRef.value?.$callMethod('close')
}

function openCat(idx: number): void {
	activeCat.value = idx
	const popup = popupRef.value
	if (popup != null) {
		popup.$callMethod('open')
		return
	}
	nextTick((): void => {
		popupRef.value?.$callMethod('open')
	})
}

function onDesignTouchStart(idx: number): void {
	pressedDesign.value = idx
}

function onDesignTouchEnd(): void {
	pressedDesign.value = -1
}

function openDesign(d: DesignEntry): void {
	uni.navigateTo({
		url: d.url
	})
}

function factorRadius(n: number): number {
	return Math.round(n * $snui.radiusFactor)
}

