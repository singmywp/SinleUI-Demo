<template>
	<sn-page :title="t('snWaterflow.title')" :show-back="true">
		<demo-card :title="t('snWaterflow.basicTitle')" :subtitle="t('snWaterflow.basicSubtitle')">
			<view class="flow-box" flatten>
				<sn-waterflow ref="flowRef" :list="items" :cross-axis-count="2" cross-axis-gap="10" main-axis-gap="12"
					refresher-enabled v-model:refresher-triggered="refresherTriggered"
					:refresher-config="refresherConfig" loadmore v-model:loadmore-status="loadmoreStatus"
					:loadmore-config="loadmoreConfig" backtop @refresh="onRefresh" @loadmore="onLoadmore">
					<template v-slot:default="slotProps">
						<view class="flow-card" :style="flowCardStyle(slotProps.item)" flatten>
							<sn-text font-size="$14" color="$primaryText" bold flatten>{{ flowTitle(slotProps.item) }}</sn-text>
							<sn-text font-size="$11" color="$primaryText" flatten>{{ flowSubText(slotProps.item) }}</sn-text>
						</view>
					</template>
				</sn-waterflow>
			</view>
			<sn-text font-size="$12" color="$textLight" custom-style="margin-top:8px;">
				{{ t('snWaterflow.totalDesc', { count: items.length } as UTSJSONObject) }}
			</sn-text>
		</demo-card>

		<demo-card :title="t('snWaterflow.columnTitle')" :subtitle="t('snWaterflow.columnSubtitle')">
			<view class="flow-box">
				<sn-waterflow :list="items3" :cross-axis-count="3" cross-axis-gap="8" main-axis-gap="10" :col-width="140"
					:estimated-item-height="180" :overscan="200">
					<template v-slot:default="slotProps">
						<view class="flow-card" :style="flowCardStyle3(slotProps.item)">
							<sn-text font-size="$12" color="$title" bold>{{ flowTitle3(slotProps.item) }}</sn-text>
						</view>
					</template>
				</sn-waterflow>
			</view>
		</demo-card>

		<demo-card :title="t('snWaterflow.infiniteTitle')" :subtitle="t('snWaterflow.infiniteSubtitle')">
			<view class="btn-row">
				<sn-button type="primary" @click="onOpenInfinite">{{ t('snWaterflow.openInfinite') }}</sn-button>
			</view>
		</demo-card>

		<demo-card :title="t('snWaterflow.methodTitle')" :subtitle="t('snWaterflow.methodSubtitle')">
			<view class="btn-row">
				<sn-button type="primary" custom-style="margin-right:10px;" @click="onStartRefresh">{{ t('snWaterflow.triggerRefresh') }}</sn-button>
				<sn-button type="primary" level="second" custom-style="margin-right:10px;" @click="onStopRefresh">{{ t('snWaterflow.stopRefresh') }}</sn-button>
				<sn-button type="success" plain @click="onLoadMoreClick">{{ t('snWaterflow.loadMoreBtn') }}</sn-button>
			</view>
			<sn-text font-size="$12" color="$textLight" custom-style="margin-top:8px;">
					{{ t('snWaterflow.currentTriggered') }} refresher-triggered：{{ refresherTriggered ? 'true' : 'false' }}
				</sn-text>
		</demo-card>
	</sn-page>
</template>

<script lang="uts" setup>
		import { useI18n } from 'vue-i18n'
		import { $snui } from '@/uni_modules/sinle-ui'
		import type { ComponentPublicInstance } from 'vue'
		import type { SnLoadmoreParams, SnRefresherParams } from '@/uni_modules/sinle-ui/core/types/index.uts'

		const { t } = useI18n()
		type DemoFlowItem = {
			id: string
			title: string
			height: number
		}

		const flowRef = ref<ComponentPublicInstance | null>(null)
		const refresherTriggered = ref<boolean>(false)
		const loadmoreStatus = ref<string>('loadmore')
		const items = ref<DemoFlowItem[]>([])
		const items3 = ref<DemoFlowItem[]>([])
		let refreshTimer: number | null = null

		const refresherConfig = computed<SnRefresherParams>(() => {
			return {
				refreshText: t('snWaterflow.refresh'),
				refreshingText: t('snWaterflow.refreshing'),
				iconColor: '$primary',
				textColor: '$primary'
			} as SnRefresherParams
		})

		const loadmoreConfig = computed<SnLoadmoreParams>(() => {
			return {
				loadmoreText: t('snWaterflow.loadmore'),
				nomoreText: t('snWaterflow.nomore'),
				loadingText: t('snWaterflow.loading')
			} as SnLoadmoreParams
		})


	/**
	 * 生成一批高度各异的瀑布流条目（模拟网络图片/内容高度差异）
	 */
	function genItems(start: number, count: number): DemoFlowItem[] {
		const arr: DemoFlowItem[] = []
		const seq = [140, 220, 180, 260, 160, 240, 200, 120, 250, 170, 210, 230, 150, 190, 270, 130]
		for (let i = 0; i < count; i++) {
			const idx = start + i
			arr.push({
				id: `f${idx}`,
				title: t('snWaterflow.flowItem', { index: idx + 1 } as UTSJSONObject),
				height: seq[idx % seq.length]
			})
		}
		return arr
	}

	function initItems(): void {
		items.value = genItems(0, 24)
		items3.value = genItems(0, 12)
	}

	// 插槽 item 为 any 类型，在函数体内强转后使用（UTS 不允许模板内强转）
	function flowTitle(item: any): string {
		return (item as DemoFlowItem).title
	}
	function flowSubText(item: any): string {
		const h = (item as DemoFlowItem).height
		return t('snWaterflow.height', { value: h } as UTSJSONObject)
	}
	function flowCardStyle(item: any): Map<string, any> {
		const styles = new Map<string, any>()
		styles.set('height', `${(item as DemoFlowItem).height}px`)
		styles.set('borderRadius', `${Math.round(12 * $snui.radiusFactor)}px`)
		styles.set('backgroundColor', `var(--sn-primary)`)
		styles.set('alignItems', 'center')
		styles.set('justifyContent', 'center')
		styles.set('padding', '12px')
		return styles
	}

	function flowTitle3(item: any): string {
		return (item as DemoFlowItem).title
	}
	function flowCardStyle3(item: any): Map<string, any> {
		const styles = new Map<string, any>()
		styles.set('height', `${(item as DemoFlowItem).height}px`)
		styles.set('borderRadius', `${Math.round(10 * $snui.radiusFactor)}px`)
		styles.set('backgroundColor', `var(--sn-info)`)
		styles.set('alignItems', 'center')
		styles.set('justifyContent', 'center')
		styles.set('padding', '10px')
		return styles
	}

	/**
	 * 下拉刷新：重置数据并模拟 1.5s 网络请求后结束刷新
	 */
	function onRefresh(): void {
		refresherTriggered.value = true
		if (refreshTimer != null) {
			clearTimeout(refreshTimer)
			refreshTimer = null
		}
		refreshTimer = setTimeout(() => {
			initItems()
			refresherTriggered.value = false
			loadmoreStatus.value = 'loadmore'
			flowRef.value?.$callMethod('stopRefresh')
			refreshTimer = null
		}, 1500) as number
	}

	/**
	 * 加载更多：追加数据，数据达到上限后置为 nomore
	 */
	function onLoadmore(): void {
		loadmoreStatus.value = 'loading'
		if (refreshTimer != null) {
			clearTimeout(refreshTimer)
			refreshTimer = null
		}
		refreshTimer = setTimeout(() => {
			const current = items.value.length
			const more = genItems(current, 8)
			for (let i = 0; i < more.length; i++) {
				items.value.push(more[i])
			}
			if (items.value.length >= 80) {
				loadmoreStatus.value = 'nomore'
			} else {
				loadmoreStatus.value = 'loadmore'
			}
			refreshTimer = null
		}, 1000) as number
	}

	function onOpenInfinite(): void {
		uni.navigateTo({
			url: '/pages/components/waterflow/infinite'
		})
	}

	function onStartRefresh(): void {
		if (flowRef.value != null) {
			flowRef.value.$callMethod('refresh')
			return
		}
		onRefresh()
	}

	function onStopRefresh(): void {
		if (flowRef.value != null) {
			flowRef.value.$callMethod('stopRefresh')
			return
		}
		refresherTriggered.value = false
	}

	function onLoadMoreClick(): void {
		if (flowRef.value != null) {
			flowRef.value.$callMethod('loadMore')
			return
		}
		onLoadmore()
	}

	onMounted((): void => {
		initItems()
	})

	onUnmounted(() => {
		if (refreshTimer != null) {
			clearTimeout(refreshTimer)
			refreshTimer = null
		}
	})
</script>

<style lang="scss">
	.flow-box {
		height: 460px;
	}
	.flow-card {
		width: 100%;
		flex-direction: column;
	}
	.btn-row {
		flex-direction: row;
	}
</style>
