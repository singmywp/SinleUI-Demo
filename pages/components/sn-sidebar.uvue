<template>
	<sn-page>
		<sn-topbar :title="t('snSidebar.title')"></sn-topbar>
		<demo-card :title="t('snSidebar.demoBasicTitle')" :subtitle="t('snSidebar.demoBasicSub')"
			custom-style="margin:10px 10px 0 10px;">
		</demo-card>

		<demo-card :title="t('snSidebar.demoExtTitle')" :subtitle="t('snSidebar.demoExtSub')"
			style="margin:10px 10px 0 10px;">
			<view style="height: 220px; margin-top: 12px;" flatten>
				<sn-sidebar v-model="extValue" :data="data" bar-class="demo-sidebar-bar"
					bar-style="background-color: var(--sn-info-light);" item-class="demo-sidebar-item"
					item-style="border-radius: 4px;" content-class="demo-sidebar-content"
					content-style="border-width:1px;border-style:solid;border-color:var(--sn-primary);">
					<sn-view bg-color="$front" padding="20px" style="flex: 1;">
						<sn-text :text="t('snSidebar.currentSelected', { text: (data[extValue].text ?? '') } as UTSJSONObject)" flatten />
						<sn-text flatten type="text-light" :font-size="12" :text="t('snSidebar.extTip')" custom-style="margin-top:8px;" />
					</sn-view>
				</sn-sidebar>
			</view>
		</demo-card>
		<view style="height: 220px; margin: 10px;" flatten>
			<sn-sidebar v-model="value" :data="data">
				<sn-view bg-color="$front" padding="20px" style="flex: 1;">
					<sn-text :text="t('snSidebar.currentSelected', { text: (data[value].text ?? '') } as UTSJSONObject)" flatten />
					<sn-text type="text-light" :font-size="12" :text="t('snSidebar.contentTip')" custom-style="margin-top:8px;" flatten />
				</sn-view>
			</sn-sidebar>
		</view>
		<demo-card :title="t('snSidebar.demoDemoTitle')" custom-style="margin:10px;">
			<sn-grid-group :col="3">
				<sn-grid-item @click="gotoDemo(1)">
					<sn-button custom-class="m-b-10" type="primary" shape="circle">
						<sn-icon name="emotion-happy-fill" color="#fff"></sn-icon>
					</sn-button>
					<sn-text :text="t('snSidebar.demo1')" flatten></sn-text>
				</sn-grid-item>
				<sn-grid-item @click="gotoDemo(2)">
					<sn-button custom-class="m-b-10" type="error" shape="circle">
						<sn-icon name="meteor-fill" color="#fff"></sn-icon>
					</sn-button>
					<sn-text :text="t('snSidebar.demo2')" flatten></sn-text>
				</sn-grid-item>
				<sn-grid-item @click="gotoDemo(3)">
					<sn-button custom-class="m-b-10" type="success" shape="circle">
						<sn-icon name="skull-fill" color="#fff"></sn-icon>
					</sn-button>
					<sn-text :text="t('snSidebar.demo3')" flatten></sn-text>
				</sn-grid-item>
			</sn-grid-group>
		</demo-card>
	</sn-page>
</template>

<script setup>

import { computed } from 'vue'
import { useI18n } from 'vue-i18n'
import type { SnDataItem } from '@/uni_modules/sinle-ui/core/types/index.uts'

const { t } = useI18n()

const value = ref<number>(0)
const extValue = ref<number>(0)

function gotoDemo(index: number): void {
	uni.navigateTo({
		url: `/pages/components/sidebar/demo${index}`
	})
}

const data = computed<SnDataItem[]>(() => [
	{ id: 'henan', text: t('snSidebar.henan') },
	{ id: 'shandong', text: t('snSidebar.shandong') },
	{ id: 'hebei', text: t('snSidebar.hebei') },
	{ id: 'shanxi', text: t('snSidebar.shanxi') },
	{ id: 'beijing', text: t('snSidebar.beijing') },
	{ id: 'tianjin', text: t('snSidebar.tianjin') },
	{ id: 'heilongjiang', text: t('snSidebar.heilongjiang') },
	{ id: 'jiangsu', text: t('snSidebar.jiangsu') },
	{ id: 'zhejiang', text: t('snSidebar.zhejiang') },
	{ id: 'anhui', text: t('snSidebar.anhui') }
])
</script>

