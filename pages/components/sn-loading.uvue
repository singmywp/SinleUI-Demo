<template>
	<sn-page :title="t('snLoading.title')" :show-back="true">
		<demo-card :title="t('snLoading.basicTitle')" :subtitle="t('snLoading.basicDesc')">
			<sn-loading :text="t('snLoading.loadingText')" />
		</demo-card>

		<demo-card :title="t('snLoading.modeTitle')" :subtitle="t('snLoading.modeDesc')">
			<view class="demo-row" flatten>
				<view class="demo-col" flatten>
					<sn-loading />
					<sn-text flatten font-size="$12" color="$textLight" custom-style="margin-top:8px;">{{ t('snLoading.iconMode') }}</sn-text>
				</view>
				<view class="demo-col" flatten>
					<sn-loading mode="native" />
					<sn-text flatten font-size="$12" color="$textLight" custom-style="margin-top:8px;">{{ t('snLoading.nativeMode') }}</sn-text>
				</view>
			</view>
		</demo-card>

		<demo-card :title="t('snLoading.iconTitle')" :subtitle="t('snLoading.iconDesc')">
			<view class="demo-icons" flatten>
				<sn-loading mode="icon" custom-class="demo-spacing" icon="loader-line" />
				<sn-loading mode="icon" custom-class="demo-spacing" icon="loader-2-line" />
				<sn-loading mode="icon" custom-class="demo-spacing" icon="loader-3-line" />
				<sn-loading mode="icon" custom-class="demo-spacing" icon="refresh-line" />
				<sn-loading mode="icon" custom-class="demo-spacing" icon="gps-line" />
				<sn-loading mode="icon" custom-class="demo-spacing" icon="gradienter-line" />
				<sn-loading mode="icon" custom-class="demo-spacing" icon="dashboard-3-line" />
				<sn-loading mode="icon" custom-class="demo-spacing" icon="disc-line" />
			</view>
		</demo-card>

		<demo-card :title="t('snLoading.colorTitle')" :subtitle="t('snLoading.colorDesc')">
			<view class="demo-row" flatten>
				<sn-loading custom-class="demo-spacing" icon-color="#ff9b9b" />
				<sn-loading custom-class="demo-spacing" icon-color="$success" />
				<sn-loading custom-class="demo-spacing" icon-color="$warning" />
			</view>
			<view class="demo-row" flatten>
				<sn-loading custom-class="demo-spacing" mode="native" icon-color="$error" />
				<sn-loading custom-class="demo-spacing" mode="native" icon-color="$info" />
				<sn-loading custom-class="demo-spacing" mode="native" icon-color="#a29bff" />
			</view>
		</demo-card>

		<demo-card :title="t('snLoading.sizeTitle')" :subtitle="t('snLoading.sizeDesc')">
			<view class="demo-row" flatten>
				<sn-loading custom-class="demo-spacing" icon-size="15px" />
				<sn-loading custom-class="demo-spacing" icon-size="25px" />
				<sn-loading custom-class="demo-spacing" icon-size="35px" />
			</view>
			<view class="demo-row" flatten>
				<sn-loading custom-class="demo-spacing" mode="native" icon-size="$20" />
				<sn-loading custom-class="demo-spacing" mode="native" icon-size="$30" />
				<sn-loading custom-class="demo-spacing" mode="native" icon-size="$40" />
			</view>
		</demo-card>

		<demo-card :title="t('snLoading.textTitle')" :subtitle="t('snLoading.textDesc')">
			<view class="demo-row" flatten>
				<sn-loading custom-class="demo-spacing" :text="t('snLoading.loading')" />
				<sn-loading custom-class="demo-spacing" :text="t('snLoading.loading')" text-size="16px" text-color="$primary" />
				<sn-loading custom-class="demo-spacing" :text="t('snLoading.loading')" vertical />
			</view>
			<view class="demo-row" flatten>
				<sn-loading custom-class="demo-spacing" mode="native" :text="t('snLoading.loading')" text-size="$16" text-color="$primary" />
				<sn-loading custom-class="demo-spacing" mode="native" :text="t('snLoading.loading')" vertical />
			</view>
		</demo-card>

		<demo-card :title="t('snLoading.styleTitle')" :subtitle="t('snLoading.styleDesc')">
			<view class="demo-row" flatten>
				<sn-loading loading-style="padding: 8px; border-radius: 50%; background-color: var(--sn-primary-light);"
					custom-style="padding: 10px;" />
				<sn-loading mode="native" :text="t('snLoading.styledText')" text-style="font-weight: bold;"
					loading-class="demo-loading-big" custom-style="margin-left: 16px;" />
			</view>
		</demo-card>

		<demo-card :title="t('snLoading.slotTitle')" :subtitle="t('snLoading.slotDesc')">
			<sn-loading :text="t('snLoading.defaultText')">
				<view class="demo-slot-text" flatten>
					<sn-text flatten font-size="$13" color="$primary">{{ t('snLoading.slotContent') }}</sn-text>
				</view>
			</sn-loading>
		</demo-card>

		<demo-card :title="t('snLoading.sceneTitle')" :subtitle="t('snLoading.sceneDesc')">
			<view class="scene-card" flatten>
				<view class="demo-row" flatten>
					<sn-loading mode="native" :text="t('snLoading.refreshing')" text-size="$13" />
					<sn-button type="primary" level="third" size="normal" custom-style="margin-left:auto;"
						@click="onRefresh">{{ t('snLoading.simulateRefresh') }}</sn-button>
				</view>
				<sn-text flatten font-size="$12" color="$textLight" custom-style="margin-top:8px;">{{ refreshLog }}</sn-text>
			</view>
		</demo-card>
	</sn-page>
</template>

<script lang="uts" setup>
import { useI18n } from 'vue-i18n'

const { t } = useI18n()
const refreshLog = ref<string>(t('snLoading.refreshHint'))
let refreshTimer: number | null = null

function onRefresh(): void {
	refreshLog.value = t('snLoading.requesting')
	if (refreshTimer != null) {
		clearTimeout(refreshTimer)
	}
	refreshTimer = setTimeout((): void => {
		refreshLog.value = t('snLoading.refreshDone')
		refreshTimer = null
	}, 1500)
}

onUnmounted((): void => {
	if (refreshTimer != null) {
		clearTimeout(refreshTimer)
		refreshTimer = null
	}
})
</script>

<style lang="scss">
.demo-row {
	flex-direction: row;
	flex-wrap: wrap;
	align-items: center;
}
.demo-col {
	flex-direction: column;
	align-items: center;
	justify-content: center;
	margin-right: 24px;
}
.demo-icons {
	flex-direction: row;
	flex-wrap: wrap;
}
.demo-spacing {
	margin: 0 14px 12px 0;
}
.demo-loading-big {
	width: 30px;
	height: 30px;
