<template>
	<sn-page>
		<sn-topbar :title="t('snDrawer.title')"></sn-topbar>

		<demo-card :title="t('snDrawer.basicTitle')" :subtitle="t('snDrawer.basicDesc')">
			<sn-button :text="t('snDrawer.openBottom')" type="primary" custom-style="flex:1;" @click="openDrawer" />
			<sn-text type="text-light" fontSize="$12" :text="t('snDrawer.maskTip')" custom-style="margin-top:8px;" flatten />
		</demo-card>

		<demo-card :title="t('snDrawer.dirTitle')" :subtitle="t('snDrawer.dirDesc')">
			<view class="anim-row" flatten>
				<sn-button :text="t('snDrawer.dirTop')"  type="info" custom-style="flex:1;margin-right:8px;" @click="openTopDrawer" />
				<sn-button :text="t('snDrawer.dirBottom')"  type="primary" custom-style="flex:1;margin-left:8px;" @click="openDrawer" />
			</view>
			<view class="anim-row" flatten>
				<sn-button :text="t('snDrawer.dirLeft')"  type="success" custom-style="flex:1;margin-right:8px;" @click="openLeftDrawer" />
				<sn-button :text="t('snDrawer.dirRight')"  type="warning" custom-style="flex:1;margin-left:8px;" @click="openRightDrawer" />
			</view>
		</demo-card>

		<demo-card :title="t('snDrawer.sizeTitle')" :subtitle="t('snDrawer.sizeDesc')">
			<view class="config-row" flatten>
				<sn-text :text="t('snDrawer.panelHeight')" custom-style="width:130px;" flatten />
				<sn-stepper v-model="configs.height" :step="40" :min="120" style="flex:1;" />
			</view>
			<view class="config-row" flatten>
				<sn-text :text="t('snDrawer.panelWidth')" custom-style="width:130px;" flatten />
				<sn-stepper v-model="configs.width" :step="40" :min="120" style="flex:1;" />
			</view>
			<view class="config-row" flatten>
				<sn-text :text="t('snDrawer.slideHeightLabel')" custom-style="width:130px;" flatten />
				<sn-stepper v-model="configs.slideHeight" :step="20" :min="0" style="flex:1;" />
			</view>
			<view class="config-row" flatten>
				<sn-text flatten :text="t('snDrawer.slideWidthLabel')" custom-style="width:130px;" />
				<sn-stepper v-model="configs.slideWidth" :step="20" :min="0" style="flex:1;" />
			</view>
		</demo-card>

		<demo-card :title="t('snDrawer.colorTitle')" :subtitle="t('snDrawer.colorDesc')">
			<view flatten class="config-row">
				<sn-text flatten :text="t('snDrawer.bgColorLabel')" custom-style="width:130px;" />
				<sn-input v-model="configs.bgColor" :placeholder="t('snDrawer.defaultFront')" style="flex:1;" />
			</view>
			<view flatten class="config-row">
				<sn-text flatten :text="t('snDrawer.lineColorLabel')" custom-style="width:130px;" />
				<sn-input v-model="configs.lineColor" :placeholder="t('snDrawer.defaultLineText')" style="flex:1;" />
			</view>
		</demo-card>

		<demo-card :title="t('snDrawer.behaviorTitle')" :subtitle="t('snDrawer.behaviorDesc')">
			<view flatten class="config-row">
				<sn-text flatten :text="t('snDrawer.slideCloseLabel')" custom-style="width:130px;" />
				<sn-switch v-model="configs.slideClose" />
			</view>
			<view flatten class="config-row">
				<sn-text flatten :text="t('snDrawer.maskCloseLabel')" custom-style="width:130px;" />
				<sn-switch v-model="configs.maskClose" />
			</view>
			<view flatten class="config-row">
				<sn-text flatten :text="t('snDrawer.preventBackLabel')" custom-style="width:130px;" />
				<sn-switch v-model="configs.preventBack" />
			</view>
		</demo-card>

		<demo-card :title="t('snDrawer.eventTitle')" :subtitle="t('snDrawer.eventDesc')">
			<view flatten class="config-row">
				<sn-text flatten :text="t('snDrawer.afterEnterLabel')" custom-style="width:140px;" />
				<sn-text flatten bold fontSize="$14" :text="t('snDrawer.evAfterEnter', { c: enterCount } as UTSJSONObject)" />
			</view>
			<view flatten class="config-row">
				<sn-text flatten :text="t('snDrawer.afterLeaveLabel')" custom-style="width:140px;" />
				<sn-text flatten bold fontSize="$14" :text="t('snDrawer.evAfterLeave', { c: leaveCount } as UTSJSONObject)" />
			</view>
			<view flatten class="config-row">
				<sn-text flatten :text="t('snDrawer.overlayLabel')" custom-style="width:140px;" />
				<sn-text flatten bold fontSize="$14" :text="t('snDrawer.evOverlay', { c: overlayCount } as UTSJSONObject)" />
			</view>
		</demo-card>

		<demo-card :title="t('snDrawer.sceneTitle')" :subtitle="t('snDrawer.sceneDesc')">
			<sn-button :text="t('snDrawer.viewCart')" type="success" custom-style="flex:1;" @click="openCartDrawer" />
		</demo-card>

		<sn-drawer ref="drawerRef" position="bottom" :slide-close="configs.slideClose"
				:mask-close="configs.maskClose" :prevent-back="configs.preventBack"
				:height="`${configs.height}px`" :slide-height="`${configs.slideHeight}px`"
				:bg-color="configs.bgColor" :line-color="configs.lineColor"
				@afterenter="onAfterEnter" @afterleave="onAfterLeave" @clickoverlay="onOverlay">
			<view class="drawer-body">
				<sn-text flatten bold fontSize="$16" color="$title" :text="t('snDrawer.bottomDrawer')" />
				<sn-text flatten fontSize="$13" color="$textLight" :text="t('snDrawer.bottomTip')" custom-style="margin-top:8px;" />
				<sn-button :text="t('snDrawer.close')"  type="primary" custom-style="margin-top:16px;" @click="closeDrawer" />
			</view>
		</sn-drawer>

		<sn-drawer ref="topDrawerRef" position="top" height="220px">
			<view class="drawer-body">
				<sn-text flatten bold fontSize="$16" color="$title" :text="t('snDrawer.topDrawer')" />
				<sn-text flatten fontSize="$13" color="$textLight" :text="t('snDrawer.topTip')" custom-style="margin-top:8px;" />
				<sn-button :text="t('snDrawer.close')"  type="primary" custom-style="margin-top:16px;" @click="closeTopDrawer" />
			</view>
		</sn-drawer>

		<sn-drawer ref="leftDrawerRef" position="left" :width="`${configs.width}px`"
				:slide-width="`${configs.slideWidth}px`" :bg-color="configs.bgColor" :line-color="configs.lineColor">
			<view class="drawer-body">
				<sn-text flatten bold fontSize="$16" color="$title" :text="t('snDrawer.leftDrawer')" />
				<sn-text flatten fontSize="$13" color="$textLight" :text="t('snDrawer.leftTip')" custom-style="margin-top:8px;" />
				<sn-button :text="t('snDrawer.close')"  type="primary" custom-style="margin-top:16px;" @click="closeLeftDrawer" />
			</view>
		</sn-drawer>

		<sn-drawer ref="rightDrawerRef" position="right" :width="`${configs.width}px`"
				:slide-width="`${configs.slideWidth}px`" :bg-color="configs.bgColor" :line-color="configs.lineColor">
			<view class="drawer-body">
				<sn-text flatten bold fontSize="$16" color="$title" :text="t('snDrawer.rightDrawer')" />
				<sn-text flatten fontSize="$13" color="$textLight" :text="t('snDrawer.rightTip')" custom-style="margin-top:8px;" />
				<sn-button :text="t('snDrawer.close')"  type="primary" custom-style="margin-top:16px;" @click="closeRightDrawer" />
			</view>
		</sn-drawer>

		<sn-drawer ref="cartDrawerRef" position="bottom" height="360px" @clickoverlay="onOverlay">
			<view class="drawer-body">
				<sn-text flatten bold fontSize="$16" color="$title" :text="t('snDrawer.cartTitle')" />
				<view class="cart-item" v-for="(g, i) in cartGoods" :key="i" flatten>
					<sn-text flatten fontSize="$14" color="$text" :text="g.name" custom-style="flex:1;" />
					<sn-text flatten fontSize="$14" color="$error" :text="g.price" />
				</view>
				<sn-button :text="t('snDrawer.checkout')" type="primary" custom-style="margin-top:12px;" @click="closeCartDrawer" />
			</view>
		</sn-drawer>
	</sn-page>
</template>

<script lang="uts" setup>

import { useI18n } from 'vue-i18n'
import type { ComponentPublicInstance } from 'vue'

const { t } = useI18n()

type CartGoods = {
	name: string
	price: string
}

type Configs = {
	height: number
	width: number
	slideHeight: number
	slideWidth: number
	bgColor: string
	lineColor: string
	slideClose: boolean
	maskClose: boolean
	preventBack: boolean
}

const drawerRef = ref<ComponentPublicInstance | null>(null)
const topDrawerRef = ref<ComponentPublicInstance | null>(null)
const leftDrawerRef = ref<ComponentPublicInstance | null>(null)
const rightDrawerRef = ref<ComponentPublicInstance | null>(null)
const cartDrawerRef = ref<ComponentPublicInstance | null>(null)
const enterCount = ref<number>(0)
const leaveCount = ref<number>(0)
const overlayCount = ref<number>(0)

const configs = ref<Configs>({
	height: 320,
	width: 260,
	slideHeight: 100,
	slideWidth: 100,
	bgColor: '$front',
	lineColor: '',
	slideClose: true,
	maskClose: true,
	preventBack: false
})

const cartGoods: CartGoods[] = [
	{ name: t('snDrawer.cart1Name'), price: '¥399' },
	{ name: t('snDrawer.cart2Name'), price: '¥129' }
]

function openDrawer(): void {
	drawerRef.value?.$callMethod('open')
}

function closeDrawer(): void {
	drawerRef.value?.$callMethod('close')
}

function openTopDrawer(): void {
	topDrawerRef.value?.$callMethod('open')
}

function closeTopDrawer(): void {
	topDrawerRef.value?.$callMethod('close')
}

function openLeftDrawer(): void {
	leftDrawerRef.value?.$callMethod('open')
}

function closeLeftDrawer(): void {
	leftDrawerRef.value?.$callMethod('close')
}

function openRightDrawer(): void {
	rightDrawerRef.value?.$callMethod('open')
}

function closeRightDrawer(): void {
	rightDrawerRef.value?.$callMethod('close')
}

function openCartDrawer(): void {
	cartDrawerRef.value?.$callMethod('open')
}

function closeCartDrawer(): void {
	cartDrawerRef.value?.$callMethod('close')
}

function onAfterEnter(): void {
	enterCount.value = enterCount.value + 1
}

function onAfterLeave(): void {
	leaveCount.value = leaveCount.value + 1
}

function onOverlay(): void {
	overlayCount.value = overlayCount.value + 1
}
</script>

<style lang="scss">
.anim-row {
	flex-direction: row;
	margin-bottom: 10px;
}
.config-row {
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	margin-bottom: 12px;
}
.drawer-body {
	flex-direction: column;
}
.cart-item {
	flex-direction: row;
	align-items: center;
	padding: 12px 0;
	border-bottom-width: 1px;
	border-bottom-style: solid;
	border-bottom-color: var(--sn-line);
}
</style>
