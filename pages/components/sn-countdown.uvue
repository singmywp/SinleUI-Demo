<template>
	<sn-page :title="t('snCountdown.title')" :show-back="true">
		<demo-card :title="t('snCountdown.basicTitle')" :subtitle="t('snCountdown.basicDesc')">
			<sn-countdown ref="cd1" :time="3600000" format="HH:mm:ss" @change="onChange1" @finish="onFinish1" />
			<sn-text type="text-light" :font-size="13" :text="card1Text" custom-style="margin-top:8px;" flatten />
		</demo-card>

		<demo-card :title="t('snCountdown.msTitle')" :subtitle="t('snCountdown.msDesc')">
			<sn-countdown :time="90000" format="mm:ss.SS" :millisecond="true" text-color="$error" text-size="$20" custom-style="margin-bottom:8px;" />
			<sn-countdown :time="10000" format="ss.S" :millisecond="true" text-color="$warning" text-size="$18" />
		</demo-card>

		<demo-card :title="t('snCountdown.formatTitle')" :subtitle="t('snCountdown.formatDesc')">
			<sn-countdown :time="197500000" format="DD天HH时mm分ss秒" text-color="$primary" custom-style="margin-bottom:8px;" />
			<sn-countdown :time="150000" format="mm:ss" text-size="$22" text-color="$success" />
		</demo-card>

		<demo-card :title="t('snCountdown.apiTitle')" :subtitle="t('snCountdown.apiDesc')">
			<sn-countdown ref="cdCtl" :time="60000" format="mm:ss" :autoplay="false" text-size="$22" text-color="$primaryDark" />
			<view class="cd-ctl-row" flatten>
				<sn-button :text="t('snCountdown.start')"  type="primary" custom-style="margin-right:8px;" @click="startCd" />
				<sn-button :text="t('snCountdown.pause')"  type="info" custom-style="margin-right:8px;" @click="pauseCd" />
				<sn-button :text="t('snCountdown.reset')"  type="warning" custom-style="margin-right:8px;" @click="resetCd" />
				<sn-button :text="t('snCountdown.stop')"  type="error" @click="stopCd" />
			</view>
		</demo-card>

		<demo-card :title="t('snCountdown.seckillTitle')" :subtitle="t('snCountdown.seckillDesc')">
			<view class="cd-seckill" flatten>
				<view class="cd-seckill-head" flatten>
					<sn-text bold :font-size="16" color="#fff" :text="t('snCountdown.seckill')" flatten />
					<sn-countdown ref="cdKill" :time="7200000" format="HH:mm:ss" text-color="#fff" text-size="$16" @finish="onKillFinish" />
				</view>
				<view class="cd-seckill-body" flatten>
					<view class="cd-seckill-icon" flatten>
						<sn-icon name="flashlight-line" :size="30" color="$error" />
					</view>
					<view class="cd-seckill-info" flatten>
						<sn-text bold :font-size="15" :text="t('snCountdown.earphones')" flatten />
						<sn-text type="text-light" :font-size="11" :text="t('snCountdown.price')" custom-style="margin-top:4px;" flatten />
					</view>
					<sn-button :text="killBtnText"  :type="isKilling ? 'error' : 'info'" :disabled="!isKilling" @click="onBuy" />
				</view>
			</view>
		</demo-card>

		<demo-card :title="t('snCountdown.slotTitle')" :subtitle="t('snCountdown.slotDesc')">
			<sn-countdown :time="3661000" format="HH:mm:ss" @change="onSegChange"
				custom-style="justify-content:center;padding-top:16px;padding-bottom:16px;">
				<view class="cd-seg-cell" flatten>
					<sn-text bold :font-size="24" color="#fff" :text="segArr[0]" flatten />
				</view>
				<sn-text bold :font-size="18" color="$textLight" :text="t('snCountdown.hour')" custom-style="margin-left:5px;margin-right:5px;" flatten />
				<view class="cd-seg-cell cd-seg-cell-accent" flatten>
					<sn-text bold :font-size="24" color="#fff" :text="segArr[1]" flatten />
				</view>
				<sn-text bold :font-size="18" color="$textLight" :text="t('snCountdown.minute')" custom-style="margin-left:5px;margin-right:5px;" flatten />
				<view class="cd-seg-cell" flatten>
					<sn-text bold :font-size="24" color="#fff" :text="segArr[2]" flatten />
				</view>
				<sn-text bold :font-size="18" color="$textLight" :text="t('snCountdown.second')" custom-style="margin-left:5px;" flatten />
			</sn-countdown>
		</demo-card>
	</sn-page>
</template>

<script lang="uts" setup>
import { useI18n } from 'vue-i18n'
import { snu } from '@/uni_modules/sinle-ui'
 import type { SnTime } from '@/uni_modules/sinle-ui/core/types/index.uts'
import type { ComponentPublicInstance } from 'vue'

const { t } = useI18n()



const cd1 = ref<UniElement | null>(null)
const cdCtl = ref<ComponentPublicInstance | null>(null)
const cdKill = ref<UniElement | null>(null)

const changeCount1 = ref<number>(0)
const finishCount1 = ref<number>(0)

const segArr = ref<string[]>(['01', '01', '01'])
const isKilling = ref<boolean>(true)
const killBtnText = ref<string>(t('snCountdown.killBtn'))

const card1Text = computed<string>(() => t('snCountdown.changeCounts', { c1: changeCount1.value, c2: finishCount1.value } as UTSJSONObject))

function onChange1(v: SnTime): void {
	changeCount1.value = changeCount1.value + 1
}

function onFinish1(): void {
	finishCount1.value = finishCount1.value + 1
}

function onKillFinish(): void {
	isKilling.value = false
	killBtnText.value = t('snCountdown.killEnded')
}

function onBuy(): void {
	snu.showToast({
		text: t('snCountdown.orderSuccess'),
		icon: 'none'
	})
}

function onSegChange(v: SnTime): void {
	segArr.value = [pad2(v.h), pad2(v.m), pad2(v.s)]
}

function pad2(n: number): string {
	const s = n.toString()
	return s.length < 2 ? '0' + s : s
}

function startCd(): void {
	cdCtl.value?.$callMethod('start')
}

function pauseCd(): void {
	cdCtl.value?.$callMethod('pause')
}

function resetCd(): void {
	cdCtl.value?.$callMethod('reset')
}

function stopCd(): void {
	cdCtl.value?.$callMethod('stop')
}
</script>

<style lang="scss">
.cd-ctl-row {
	flex-direction: row;
	align-items: center;
	margin-top: 12px;
}
.cd-seckill {
	border-radius: 12px;
	overflow: hidden;
	background-color: var(--sn-primary);
}
.cd-seckill-head {
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	padding: 10px 14px;
	background-color: var(--sn-primary-dark);
}
.cd-seckill-body {
	flex-direction: row;
	align-items: center;
	padding: 14px;
	background-color: var(--sn-front);
}
.cd-seckill-icon {
	width: 48px;
	height: 48px;
	border-radius: 12px;
	background-color: var(--sn-error-light);
	flex-direction: row;
	align-items: center;
	justify-content: center;
}
.cd-seckill-info {
	flex: 1;
	flex-direction: column;
	margin-left: 12px;
	margin-right: 8px;
}
.cd-seg-cell {
	width: 46px;
	height: 46px;
	border-radius: 10px;
	background-color: var(--sn-primary-dark);
	flex-direction: row;
	align-items: center;
	justify-content: center;
}
.cd-seg-cell-accent {
	background-color: var(--sn-primary);
}
</style>
