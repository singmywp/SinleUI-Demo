<template>
	<sn-page :title="t('snCountto.title')" :show-back="true">
		<demo-card :title="t('snCountto.basicTitle')" :subtitle="t('snCountto.basicDesc')">
			<sn-countto ref="ct1" :end-val="6666" @finish="onFinish1" />
			<sn-text type="text-light" :font-size="13" :text="finishCountText" custom-style="margin-top:8px;" flatten />
		</demo-card>

		<demo-card :title="t('snCountto.startTitle')" :subtitle="t('snCountto.startDesc')">
			<sn-countto :start-val="6666" :end-val="7777" text-size="$22" text-color="$primary" />
		</demo-card>

		<demo-card :title="t('snCountto.decimalTitle')" :subtitle="t('snCountto.decimalDesc')">
			<sn-countto :start-val="6666" :end-val="7777" :decimals="2" text-color="$success" custom-style="margin-bottom:8px;" />
			<sn-countto :start-val="6666" :end-val="7777" :decimals="8" text-size="$14" text-color="$warning" />
		</demo-card>

		<demo-card :title="t('snCountto.durationTitle')" :subtitle="t('snCountto.durationDesc')">
			<sn-countto :duration="10000" :start-val="6666" :end-val="7777" text-color="$text" />
		</demo-card>

		<demo-card :title="t('snCountto.easingTitle')" :subtitle="t('snCountto.easingDesc')">
			<sn-countto easing :duration="5000" :end-val="7777" text-color="$error" />
		</demo-card>

		<demo-card :title="t('snCountto.separateTitle')" :subtitle="t('snCountto.separateDesc')">
			<sn-countto :separate="3" :duration="10000" :end-val="1000000" text-size="$24" text-color="$primaryDark" />
		</demo-card>

		<demo-card :title="t('snCountto.customTitle')" :subtitle="t('snCountto.customDesc')">
			<sn-countto text-size="$30" text-color="$successDark" :end-val="7777" custom-style="font-weight:bold;" />
		</demo-card>

		<demo-card :title="t('snCountto.apiTitle')" :subtitle="t('snCountto.apiDesc')">
			<sn-countto ref="ctCtl" :duration="5000" :end-val="7777" :autoplay="false" text-size="$22" text-color="$primaryDark" />
			<view class="ct-ctl-row" flatten>
				<sn-button :text="runningText"  :type="isRunning ? 'warning' : 'primary'" custom-style="margin-right:8px;" @click="toggle" />
				<sn-button :text="t('snCountto.reset')"  type="info" custom-style="margin-right:8px;" @click="resetCt" />
				<sn-button :text="t('snCountto.stop')"  type="error" @click="stopCt" />
			</view>
		</demo-card>

		<demo-card :title="t('snCountto.boardTitle')" :subtitle="t('snCountto.boardDesc')">
			<view class="ct-board" flatten>
				<view class="ct-board-head" flatten>
					<sn-text bold :font-size="15" color="$primaryText" :text="t('snCountto.yearlyData')" flatten />
					<sn-text :font-size="11" color="$primaryLight" :text="t('snCountto.realtimeUpdate')" flatten />
				</view>
				<view class="ct-board-item" flatten>
					<sn-icon name="funds-line" :size="22" color="$success" />
					<sn-text :font-size="12" :text="t('snCountto.revenue')" custom-style="margin-left:8px;flex:1;" flatten />
					<sn-countto :start-val="0" :end-val="1860000" :duration="6000" :separate="3" text-size="$16" text-color="$text" />
				</view>
				<view class="ct-board-item ct-board-item-line" flatten>
					<sn-icon name="bar-chart-line" :size="22" color="$warning" />
					<sn-text :font-size="12" :text="t('snCountto.orders')" custom-style="margin-left:8px;flex:1;" flatten />
					<sn-countto :start-val="0" :end-val="12876" :duration="6000" :separate="3" text-size="$16" text-color="$text" />
				</view>
				<view class="ct-board-item ct-board-item-line" flatten>
					<sn-icon name="percent-line" :size="22" color="$error" />
					<sn-text :font-size="12" :text="t('snCountto.growth')" custom-style="margin-left:8px;flex:1;" flatten />
					<sn-countto :start-val="0" :end-val="88" :duration="6000" :easing="true" text-size="$16" text-color="$text" />
					<sn-text bold :font-size="16" color="$text" text="%" flatten />
				</view>
			</view>
		</demo-card>
	</sn-page>
</template>

<script lang="uts" setup>
import { useI18n } from 'vue-i18n'
import type { ComponentPublicInstance } from 'vue'

const { t } = useI18n()



const ctCtl = ref<ComponentPublicInstance | null>(null)

const finishCount1 = ref<number>(0)
const isRunning = ref<boolean>(false)
const runningText = ref<string>(t('snCountto.start'))

const finishCountText = computed<string>(() => t('snCountto.finishCount', { c: finishCount1.value } as UTSJSONObject))

function onFinish1(): void {
	finishCount1.value = finishCount1.value + 1
}

function callCtl(method: string): void {
	const ele = ctCtl.value
	if (ele != null) {
		ele.$callMethod(method)
	}
}

function toggle(): void {
	if (isRunning.value) {
		isRunning.value = false
		runningText.value = t('snCountto.start')
		callCtl('pause')
	} else {
		isRunning.value = true
		runningText.value = t('snCountto.pause')
		callCtl('play')
	}
}

function resetCt(): void {
	isRunning.value = false
	runningText.value = t('snCountto.start')
	callCtl('reset')
}

function stopCt(): void {
	isRunning.value = false
	runningText.value = t('snCountto.start')
	callCtl('stop')
}
</script>

<style lang="scss">
.ct-ctl-row {
	flex-direction: row;
	align-items: center;
	margin-top: 12px;
}
.ct-board {
	border-radius: 12px;
	overflow: hidden;
	background-color: var(--sn-primary-light);
}
.ct-board-head {
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	padding: 10px 14px;
	background-color: var(--sn-primary);
}
.ct-board-item {
	flex-direction: row;
	align-items: center;
	padding: 12px 14px;
}
.ct-board-item-line {
	border-top-width: 1px;
	border-top-color: rgba(255, 255, 255, 0.12);
}
</style>
