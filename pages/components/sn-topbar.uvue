</template>

<script lang="uts" setup>
import { useI18n } from 'vue-i18n'
import type { SnDataItem } from '@/uni_modules/sinle-ui/core/types/index.uts'

const { t } = useI18n()
const iconFeatures: SnDataItem[] = [
	{ icon: 'search-line' },
	{ icon: 'notification-3-line' }
]

const mixedFeatures: SnDataItem[] = [
	{ icon: 'star-line' },
	{ text: t('snTopbar.publish') }
]

const whiteIconFeatures: SnDataItem[] = [
	{ icon: 'share-line' }
]

const menuData: SnDataItem[] = [
	{ text: t('snTopbar.refresh'), icon: 'refresh-line' },
	{ text: t('snTopbar.copyLink'), icon: 'link' },
	{ text: t('snTopbar.share'), icon: 'share-line' },
	{ text: t('snTopbar.report'), icon: 'spam-3-line', disabled: true }
]

const eventLog = ref<string>('')

function onBack(): void {
	eventLog.value = t('snTopbar.clickedBack')
}

function onHome(): void {
	eventLog.value = t('snTopbar.clickedHome')
}

function onFeatureClick(_item: SnDataItem, index: number): void {
	eventLog.value = t('snTopbar.clickedFeature') + index.toString()
}

function onMenuSelect(_item: SnDataItem, index: number): void {
	eventLog.value = t('snTopbar.selectedMenu') + index.toString()
}


</script>

