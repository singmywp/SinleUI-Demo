			</view>
			
			<view class="event-log" flatten>
				<sn-text v-if="eventLog != ''" font-size="$13" color="$primary">{{ eventLog }}</sn-text>
				<sn-text v-else font-size="$13" type="text-light">{{ t('snTopbar.noEvent') }}</sn-text>
			</view>
