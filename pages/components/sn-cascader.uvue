<template>
	<sn-page :title="t('snCascader.title')" :show-back="true">
		<demo-card :title="t('snCascader.basic')" :subtitle="t('snCascader.basicSub')">
			<sn-button type="primary" :text="t('snCascader.selectCategory')" custom-style="flex:1;" @click="openBasic" />
			<sn-text font-size="$12" color="$textLight" custom-style="margin-top:10px;" flatten>{{ basicText }}</sn-text>
		</demo-card>

		<demo-card :title="t('snCascader.async')" :subtitle="t('snCascader.asyncSub')">
			<sn-button type="success" :text="t('snCascader.selectRegion')" custom-style="flex:1;" @click="openAsync" />
			<sn-text font-size="$12" color="$textLight" custom-style="margin-top:10px;" flatten>{{ asyncText }}</sn-text>
		</demo-card>

		<demo-card :title="t('snCascader.iconStyle')" :subtitle="t('snCascader.iconStyleSub')">
			<view class="demo-row" flatten>
				<sn-text font-size="$14" color="$text" :text="t('snCascader.pushAni')" custom-style="flex:1;" flatten />
				<sn-switch v-model="styledPush" />
			</view>
			<sn-button type="primary" :text="t('snCascader.selectCategory')" custom-style="flex:1;margin-top:12px;" @click="openStyled" />
			<sn-text font-size="$12" color="$textLight" custom-style="margin-top:10px;" flatten>{{ styledText }}</sn-text>
		</demo-card>

		<sn-cascader ref="basicEle" v-model="basicValue" :title="t('snCascader.chooseCategoryTitle')" :data="categoryData"
			@change="onBasicChange" />
		<sn-cascader ref="asyncEle" v-model="asyncValue" :title="t('snCascader.chooseRegionTitle')" :data="regionRoots"
			:load-data="loadRegions" @change="onAsyncChange" @load-error="onLoadError" />
		<sn-cascader ref="styledEle" v-model="styledValue" :title="t('snCascader.chooseCategoryTitle')" :data="styledData"
			:nav-mode="styledPush ? 'push' : 'swipe'" option-icon-style="color: var(--sn-success);"
			active-option-icon-style="color: var(--sn-success);" active-option-text-style="font-weight: 700;"
			nav-text-style="color: var(--sn-text-light);" active-nav-text-class="cascader-active-nav"
			active-nav-text-style="font-weight: 700;" @change="onStyledChange" />
	</sn-page>
</template>

<script lang="uts" setup>
import { useI18n } from 'vue-i18n'
import { snu } from '@/uni_modules/sinle-ui'
 import type { ComponentPublicInstance } from 'vue'

const { t } = useI18n()

type CascaderOption = {
	value: string
	label: string
	icon?: string | null
	disabled?: boolean | null
	leaf?: boolean | null
	children?: CascaderOption[] | null
}

type CascaderValue = string[]

type CascaderDetail = {
	values: string[]
	labels: string[]
	options: CascaderOption[]
}

type LoadResolve = (options: CascaderOption[]) => void
type LoadReject = () => void

const categoryData = computed<CascaderOption[]>(() => [
	{
		value: 'digital', label: t('snCascader.digital'), children: [
			{
				value: 'computer', label: t('snCascader.computerOffice'), children: [
					{ value: 'laptop', label: t('snCascader.laptop'), leaf: true },
					{ value: 'desktop', label: t('snCascader.desktop'), leaf: true }
				]
			},
			{ value: 'phone', label: t('snCascader.phoneComm'), leaf: true }
		]
	},
	{
		value: 'home', label: t('snCascader.homeLife'), children: [
			{ value: 'kitchen', label: t('snCascader.kitchen'), leaf: true },
			{ value: 'cleaning', label: t('snCascader.cleaning'), leaf: true }
		]
	}
])

const styledData = computed<CascaderOption[]>(() => [
	{
		value: 'digital', label: t('snCascader.digital'), icon: 'computer-line', children: [
			{
				value: 'computer', label: t('snCascader.computerOffice'), icon: 'cpu-line', children: [
					{ value: 'laptop', label: t('snCascader.laptop'), icon: 'keyboard-line', leaf: true },
					{ value: 'desktop', label: t('snCascader.desktop'), icon: 'computer-line', leaf: true }
				]
			},
			{ value: 'phone', label: t('snCascader.phoneComm'), icon: 'smartphone-line', leaf: true }
		]
	},
	{
		value: 'home', label: t('snCascader.homeLife'), icon: 'home-line', children: [
			{ value: 'kitchen', label: t('snCascader.kitchen'), icon: 'restaurant-line', leaf: true },
			{ value: 'cleaning', label: t('snCascader.cleaning'), icon: 'shopping-bag-line', leaf: true }
		]
	}
])

const regionRoots = computed<CascaderOption[]>(() => [
	{ value: 'tianjin', label: t('snCascader.tianjin'), leaf: false },
	{ value: 'guangdong', label: t('snCascader.guangdong'), leaf: false }
])

const basicEle = ref<ComponentPublicInstance | null>(null)
const asyncEle = ref<ComponentPublicInstance | null>(null)
const styledEle = ref<ComponentPublicInstance | null>(null)
const basicValue = ref<CascaderValue>([])
const asyncValue = ref<CascaderValue>([])
const styledValue = ref<CascaderValue>([])
const basicText = ref<string>(t('snCascader.notSelected'))
const asyncText = ref<string>(t('snCascader.notSelected'))
const styledText = ref<string>(t('snCascader.notSelected'))
const styledPush = ref<boolean>(false)

function openBasic(): void {
	basicEle.value?.$callMethod('open')
}

function openAsync(): void {
	asyncEle.value?.$callMethod('open')
}

function openStyled(): void {
	styledEle.value?.$callMethod('open')
}

function detailText(detail: CascaderDetail): string {
	let text = ''
	for (let i = 0; i < detail.labels.length; i++) {
		if (i > 0) text += ' / '
		text += detail.labels[i]
	}
	return text
}

function onBasicChange(_value: CascaderValue, detail: CascaderDetail): void {
	basicText.value = detailText(detail)
}

function onAsyncChange(_value: CascaderValue, detail: CascaderDetail): void {
	asyncText.value = detailText(detail)
}

function onStyledChange(_value: CascaderValue, detail: CascaderDetail): void {
	styledText.value = detailText(detail)
}

function loadRegions(parent: CascaderOption | null, level: number, resolve: LoadResolve, reject: LoadReject): void {
	setTimeout((): void => {
		if (parent == null) {
			resolve(regionRoots.value)
			return
		}
		if (level == 1 && parent.value == 'tianjin') {
			resolve([
				{ value: 'tianjin-city', label: t('snCascader.tianjinCity'), leaf: false }
			])
			return
		}
		if (level == 2 && parent.value == 'tianjin-city') {
			resolve([
				{ value: 'heping', label: t('snCascader.heping'), leaf: true },
				{ value: 'hedong', label: t('snCascader.hedong'), leaf: true },
				{ value: 'hexi', label: t('snCascader.hexi'), leaf: true },
				{ value: 'nankai', label: t('snCascader.nankai'), leaf: true },
				{ value: 'hebei', label: t('snCascader.hebei'), leaf: true },
				{ value: 'hongqiao', label: t('snCascader.hongqiao'), leaf: true },
				{ value: 'dongli', label: t('snCascader.dongli'), leaf: true },
				{ value: 'xiqing', label: t('snCascader.xiqing'), leaf: true },
				{ value: 'jinnan', label: t('snCascader.jinnan'), leaf: true },
				{ value: 'beichen', label: t('snCascader.beichen'), leaf: true }
			])
			return
		}
		if (level == 1 && parent.value == 'guangdong') {
			resolve([
				{ value: 'guangzhou', label: t('snCascader.guangzhou'), leaf: false },
				{ value: 'shenzhen', label: t('snCascader.shenzhen'), leaf: false }
			])
			return
		}
		if (level == 2 && parent.value == 'guangzhou') {
			resolve([
				{ value: 'tianhe', label: t('snCascader.tianhe'), leaf: true },
				{ value: 'yuexiu', label: t('snCascader.yuexiu'), leaf: true }
			])
			return
		}
		if (level == 2 && parent.value == 'shenzhen') {
			resolve([
				{ value: 'nanshan', label: t('snCascader.nanshan'), leaf: true },
				{ value: 'futian', label: t('snCascader.futian'), leaf: true }
			])
			return
		}
		reject()
	}, 500)
}

function onLoadError(_parent: CascaderOption | null, _level: number): void {
	snu.showToast({ text: t('snCascader.loadFailed'), icon: 'none' })
}
</script>

<style lang="scss">
.demo-row {
	flex-direction: row;
	align-items: center;
}

.cascader-active-nav {
	font-weight: 700;
}
</style>