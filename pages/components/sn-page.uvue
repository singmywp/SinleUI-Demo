<template>
	<sn-page :title="t('snPage.title')" :show-back="true" :bg-color="currentBgColor">
		<demo-card :title="t('snPage.bgTitle')" :subtitle="t('snPage.bgSubtitle')">
			<sn-select v-model="colorIdx" :data="colorOptions" width="160px" selected-mode="check"
				@change="onColorChange" />
		</demo-card>

		<demo-card :title="t('snPage.docTitle')" :subtitle="t('snPage.docSubtitle')">
			<sn-text type="text-light" font-size="$12" style="margin-bottom: 12px" flatten>
				{{ t('snPage.docDesc1') }}
			</sn-text>
			<sn-text type="text-light" font-size="$12" flatten>
				{{ t('snPage.docDesc2') }}
			</sn-text>
		</demo-card>
	</sn-page>
</template>

<script lang="uts" setup>
import { useI18n } from 'vue-i18n'
import { $snui } from '@/uni_modules/sinle-ui/index.uts'
import type { SnDataItem } from '@/uni_modules/sinle-ui/core/types/index.uts'

const { t } = useI18n()

const colorOptions = ref<SnDataItem[]>([])
const colorValues = ref<string[]>([])
const colorIdx = ref<number>(0)

const currentBgColor = ref<string>('')

onMounted((): void => {
	colorOptions.value = [
		{ id: '0', text: t('snPage.bgDefault') },
		{ id: '1', text: t('snPage.bgMoonWhite') },
		{ id: '2', text: t('snPage.bgSnowWhite') },
		{ id: '3', text: t('snPage.bgSkyBlue') },
		{ id: '4', text: t('snPage.bgMintGreen') },
		{ id: '5', text: t('snPage.bgWarmApricot') }
	]
	colorValues.value = [
		'',
		$snui.colors.page,
		$snui.colors.front,
		$snui.colors.primaryLight,
		$snui.colors.successLight,
		$snui.colors.warningLight
	]
})

function onColorChange(idx: number): void {
	if (idx >= 0 && idx < colorValues.value.length) {
		currentBgColor.value = colorValues.value[idx]
	}
}
</script>

