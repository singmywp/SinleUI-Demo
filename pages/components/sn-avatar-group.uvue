		<demo-card :title="t('snAvatarGroup.event')" :subtitle="t('snAvatarGroup.eventSub')">
			<view class="demo-item-inline" style="margin-bottom: 12px">
				<sn-avatar-group :data="avatarList" @click="onGroupClick" @dbclick="onGroupDbClick" />
			</view>
			<sn-text font-size="$13" color="$primary">{{ t('snAvatarGroup.recentEvent') }}{{ lastEvent }}</sn-text>
		</demo-card>
	</sn-page>
</template>

