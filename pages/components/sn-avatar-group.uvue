					<sn-text text-class="demo-label" font-size="$12" color="$textLight">size=36</sn-text>
				</view>
				<view class="demo-item">
					<sn-avatar-group :data="avatarList" :size="52" shape="square" />
					<sn-text text-class="demo-label" font-size="$12" color="$textLight">{{ t('snAvatarGroup.square52') }}</sn-text>
				</view>
			</view>
		</demo-card>

		<demo-card :title="t('snAvatarGroup.textGroup')" :subtitle="t('snAvatarGroup.textGroupSub')">
			<view class="demo-item-inline">
				<sn-avatar-group :data="textAvatarList" mode="spread" random-bg-color />
