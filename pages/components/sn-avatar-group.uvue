		<demo-card :title="t('snAvatarGroup.externalStyle')" :subtitle="t('snAvatarGroup.externalStyleSub')">
			<view class="demo-item-inline" style="margin-bottom: 12px">
				<sn-avatar-group :data="textAvatarList" mode="spread" avatar-class="demo-avatar-class" />
