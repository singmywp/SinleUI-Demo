	'https://img0.baidu.com/it/u=2264207564,2939741236&fm=253&fmt=auto&app=120&f=JPEG?w=506&h=500',
	'https://img0.baidu.com/it/u=1785299157,3302446795&fm=253&fmt=auto&app=120&f=JPEG?w=500&h=500',
	'https://img1.baidu.com/it/u=732365727,3649150979&fm=253&fmt=auto&app=120&f=JPEG?w=666&h=500',
	'https://img2.baidu.com/it/u=2614684919,3437897058&fm=253&fmt=auto&app=138&f=JPEG?w=500&h=500',
	'https://img2.baidu.com/it/u=2165576910,2454073122&fm=253&fmt=auto&app=120&f=JPEG?w=500&h=500',
	'https://img2.baidu.com/it/u=315001929,4032998020&fm=253&fmt=auto&app=120&f=JPEG?w=507&h=500'
]

const avatarList: SnAvatarGroupItem[] = [
	{ src: images[0] },
	{ src: images[1] },
	{ src: images[2] },
	{ src: images[3] },
	{ src: images[4] },
	{ src: images[5] }
]

const textAvatarList = computed<SnAvatarGroupItem[]>(() => [
	{ text: t('snAvatarGroup.avatarZhang') },
	{ text: t('snAvatarGroup.avatarLi') },
	{ text: t('snAvatarGroup.avatarWang') },
	{ text: t('snAvatarGroup.avatarZhao') },
	{ text: t('snAvatarGroup.avatarQian') }
])

const customColorList = computed<SnAvatarGroupItem[]>(() => [
	{ text: t('snAvatarGroup.avatarMain'), bgColor: '$primary', textColor: '$primaryText' },
	{ text: t('snAvatarGroup.avatarSuccess'), bgColor: '$success', textColor: '$successText' },
	{ text: t('snAvatarGroup.avatarWarn'), bgColor: '$warning', textColor: '$warningText' },
	{ text: t('snAvatarGroup.avatarError'), bgColor: '$error', textColor: '$errorText' }
])

const lastEvent = ref<string>(t('snAvatarGroup.noEvent'))

function onGroupClick(item: SnAvatarGroupItem): void {
	lastEvent.value = t('snAvatarGroup.clickEvent', { name: item.text != null && item.text != '' ? item.text : item.src } as UTSJSONObject)
}

function onGroupDbClick(item: SnAvatarGroupItem): void {
	lastEvent.value = t('snAvatarGroup.dbclickEvent', { name: item.text != null && item.text != '' ? item.text : item.src } as UTSJSONObject)
}
</script>

