				<sn-avatar-group :data="avatarList" mode="spread" />
			</view>
		</demo-card>

		<demo-card :title="t('snAvatarGroup.max')" :subtitle="t('snAvatarGroup.maxSub')">
			<view class="demo-row" flatten>
