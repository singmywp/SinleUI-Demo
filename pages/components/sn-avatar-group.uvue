					<sn-avatar-group :data="avatarList" random-bg-color />
					<sn-text text-class="demo-label" font-size="$12" color="$textLight" flatten>{{ t('snAvatarGroup.heapRandom') }}</sn-text>
				</view>
				<view class="demo-item">
					<sn-avatar-group :data="avatarList" mode="spread" random-bg-color />
					<sn-text text-class="demo-label" font-size="$12" color="$textLight">{{ t('snAvatarGroup.spreadRandom') }}</sn-text>
				</view>
