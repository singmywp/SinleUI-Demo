					<sn-avatar-group :data="avatarList" :max="3" />
					<sn-text text-class="demo-label" font-size="$12" color="$textLight" flatten>max=3</sn-text>
				</view>
				<view class="demo-item" flatten>
					<sn-avatar-group :data="avatarList" :max="5" />
					<sn-text text-class="demo-label" font-size="$12" color="$textLight" flatten>max=5</sn-text>
				</view>
			</view>
		</demo-card>

		<demo-card :title="t('snAvatarGroup.randomColor')" :subtitle="t('snAvatarGroup.randomColorSub')">
			<view class="demo-row" flatten>
