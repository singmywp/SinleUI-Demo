<template>
	<sn-page :title="pageTitle" :show-back="true">
		<view class="agr-content">
			<sn-text font-size="$11" color="$textLight" flatten>{{ t('tmplAgreement.updateDate') }}</sn-text>
			<view class="agr-card">
				<sn-e-markdown :text="content" />
			</view>
		</view>
	</sn-page>
</template>

<script lang="uts" setup>
import { useI18n } from 'vue-i18n'

const { t } = useI18n()

const docType = ref<string>('user')

const pageTitle = computed<string>((): string => {
	return docType.value == 'privacy' ? t('tmplAgreement.privacyTitle') : t('tmplAgreement.userTitle')
})

const content = computed<string>((): string => {
	return docType.value == 'privacy' ? t('tmplAgreement.privacyContent') : t('tmplAgreement.userContent')
})

onLoad((options: OnLoadOptions): void => {
	docType.value = options['type'] ?? 'user'
})
</script>

<style lang="scss">
.agr-content {
	flex-direction: column;
	padding: 12px 16px 32px 16px;
}

.agr-card {
	flex-direction: column;
	background-color: var(--sn-front);
	border-radius: 16px;
	padding: 16px;
	margin-top: 12px;
}
</style>
