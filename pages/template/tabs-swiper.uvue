			<sn-tabs v-model="tabIndex" :data="tabs" mode="push" bg-color="$front" height="44px" />
			<swiper class="news-swiper" :current="tabIndex" @change="onSwiperChange">
				<swiper-item v-for="(channel, ci) in channels" :key="`ch-${ci}`">
					<view class="news-channel-box">
						<news-channel :base="channel" />
