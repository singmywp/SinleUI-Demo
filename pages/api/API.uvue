	styles.set('paddingBottom', '14px')
	styles.set('paddingLeft', '14px')
	styles.set('overflow', 'hidden')
	styles.set('position', 'relative')
	styles.set('transform', pressedPlugin.value == idx ? 'scale(0.97)' : 'scale(1)')
	styles.set('transitionProperty', 'transform, box-shadow, background-color')
	styles.set('transitionDuration', '150ms')
	return styles
}

function getCatIconWrapStyle(cat: GridCard): Map<string, any> {
	const styles = new Map<string, any>()
	styles.set('width', '40px')
	styles.set('height', '40px')
	styles.set('borderRadius', `${factorRadius(12)}px`)
	styles.set('alignItems', 'center')
	styles.set('justifyContent', 'center')
	styles.set('marginBottom', '10px')
	styles.set('backgroundColor', cat.lightColor)
	return styles
}

function getLibIconWrapStyle(lib: CoreLib): Map<string, any> {
	const styles = new Map<string, any>()
	styles.set('width', '40px')
	styles.set('height', '40px')
	styles.set('borderRadius', `${factorRadius(12)}px`)
	styles.set('alignItems', 'center')
	styles.set('justifyContent', 'center')
	styles.set('marginBottom', '10px')
	styles.set('backgroundColor', lib.lightColor)
	return styles
}

function getCatCountStyle(cat: GridCard): Map<string, any> {
	const styles = new Map<string, any>()
	styles.set('position', 'absolute')
	styles.set('top', '12px')
	styles.set('right', '12px')
	styles.set('paddingLeft', '7px')
	styles.set('paddingRight', '7px')
	styles.set('paddingTop', '2px')
	styles.set('paddingBottom', '2px')
	styles.set('borderRadius', `${factorRadius(8)}px`)
	styles.set('backgroundColor', cat.lightColor)
	return styles
}

const popupShellStyle = computed((): Map<string, any> => {
	const styles = new Map<string, any>()
	styles.set('width', '320px')
	styles.set('borderRadius', `${factorRadius(24)}px`)
	styles.set('overflow', 'hidden')
	styles.set('position', 'relative')
	styles.set('flexDirection', 'column')
	return styles
})

const popupGlowLayerStyle = computed((): Map<string, any> => {
	const styles = new Map<string, any>()
	styles.set('position', 'absolute')
	styles.set('top', '0')
	styles.set('left', '0')
	styles.set('right', '0')
	styles.set('bottom', '0')
	styles.set('borderRadius', `${factorRadius(24)}px`)
	styles.set('backgroundColor', isDark.value ? $snui.darkBgColor : $snui.lightBgColor)
	styles.set('overflow', 'hidden')
	return styles
})

const popupGlowOrbStyle = computed((): Map<string, any> => {
	const styles = new Map<string, any>()
	styles.set('width', '200px')
	styles.set('height', '200px')
	styles.set('borderRadius', '100px')
	styles.set('position', 'absolute')
	styles.set('top', '-80px')
	styles.set('right', '-60px')
	let color = 'rgba(77,130,255,0.15)'
	if (activeCat.value >= 0) {
		color = popupCategories.value[activeCat.value].color + '22'
	}
	styles.set('backgroundColor', color)
	return styles
})

const popupStyle = computed((): Map<string, any> => {
	const styles = new Map<string, any>()
	styles.set('paddingTop', '16px')
	styles.set('paddingLeft', '16px')
	styles.set('paddingRight', '16px')
	styles.set('paddingBottom', '16px')
	styles.set('backgroundColor', glassBgColor.value)
	styles.set('backdropFilter', 'blur(20px)')
	styles.set('borderTopWidth', '1px')
	styles.set('borderTopStyle', 'solid')
	styles.set('borderTopColor', glassBorderColor.value)
	styles.set('flexDirection', 'column')
	styles.set('maxHeight', '440px')
	styles.set('position', 'relative')
	styles.set('zIndex', 1)
	return styles
})

const popupCloseStyle = computed((): Map<string, any> => {
	const styles = new Map<string, any>()
	styles.set('width', '32px')
	styles.set('height', '32px')
	styles.set('borderRadius', `${factorRadius(16)}px`)
	styles.set('alignItems', 'center')
	styles.set('justifyContent', 'center')
	styles.set('backgroundColor', isDark.value ? 'rgba(255,255,255,0.08)' : 'rgba(15,23,42,0.05)')
	return styles
})

function getPopupIconWrapStyle(): Map<string, any> {
	const styles = new Map<string, any>()
	styles.set('width', '36px')
	styles.set('height', '36px')
	styles.set('borderRadius', `${factorRadius(10)}px`)
	styles.set('alignItems', 'center')
	styles.set('justifyContent', 'center')
	styles.set('marginRight', '10px')
	if (activeCat.value >= 0) {
		styles.set('backgroundColor', popupCategories.value[activeCat.value].lightColor)
	}
	return styles
}

function getPopupItemStyle(idx: number, total: number): Map<string, any> {
	const styles = new Map<string, any>()
	styles.set('flexDirection', 'row')
	styles.set('alignItems', 'center')
	styles.set('paddingTop', '14px')
	styles.set('paddingBottom', '14px')
	styles.set('paddingLeft', '12px')
	styles.set('paddingRight', '12px')
	styles.set('borderRadius', `${factorRadius(10)}px`)
	if (idx < total - 1) {
		styles.set('borderBottomWidth', '1px')
		styles.set('borderBottomStyle', 'solid')
		styles.set('borderBottomColor', itemsBorderColor.value)
	}
	return styles
}

const popupScrollStyle = computed((): Map<string, any> => {
	const styles = new Map<string, any>()
	styles.set('backgroundColor', popupScrollBg.value)
	styles.set('borderRadius', `${factorRadius(14)}px`)
	// #ifdef WEB
	styles.set('maxHeight', '356px')
	// #endif
	return styles
})
</script>

