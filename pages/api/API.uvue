<template>
	<view class="api-page" flatten>
		<scroll-view direction="vertical" class="api-scroll" :show-scrollbar="false">
			<view class="home-topbar-safe" :style="topbarSafeStyle" flatten></view>
			<view class="home-content" flatten>
				<view class="hero-shell" :style="heroShellStyle" >
					<view class="hero-glow-layer" :style="heroGlowLayerStyle" flatten>
						<view class="hero-glow hero-glow-1" flatten :style="glow1Style"></view>
						<view class="hero-glow hero-glow-2" flatten :style="glow2Style"></view>
						<view class="hero-glow hero-glow-3" flatten :style="glow3Style"></view>
					</view>
					<view class="hero-card glass" :style="heroCardStyle" flatten>
						<view class="hero-badge" :style="badgeStyle" flatten>
							<sn-text font-size="$11" :color="accentColor">SinleUI API</sn-text>
						</view>
						<sn-text bold font-size="$32" :color="heroTitleColor"
							custom-style="margin-bottom:8px;letter-spacing:-0.5px;">
							{{ t('apiIndex.heroTitle') }}
						</sn-text>
						<sn-text font-size="$14" :color="heroSubColor" custom-style="margin-bottom:20px;line-height:20px;">
							{{ t('apiIndex.heroSub') }}
						</sn-text>
						<view class="hero-stats" flatten>
							<view class="hero-stat" flatten>
								<sn-text bold font-size="$24" :color="heroAccentColor">{{ globalApiCount }}</sn-text>
								<sn-text font-size="$11" :color="mutedColor">{{ t('apiIndex.globalMethod') }}</sn-text>
							</view>
							<view class="hero-stat-divider" flatten :style="dividerStyle"></view>
							<view class="hero-stat" flatten>
								<sn-text bold font-size="$24" :color="heroAccentColor">{{ utilModuleCount }}</sn-text>
								<sn-text font-size="$11" :color="mutedColor">{{ t('apiIndex.utilModule') }}</sn-text>
							</view>
							<view class="hero-stat-divider" flatten :style="dividerStyle"></view>
							<view class="hero-stat" flatten>
								<sn-text bold font-size="$16" :color="heroAccentColor">{{ platformName }}</sn-text>
								<sn-text font-size="$11" :color="mutedColor">{{ t('apiIndex.platform') }}</sn-text>
							</view>
						</view>
					</view>
				</view>

				<sn-text bold font-size="$17" :color="sectionTitleColor"
					custom-style="margin-top:20px;margin-bottom:12px;margin-left:4px;">{{ t('apiIndex.utilsLib') }}</sn-text>

				<view class="cat-grid">
					<view v-for="(card, ci) in apiCards" :key="'c'+ci" class="cat-card glass" :style="getCatCardStyle(ci)"
						@touchstart="onCatTouchStart(ci)"
						@touchend="onCatTouchEnd" @touchcancel="onCatTouchEnd" @click="onCardClick(card)">
						<view class="cat-card-top" flatten>
							<view class="cat-icon-wrap" flatten :style="getCatIconWrapStyle(card)">
								<sn-icon :name="card.icon" :size="20" :color="card.color" />
							</view>
						</view>
						<sn-text bold font-size="$14" :color="cardTitleColor"
							custom-style="margin-bottom:4px;">{{ card.name }}</sn-text>
						<sn-text font-size="$11" :color="mutedColor">{{ card.desc }}</sn-text>
						<view v-if="card.badge > 0" class="cat-count-badge" :style="getCatCountStyle(card)" flatten>
							<sn-text font-size="$10" :color="card.color">{{ card.badge }}</sn-text>
						</view>
					</view>
				</view>

				<sn-text bold font-size="$17" :color="sectionTitleColor"
					custom-style="margin-top:20px;margin-bottom:12px;margin-left:4px;">{{ t('apiIndex.coreLibs') }}</sn-text>

				<view class="cat-grid">
					<view v-for="(lib, li) in coreLibs" :key="'l' + li" class="cat-card glass" :style="getLibCardStyle(lib, li)"
						@touchstart="onLibTouchStart(li)"
						@touchend="onLibTouchEnd" @touchcancel="onLibTouchEnd" @click="navTo(lib.url)">
						<view class="cat-card-top" flatten>
							<view class="cat-icon-wrap" flatten :style="getLibIconWrapStyle(lib)">
								<sn-icon :name="lib.icon" :size="20" :color="lib.color" />
							</view>
						</view>
						<sn-text bold font-size="$14" :color="cardTitleColor"
							custom-style="margin-bottom:4px;">{{ lib.name }}</sn-text>
						<sn-text font-size="$11" :color="mutedColor">{{ lib.desc }}</sn-text>
					</view>
				</view>

				<sn-text bold font-size="$17" :color="sectionTitleColor"
					custom-style="margin-top:20px;margin-bottom:12px;margin-left:4px;">{{ t('apiIndex.pluginLibs') }}</sn-text>

				<view class="cat-grid">
					<view v-for="(lib, pi) in pluginLibs" :key="'p' + pi" class="cat-card glass" :style="getPluginCardStyle(pi)"
						@touchstart="onPluginTouchStart(pi)"
						@touchend="onPluginTouchEnd" @touchcancel="onPluginTouchEnd" @click="navTo(lib.url)">
						<view class="cat-card-top" flatten>
							<view class="cat-icon-wrap" flatten :style="getLibIconWrapStyle(lib)">
								<sn-icon :name="lib.icon" :size="20" :color="lib.color" />
							</view>
						</view>
						<sn-text bold font-size="$14" :color="cardTitleColor"
							custom-style="margin-bottom:4px;">{{ lib.name }}</sn-text>
						<sn-text font-size="$11" :color="mutedColor">{{ lib.desc }}</sn-text>
					</view>
				</view>

			</view>
			<view class="home-tabbar-safe" :style="tabbarSafeStyle" flatten></view>
		</scroll-view>

		<sn-popup ref="popupRef" position="center" ani-time="$normal" @clickoverlay="closeCatPopup">
			<view class="cat-popup-shell" :style="popupShellStyle">
				<view class="cat-popup-glow" :style="popupGlowLayerStyle">
					<view class="popup-glow-orb" flatten :style="popupGlowOrbStyle"></view>
				</view>
				<view class="cat-popup" :style="popupStyle">
					<view class="popup-header">
						<view class="popup-title-row" flatten>
							<view v-if="activeCat >= 0" class="popup-icon-wrap" flatten :style="getPopupIconWrapStyle()">
								<sn-icon :name="popupCategories[activeCat].icon" :size="18" :color="popupCategories[activeCat].color" />
							</view>
							<sn-text v-if="activeCat >= 0" bold font-size="$16" :color="cardTitleColor">
								{{ popupCategories[activeCat].name }}
							</sn-text>
						</view>
						<view class="popup-close" :style="popupCloseStyle" @click="closeCatPopup">
							<sn-icon name="close-line" :size="16" :color="mutedColor" />
						</view>
					</view>
					<scroll-view direction="vertical" class="popup-scroll" :show-scrollbar="false" :style="popupScrollStyle">
						<view v-if="activeCat >= 0 && popupCategories[activeCat].items.length > 0" class="popup-items" flatten>
							<view v-for="(item, ii) in popupCategories[activeCat].items" :key="'i'+ii"
								class="popup-item" :style="getPopupItemStyle(ii, popupCategories[activeCat].items.length)"
								@click="navTo(item.url)">
								<sn-icon :name="item.icon" :size="18" :color="accentColor"/>
								<view class="popup-item-body" flatten>
									<sn-text font-size="$14" :color="itemColor">{{ item.name }}</sn-text>
									<sn-text font-size="$11" :color="mutedColor" custom-style="margin-top:2px;">{{ item.desc }}</sn-text>
								</view>
								<sn-icon name="arrow-right-s-line" :size="16" :color="mutedColor"/>
							</view>
						</view>
						<view v-else class="popup-empty" flatten>
							<sn-icon name="inbox-line" :size="40" :color="mutedColor" />
							<sn-text font-size="$13" :color="mutedColor" custom-style="margin-top:12px;">{{ t('apiIndex.empty') }}</sn-text>
						</view>
					</scroll-view>
				</view>
			</view>
		</sn-popup>
	</view>
</template>

<script lang="ts" setup>
import { useI18n } from 'vue-i18n'
import { $snui, useTheme, useTabbarHeights } from '@/uni_modules/sinle-ui/index.ts'
import type { ComponentPublicInstance } from 'vue'

const { t } = useI18n()

type Props = {
}

const props = withDefaults(defineProps<Props>(), {})

const { isDark } = useTheme()
const { tabbarHeights } = useTabbarHeights()
const tabbarSafeStyle = computed<string>(() => {
	const height = (tabbarHeights.value['home'] as number | null) ?? 0
	let bottom = 0
	try {
		bottom = uni.getWindowInfo().safeAreaInsets?.bottom ?? 0
	} catch (e) {
		bottom = 0
	}
	return `height: ${height > 0 ? height + bottom : 0}px; flex-shrink: 0;`
})

const topbarSafeStyle = computed<string>(() => {
	let height = parseInt($snui.topbarHeightResolved)
	if (isNaN(height)) height = 0
	try {
		return `height: ${height + uni.getWindowInfo().statusBarHeight}px; flex-shrink: 0;`
	} catch (e) {
		return `height: ${height}px; flex-shrink: 0;`
	}
})

type ApiEntry = {
	name: string
	desc: string
	icon: string
	url: string
}

type ApiCategory = {
	name: string
	desc: string
	icon: string
	color: string
	lightColor: string
	items: ApiEntry[]
}

type CoreLib = {
	name: string
	desc: string
	icon: string
	color: string
	lightColor: string
	url: string
}

type UtilPage = {
	name: string
	desc: string
	icon: string
	color: string
	lightColor: string
	url: string
	count: number
	popupIndex: number
}

type GridCard = {
	name: string
	desc: string
	icon: string
	color: string
	lightColor: string
	badge: number
	popupIndex: number
	url: string
}

const utilPages = computed<UtilPage[]>(() => [
	{
		name: t('apiIndex.modRandom'), desc: t('apiUtils.randomSub'), icon: 'dice-line',
		color: '#F59E0B', lightColor: 'rgba(245,158,11,0.12)', url: '/pages/api/utils/random', count: 4, popupIndex: -1
	},
	{
		name: t('apiIndex.modBasic'), desc: t('apiUtils.basicSub'), icon: 'function-line',
		color: '#8B5CF6', lightColor: 'rgba(139,92,246,0.12)', url: '/pages/api/utils/basic', count: 3, popupIndex: -1
	},
	{
		name: t('apiIndex.modText'), desc: t('apiUtils.textSub'), icon: 'font-size-2',
		color: '#EC4899', lightColor: 'rgba(236,72,153,0.12)', url: '/pages/api/utils/text', count: 13, popupIndex: -1
	},
	{
		name: t('apiIndex.modVerify'), desc: t('apiUtils.verifySub'), icon: 'shield-check-line',
		color: '#10B981', lightColor: 'rgba(16,185,129,0.12)', url: '/pages/api/utils/verify', count: 17, popupIndex: -1
	},
	{
		name: t('apiIndex.modObject'), desc: t('apiUtils.objectSub'), icon: 'braces-line',
		color: '#0EA5E9', lightColor: 'rgba(14,165,233,0.12)', url: '/pages/api/utils/object', count: 7, popupIndex: -1
	},
	{
		name: t('apiIndex.modSort'), desc: t('apiUtils.sortSub'), icon: 'sort-asc',
		color: '#F97316', lightColor: 'rgba(249,115,22,0.12)', url: '/pages/api/utils/sort', count: 8, popupIndex: -1
	},
	{
		name: t('apiIndex.modEasing'), desc: t('apiUtils.easingSub'), icon: 'line-chart-line',
		color: '#6366F1', lightColor: 'rgba(99,102,241,0.12)', url: '/pages/api/utils/easing', count: 31, popupIndex: -1
	},
	{
		name: t('apiIndex.catPerm'), desc: t('apiUtils.permSub'), icon: 'shield-user-line',
		color: '#EF4444', lightColor: 'rgba(239,68,68,0.12)', url: '/pages/api/utils/perm', count: 8, popupIndex: 1
	}
])

const popupCategories = computed<ApiCategory[]>(() => [
	{
		name: t('apiIndex.catUi'), desc: t('apiIndex.catUiDesc'), icon: 'chat-smile-line',
		color: '#4d82ff', lightColor: 'rgba(77,130,255,0.12)',
		items: [
			{ name: t('apiIndex.toastName'), desc: t('apiIndex.toastDesc'), icon: 'chat-smile-line', url: '/pages/api/show-toast' },
			{ name: t('apiIndex.loadingName'), desc: t('apiIndex.loadingDesc'), icon: 'loader-4-line', url: '/pages/api/show-loading' },
			{ name: t('apiIndex.modalName'), desc: t('apiIndex.modalDesc'), icon: 'window-line', url: '/pages/api/show-modal' },
			{ name: t('apiIndex.actionName'), desc: t('apiIndex.actionDesc'), icon: 'apps-line', url: '/pages/api/show-actionsheet' },
			{ name: t('apiUtils.uiTitle'), desc: t('apiUtils.uiSub'), icon: 'layout-line', url: '/pages/api/utils/ui' }
		]
	},
	{
		name: t('apiIndex.catPerm'), desc: t('apiUtils.permSub'), icon: 'shield-user-line',
		color: '#EF4444', lightColor: 'rgba(239,68,68,0.12)',
		items: [
			{ name: t('apiIndex.permName'), desc: t('apiIndex.permDesc'), icon: 'shield-user-line', url: '/pages/api/perm-listener' },
			{ name: t('apiIndex.permMiscName'), desc: t('apiUtils.permSub'), icon: 'shield-check-line', url: '/pages/api/utils/perm' }
		]
	}
])

const apiCards = computed<GridCard[]>(() => {
	const cards: GridCard[] = []
	const ui = popupCategories.value[0]
	cards.push({
		name: ui.name, desc: ui.desc, icon: ui.icon, color: ui.color, lightColor: ui.lightColor,
		badge: ui.items.length, popupIndex: 0, url: ''
	})
	cards.push({
		name: t('apiIndex.catSystem'), desc: t('apiIndex.catSystemDesc'), icon: 'settings-line',
		color: '#10B981', lightColor: 'rgba(16,185,129,0.12)', badge: 0, popupIndex: -1, url: '/pages/api/utils/system'
	})
	const utils = utilPages.value
	for (let i = 0; i < utils.length; i++) {
		const util = utils[i]
		cards.push({
			name: util.name, desc: util.desc, icon: util.icon, color: util.color, lightColor: util.lightColor,
			badge: util.popupIndex >= 0 ? popupCategories.value[util.popupIndex].items.length : util.count,
			popupIndex: util.popupIndex, url: util.url
		})
	}
	return cards
})

const coreLibs = computed<CoreLib[]>(() => [
	{
		name: t('apiIndex.modColor'), desc: t('apiIndex.colorDesc'), icon: 'palette-line',
		color: '#EC4899', lightColor: 'rgba(236,72,153,0.12)',
		url: '/pages/api/color'
	},
	{
		name: t('apiIndex.modDate'), desc: t('apiIndex.dateDesc'), icon: 'calendar-line',
		color: '#0EA5E9', lightColor: 'rgba(14,165,233,0.12)',
		url: '/pages/api/date'
	},
	{
		name: t('apiIndex.modStore'), desc: t('apiIndex.storeDesc'), icon: 'database-2-line',
		color: '#8B5CF6', lightColor: 'rgba(139,92,246,0.12)',
		url: '/pages/api/store'
	}
])

const pluginLibs = computed<CoreLib[]>(() => [
	{
		name: t('apiIndex.modScan'), desc: t('apiIndex.scanDesc'), icon: 'scan-line',
		color: '#F97316', lightColor: 'rgba(249,115,22,0.12)',
		url: '/pages/api/scan'
	}
])

const pressedCat = ref<number>(-1)
const pressedLib = ref<number>(-1)
const pressedPlugin = ref<number>(-1)
const popupRef = ref<ComponentPublicInstance | null>(null)
const activeCat = ref<number>(-1)

const globalApiCount = computed<number>(() => {
	let total = 0
	for (let i = 0; i < popupCategories.value.length; i++) {
		total += popupCategories.value[i].items.length
	}
	return total
})
const utilModuleCount = computed<number>(() => utilPages.value.length)
const platformName = ref<string>('Web')

function navTo(url: string): void {
	uni.navigateTo({
		url: url
	})
}

function onCatTouchStart(idx: number): void {
	pressedCat.value = idx
}

function onCatTouchEnd(): void {
	pressedCat.value = -1
}

function onLibTouchStart(idx: number): void {
	pressedLib.value = idx
}

function onLibTouchEnd(): void {
	pressedLib.value = -1
}

function onPluginTouchStart(idx: number): void {
	pressedPlugin.value = idx
}

function onPluginTouchEnd(): void {
	pressedPlugin.value = -1
}

function closeCatPopup(): void {
	popupRef.value?.$callMethod('close')
}

function openCat(idx: number): void {
	activeCat.value = idx
	popupRef.value?.$callMethod('open')
}

function onCardClick(card: GridCard): void {
	if (card.popupIndex >= 0) {
		openCat(card.popupIndex)
	} else {
		navTo(card.url)
	}
}

onMounted((): void => {
	try {
		const sysInfo = uni.getSystemInfoSync()
		const platform = sysInfo.uniPlatform as string
		if (platform == 'web') {
			platformName.value = 'Web'
		} else if (platform == 'app') {
			const osName = sysInfo.osName as string
			if (osName == 'android') {
				platformName.value = 'Android'
			} else if (osName == 'ios') {
				platformName.value = 'iOS'
			} else {
				platformName.value = 'App'
			}
		} else if (platform != null) {
			platformName.value = platform
		}
	} catch (e) {
		platformName.value = 'Web'
	}
})

const sectionTitleColor = computed<string>(() => isDark.value ? '#F1F5F9' : '#0F172A')
const cardTitleColor = computed<string>(() => isDark.value ? '#E2E8F0' : '#1E293B')
const mutedColor = computed<string>(() => isDark.value ? 'rgba(255,255,255,0.5)' : 'rgba(15,23,42,0.5)')
const itemColor = computed<string>(() => isDark.value ? '#CBD5E1' : '#334155')
const accentColor = computed<string>(() => $snui.colors.primary)
const heroTitleColor = computed<string>(() => isDark.value ? '#FFFFFF' : '#0F172A')
const heroSubColor = computed<string>(() => isDark.value ? 'rgba(255,255,255,0.6)' : 'rgba(15,23,42,0.55)')
const heroAccentColor = computed<string>(() => isDark.value ? $snui.colors.primaryActive : $snui.colors.primary)
const dividerColor = computed<string>(() => isDark.value ? 'rgba(255,255,255,0.1)' : 'rgba(77,130,255,0.15)')
const glassBgColor = computed<string>(() => isDark.value ? 'rgba(30,41,59,0.5)' : 'rgba(255,255,255,0.6)')
const glassBorderColor = computed<string>(() => isDark.value ? 'rgba(255,255,255,0.1)' : 'rgba(255,255,255,0.9)')
const glassShadow = computed<string>(() => isDark.value
	? '0 8px 32px rgba(0,0,0,0.4)'
	: `0 8px 32px ${$snui.colors.primary}1f`)
const itemsBorderColor = computed<string>(() => isDark.value ? 'rgba(255,255,255,0.08)' : 'rgba(15,23,42,0.06)')
const popupScrollBg = computed<string>(() => isDark.value ? 'rgba(15,23,42,0.4)' : 'rgba(255,255,255,0.7)')

function factorRadius(n: number): number {
	return Math.round(n * $snui.radiusFactor)
}

const heroShellStyle = computed((): Map<string, any> => {
	const styles = new Map<string, any>()
	styles.set('borderRadius', `${factorRadius(24)}px`)
	styles.set('overflow', 'hidden')
	styles.set('position', 'relative')
	styles.set('boxShadow', glassShadow.value)
	return styles
})

const heroGlowLayerStyle = computed((): Map<string, any> => {
	const styles = new Map<string, any>()
	styles.set('position', 'absolute')
	styles.set('top', '0')
	styles.set('left', '0')
	styles.set('right', '0')
	styles.set('bottom', '0')
	styles.set('borderRadius', `${factorRadius(24)}px`)
	styles.set('backgroundColor', isDark.value ? $snui.darkBgColor : $snui.lightBgColor)
	styles.set('overflow', 'hidden')
	return styles
})

const heroCardStyle = computed((): Map<string, any> => {
	const styles = new Map<string, any>()
	styles.set('paddingTop', '28px')
	styles.set('paddingRight', '20px')
	styles.set('paddingBottom', '24px')
	styles.set('paddingLeft', '20px')
	styles.set('backgroundColor', glassBgColor.value)
	// #ifdef WEB
	styles.set('backdropFilter', 'blur(20px)')
	// #endif
	styles.set('borderTopWidth', '1px')
	styles.set('borderTopStyle', 'solid')
	styles.set('borderTopColor', glassBorderColor.value)
	styles.set('position', 'relative')
	styles.set('zIndex', 1)
	return styles
})

const badgeStyle = computed((): Map<string, any> => {
	const styles = new Map<string, any>()
	styles.set('position', 'absolute')
	styles.set('top', '16px')
	styles.set('right', '16px')
	styles.set('paddingLeft', '10px')
	styles.set('paddingRight', '10px')
	styles.set('paddingTop', '4px')
	styles.set('paddingBottom', '4px')
	styles.set('borderRadius', `${factorRadius(10)}px`)
	styles.set('backgroundColor', isDark.value ? 'rgba(77,130,255,0.2)' : 'rgba(77,130,255,0.1)')
	styles.set('zIndex', 2)
	return styles
})

const glow1Style = computed((): Map<string, any> => {
	const styles = new Map<string, any>()
	styles.set('width', '200px')
	styles.set('height', '200px')
	styles.set('borderRadius', '100px')
	styles.set('position', 'absolute')
	styles.set('top', '-60px')
	styles.set('right', '-40px')
	styles.set('backgroundColor', isDark.value ? 'rgba(245,158,11,0.15)' : 'rgba(245,158,11,0.18)')
	return styles
})

const glow2Style = computed((): Map<string, any> => {
	const styles = new Map<string, any>()
	styles.set('width', '160px')
	styles.set('height', '160px')
	styles.set('borderRadius', '80px')
	styles.set('position', 'absolute')
	styles.set('bottom', '-50px')
	styles.set('left', '-30px')
	styles.set('backgroundColor', isDark.value ? 'rgba(139,92,246,0.15)' : 'rgba(139,92,246,0.18)')
	return styles
})

const glow3Style = computed((): Map<string, any> => {
	const styles = new Map<string, any>()
	styles.set('width', '100px')
	styles.set('height', '100px')
	styles.set('borderRadius', '50px')
	styles.set('position', 'absolute')
	styles.set('top', '60px')
	styles.set('left', '-10px')
	styles.set('backgroundColor', isDark.value ? 'rgba(236,72,153,0.1)' : 'rgba(236,72,153,0.12)')
	return styles
})

const dividerStyle = computed((): Map<string, any> => {
	const styles = new Map<string, any>()
	styles.set('width', '1px')
	styles.set('height', '28px')
	styles.set('backgroundColor', dividerColor.value)
	return styles
})

function getCatCardStyle(idx: number): Map<string, any> {
	const styles = new Map<string, any>()
	styles.set('width', '48%')
	styles.set('marginBottom', '12px')
	styles.set('borderRadius', `${factorRadius(20)}px`)
	styles.set('backgroundColor', glassBgColor.value)
	// #ifdef WEB
	styles.set('backdropFilter', 'blur(20px)')
	// #endif
	styles.set('borderWidth', '1px')
	styles.set('borderStyle', 'solid')
	styles.set('borderColor', glassBorderColor.value)
	styles.set('paddingTop', '14px')
	styles.set('paddingRight', '14px')
	styles.set('paddingBottom', '14px')
	styles.set('paddingLeft', '14px')
	styles.set('overflow', 'hidden')
	styles.set('position', 'relative')
	styles.set('transform', pressedCat.value == idx ? 'scale(0.97)' : 'scale(1)')
	styles.set('transitionProperty', 'transform, box-shadow, background-color')
	styles.set('transitionDuration', '150ms')
	return styles
}

function getLibCardStyle(_lib: CoreLib, idx: number): Map<string, any> {
	const styles = new Map<string, any>()
	styles.set('width', '48%')
	styles.set('marginBottom', '12px')
	styles.set('borderRadius', `${factorRadius(20)}px`)
	styles.set('backgroundColor', glassBgColor.value)
	// #ifdef WEB
	styles.set('backdropFilter', 'blur(20px)')
	// #endif
	styles.set('borderWidth', '1px')
	styles.set('borderStyle', 'solid')
	styles.set('borderColor', glassBorderColor.value)
	styles.set('paddingTop', '14px')
	styles.set('paddingRight', '14px')
	styles.set('paddingBottom', '14px')
	styles.set('paddingLeft', '14px')
	styles.set('overflow', 'hidden')
	styles.set('position', 'relative')
	styles.set('transform', pressedLib.value == idx ? 'scale(0.97)' : 'scale(1)')
	styles.set('transitionProperty', 'transform, box-shadow, background-color')
	styles.set('transitionDuration', '150ms')
	return styles
}

function getPluginCardStyle(idx: number): Map<string, any> {
	const styles = new Map<string, any>()
	styles.set('width', '48%')
	styles.set('marginBottom', '12px')
