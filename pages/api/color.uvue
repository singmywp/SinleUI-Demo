<template>
	<sn-page :title="t('apiColor.title')" :show-back="true">
		<demo-card :title="t('apiColor.titleLib')" :subtitle="t('apiColor.subLib')">
			<sn-cell v-for="(item, i) in libItems" :key="`l${i}`" :title="item.name" :label="item.label"
				:border="i < libItems.length - 1">
				<template #value>
					<sn-text font-size="$12" :color="valueColor">{{ item.value }}</sn-text>
				</template>
			</sn-cell>
			<view class="swatch-row" flatten>
				<view v-for="(c, ci) in palette" :key="`p${ci}`" :class="swatchClass(ci, palette.length)" :style="`background-color:${c}`" flatten></view>
			</view>
		</demo-card>

		<demo-card :title="t('apiColor.titleBase')" :subtitle="t('apiColor.subBase')">
			<sn-cell v-for="(item, i) in baseItems" :key="`b${i}`" :title="item.name" :label="item.label"
				:border="i < baseItems.length - 1">
				<template #value>
					<sn-text font-size="$12" :color="valueColor">{{ item.value }}</sn-text>
				</template>
			</sn-cell>
		</demo-card>

		<demo-card :title="t('apiColor.titleFormat')" :subtitle="t('apiColor.subFormat')">
			<sn-cell v-for="(item, i) in formatItems" :key="`f${i}`" :title="item.name" :label="item.label"
				:border="i < formatItems.length - 1">
				<template #value>
					<sn-text font-size="$12" :color="valueColor">{{ item.value }}</sn-text>
				</template>
			</sn-cell>
		</demo-card>

		<demo-card :title="t('apiColor.titleAdjust')" :subtitle="t('apiColor.subAdjust')">
			<view class="base-head" flatten>
				<sn-text font-size="$12" :color="nameColor">{{ t('apiColor.original') }}</sn-text>
				<sn-text font-size="$12" :color="valueColor">{{ baseHex }}</sn-text>
			</view>
			<view class="base-swatch" :style="`background-color:${baseHex}`" flatten></view>
			<sn-cell v-for="(item, i) in adjustCells" :key="`a${i}`" :title="item.name" :label="item.label"
				:border="i < adjustCells.length - 1">
				<template #value>
					<sn-text font-size="$12" :color="valueColor">{{ item.value }}</sn-text>
					<view v-if="item.swatchColor != ''" class="mini-swatch" :style="`background-color:${item.swatchColor}`"
						flatten></view>
				</template>
			</sn-cell>
		</demo-card>

		<demo-card :title="t('apiColor.titleScheme')" :subtitle="t('apiColor.subScheme')">
			<sn-cell v-for="(item, i) in schemeRows" :key="`sc${i}`" :title="item.name" :label="item.label"
				:border="i < schemeRows.length - 1">
				<template #value>
					<view v-for="(c, ci) in item.colors" :key="`sc${i}_${ci}`" class="scheme-dot"
						:style="`background-color:${c}`" flatten></view>
				</template>
			</sn-cell>
		</demo-card>
		<demo-card :title="t('apiColor.titleClone')" :subtitle="t('apiColor.subClone')">
			<sn-cell v-for="(item, i) in cloneItems" :key="`cl${i}`" :title="item.name" :label="item.label"
				:border="i < cloneItems.length - 1">
				<template #value>
					<sn-text font-size="$12" :color="valueColor">{{ item.value }}</sn-text>
				</template>
			</sn-cell>
		</demo-card>
	</sn-page>
</template>

<script lang="ts" setup>
import { useI18n } from 'vue-i18n'
import { ColorLib, TinyColor } from '@/uni_modules/sinle-ui/index.ts'
import { useTheme } from '@/uni_modules/sinle-ui/index.ts'

const { t } = useI18n()
const { isDark } = useTheme()

type DemoItem = {
	name: string
	label: string
	value: string
}

const nameColor = 'var(--sn-text)'
const valueColor = 'var(--sn-primary)'


function swatchClass(ci: number, len: number): string {
	let cls = 'swatch'
	if (ci == len - 1) {
		cls += ' swatch-last'
	}
	return cls
}


function hexList(colors: TinyColor[]): string[] {
	const list: string[] = []
	for (let i = 0; i < colors.length; i++) {
		list.push(colors[i].toHexString())
	}
	return list
}


const palette = computed<string[]>(() => ColorLib.generate('#4d82ff'))

const libItems = computed<DemoItem[]>(() => {
	const randomColor = ColorLib.random()
	return [
		{ name: "tinyColor('#ff6347')", label: t('apiColor.fnTinyColor'), value: ColorLib.tinyColor('#ff6347').toHexString() },
		{ name: 'random()', label: t('apiColor.fnRandom'), value: randomColor.toHexString() },
		{ name: "mean(['#ff0000','#00ff00','#0000ff'])", label: t('apiColor.fnMean'), value: ColorLib.mean(['#ff0000', '#00ff00', '#0000ff']).toHexString() },
		{ name: "generate('#4d82ff')", label: t('apiColor.fnGenerate'), value: `${ColorLib.generate('#4d82ff').length}${t('apiColor.paletteCountSuffix')}` },
		{ name: "calcAPCA('#ffffff', '#000000')", label: t('apiColor.fnCalcAPCA'), value: ColorLib.calcAPCA('#ffffff', '#000000').toString() },
		{ name: "calcAPCA('#000000', '#ffffff')", label: t('apiColor.fnCalcAPCA'), value: ColorLib.calcAPCA('#000000', '#ffffff').toString() }
	]
})


const baseItems = computed<DemoItem[]>(() => {
	const c = ColorLib.tinyColor('#4d82ff')
	const semi = ColorLib.tinyColor('rgba(77, 130, 255, 0.5)')
	return [
		{ name: "isValid('#4d82ff')", label: t('apiColor.fnIsValid'), value: c.isValid.toString() },
		{ name: "isValid('not-a-color')", label: t('apiColor.fnIsValid'), value: ColorLib.tinyColor('not-a-color').isValid.toString() },
		{ name: "isDark()", label: t('apiColor.fnIsDark'), value: c.isDark().toString() },
		{ name: "isLight()", label: t('apiColor.fnIsLight'), value: c.isLight().toString() },
		{ name: 'getBrightness()', label: t('apiColor.fnGetBrightness'), value: c.getBrightness().toString() },
		{ name: 'getLuminance()', label: t('apiColor.fnGetLuminance'), value: c.getLuminance().toFixed(4) },
		{ name: t('apiColor.getAlphaName'), label: t('apiColor.fnGetAlpha'), value: semi.getAlpha().toString() },
		{ name: "setAlpha(0.5).toRgbString()", label: t('apiColor.fnSetAlpha'), value: c.setAlpha(0.5).toRgbString() },
		{ name: "isMonochrome()", label: t('apiColor.fnIsMonochrome'), value: c.isMonochrome().toString() },
		{ name: "isMonochrome('#888888')", label: t('apiColor.fnIsMonochrome'), value: ColorLib.tinyColor('#888888').isMonochrome().toString() }
	]
})


const formatItems = computed<DemoItem[]>(() => {
	const c = ColorLib.tinyColor('#4d82ff')
	const alphaC = ColorLib.tinyColor('rgba(77, 130, 255, 0.4)')
	return [
		{ name: 'toHex()', label: t('apiColor.fnToHex'), value: c.toHex() },
		{ name: 'toHexString()', label: t('apiColor.fnToHexString'), value: c.toHexString() },
		{ name: 'toHexShortString()', label: t('apiColor.fnToHexShortString'), value: c.toHexShortString() },
		{ name: 'toRgbString()', label: t('apiColor.fnToRgbString'), value: c.toRgbString() },
		{ name: 'toPercentageRgbString()', label: t('apiColor.fnToPercentageRgbString'), value: c.toPercentageRgbString() },
		{ name: 'toHslString()', label: t('apiColor.fnToHslString'), value: c.toHslString() },
		{ name: 'toHsvString()', label: t('apiColor.fnToHsvString'), value: c.toHsvString() },
		{ name: 'toHsbString()', label: t('apiColor.fnToHsbString'), value: c.toHsbString() },
		{ name: t('apiColor.toNameBlack'), label: t('apiColor.fnToName'), value: ColorLib.tinyColor('#000000').toName() ?? t('apiColor.noName') },
		{ name: t('apiColor.toNameBlue'), label: t('apiColor.fnToName'), value: c.toName() ?? t('apiColor.noName') },
		{ name: 'toString()', label: t('apiColor.fnToString'), value: c.toString() },
		{ name: 'toNumber()', label: t('apiColor.fnToNumber'), value: c.toNumber().toString() },
		{ name: t('apiColor.toRgbAlpha'), label: t('apiColor.fnToRgbAlpha'), value: alphaC.toRgbString() }
	]
})


const BASE_COLOR = '#4d82ff'

const baseHex = computed<string>(() => ColorLib.tinyColor(BASE_COLOR).toHexString())


type AdjustCell = {
	name: string
	label: string
	value: string
	swatchColor: string
}

const adjustCells = computed<AdjustCell[]>(() => {
	const c = ColorLib.tinyColor(BASE_COLOR)
	const lighten = c.lighten(10).toHexString()
	const brighten = c.brighten(10).toHexString()
	const darken = c.darken(10).toHexString()
	const tint = c.tint(20).toHexString()
	const shade = c.shade(20).toHexString()
	const saturate = c.saturate(20).toHexString()
	const desaturate = c.desaturate(20).toHexString()
	const greyscale = c.greyscale().toHexString()
	const spin = c.spin(60).toHexString()
	const mix = c.mix('#000000', 30).toHexString()
	return [
		{ name: 'lighten(10)', label: t('apiColor.fnLighten'), value: lighten, swatchColor: lighten },
		{ name: 'brighten(10)', label: t('apiColor.fnBrighten'), value: brighten, swatchColor: brighten },
		{ name: 'darken(10)', label: t('apiColor.fnDarken'), value: darken, swatchColor: darken },
		{ name: 'tint(20)', label: t('apiColor.fnTint'), value: tint, swatchColor: tint },
		{ name: 'shade(20)', label: t('apiColor.fnShade'), value: shade, swatchColor: shade },
		{ name: 'saturate(20)', label: t('apiColor.fnSaturate'), value: saturate, swatchColor: saturate },
		{ name: 'desaturate(20)', label: t('apiColor.fnDesaturate'), value: desaturate, swatchColor: desaturate },
		{ name: 'greyscale()', label: t('apiColor.fnGreyscale'), value: greyscale, swatchColor: greyscale },
		{ name: 'spin(60)', label: t('apiColor.fnSpin'), value: spin, swatchColor: spin },
		{ name: "mix('#000000', 30)", label: t('apiColor.fnMix'), value: mix, swatchColor: mix },
		{ name: "equals('#4d82ff')", label: t('apiColor.fnEquals'), value: c.equals('#4d82ff').toString(), swatchColor: '' },
		{ name: "equals('#ff0000')", label: t('apiColor.fnEquals'), value: c.equals('#ff0000').toString(), swatchColor: '' }
	]
})


type SchemeRow = {
	name: string
	label: string
	colors: string[]
}

const schemeRows = computed<SchemeRow[]>(() => {
	const c = ColorLib.tinyColor(BASE_COLOR)
	return [
		{ name: 'analogous(6, 30)', label: t('apiColor.fnAnalogous'), colors: hexList(c.analogous(6, 30)) },
		{ name: 'complement()', label: t('apiColor.fnComplement'), colors: hexList([c.complement()]) },
		{ name: 'monochromatic(6)', label: t('apiColor.fnMonochromatic'), colors: hexList(c.monochromatic(6)) },
		{ name: 'splitcomplement()', label: t('apiColor.fnSplitcomplement'), colors: hexList(c.splitcomplement()) },
		{ name: 'triad()', label: t('apiColor.fnTriad'), colors: hexList(c.triad()) },
		{ name: 'tetrad()', label: t('apiColor.fnTetrad'), colors: hexList(c.tetrad()) },
		{ name: 'polyad(5)', label: t('apiColor.fnPolyad'), colors: hexList(c.polyad(5)) },
		{ name: "onBackground('#ffffff')", label: t('apiColor.fnOnBackground'), colors: hexList([c.onBackground('#ffffff')]) },
		{ name: "onBackground('#000000')", label: t('apiColor.fnOnBackground'), colors: hexList([c.onBackground('#000000')]) }
	]
})


const cloneItems = computed<DemoItem[]>(() => {
	const c = ColorLib.tinyColor('#4d82ff')
	const clone = c.clone()
	return [
		{ name: 'clone()', label: t('apiColor.fnClone'), value: clone.toHexString() },
		{ name: 'clone().darken(20)', label: t('apiColor.cloneName'), value: `${c.toHexString()} / ${clone.darken(20).toHexString()}` }
	]
})
</script>

<style lang="scss">
.swatch-row {
	flex-direction: row;
	margin-top: 10px;
}
.swatch {
	height: 34px;
	flex: 1;
	border-radius: 6px;
	align-items: center;
	justify-content: center;
	margin-right: 4px;
}
.swatch-last {
	margin-right: 0;
}
.base-head {
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	margin-bottom: 8px;
}
.base-swatch {
	height: 64px;
	border-radius: 12px;
}
.mini-swatch {
	width: 14px;
	height: 14px;
	border-radius: 50%;
	margin-left: 8px;
	border-width: 1px;
	border-style: solid;
	border-color: rgba(128, 128, 128, 0.25);
}
.scheme-dot {
	width: 22px;
	height: 22px;
	border-radius: 50%;
	margin-left: 6px;
	border-width: 1px;
	border-style: solid;
	border-color: rgba(128, 128, 128, 0.25);
}
</style>
