<template>
	<sn-page :show-back="false" fill-content>
		<sn-topbar :fixed="true" :status-bar="true"
			:blur="true" :blur-radius="20" :blur-opacity="0.68"
			:back-button="false" :features="topbarFeatures" :menu-data="menuData"
			@featureclick="onFeatureClick" @menuselect="onMenuSelect">
			<template #default>
				<sn-text bold font-size="$20" :color="titleColor">SinleUI</sn-text>
			</template>
		</sn-topbar>

		<view class="page-slot">
			<components-page v-if="tabbarIndex == 1" />
			<api-page v-else-if="tabbarIndex == 2" />
			<template-page v-else />
		</view>
		<sn-tabbar tabbar-key="home" :data="tabbarData" :index="tabbarIndex" fixed
			:blur="true" :blur-radius="20" :blur-opacity="0.68"
			:custom-style="tabbarStyleText" @change="onTabbarChange" />
	</sn-page>
</template>

<script lang="ts" setup>
import { useI18n } from 'vue-i18n'
import type { SnDataItem, SnTabbarItem } from '@/uni_modules/sinle-ui/core/types/index.ts'
import ComponentsPage from '@/pages/components/components.uvue'
import ApiPage from '@/pages/api/API.uvue'
import TemplatePage from '@/pages/template/template.uvue'

const { t } = useI18n()

const tabbarData = computed<SnTabbarItem[]>(() => [
	{
		icon: 'shapes-line',
		text: t('index.tab.components'),
		activeIcon: 'shapes-fill'
	},
	{
		icon: 'code-s-slash-line',
		text: t('index.tab.api'),
		activeIcon: 'code-s-slash-fill'
	},
	{
		icon: 'layout-line',
		text: t('index.tab.template'),
		activeIcon: 'layout-fill'
	}
])

const topbarFeatures: SnDataItem[] = [
	{ id:'settings', icon: 'settings-line' }
]

const menuData = computed<SnDataItem[]>(() => [
	{ id: 'about-framework', icon: 'information-line', text: t('index.menu.aboutFramework') },
	{ id: 'about-app', icon: 'apps-line', text: t('index.menu.aboutApp') },
	{ id: 'document', icon: 'book-2-line', text: t('index.menu.document') },
	{ id: 'uniappx', icon: 'user-2-line', text: t('index.menu.uniappx') },
	{ id: 'ui', icon: 'quill-pen-line', text: t('index.menu.ui') }
])

const tabbarIndex = ref<number>(1)

const bottomSafeNum = computed<number>(() => {
	try {
		return uni.getWindowInfo().safeAreaInsets?.bottom ?? 0
	} catch (e) {
		return 0
	}
})

const tabbarStyleText = computed<string>(() => `bottom: ${bottomSafeNum.value}px;`)

const titleColor = 'var(--sn-title)'

function goTo(url: string): void {
	uni.navigateTo({
		url: url
	})
}

function onFeatureClick(item: SnDataItem, index: number): void {
	if (item.id == 'settings') {
		goTo('/pages/other/settings')
	}
}

function onMenuSelect(item: SnDataItem, _index: number): void {
	let url = ''
	if (item.id == 'about-framework') {
		url = '/pages/other/about'
	} else if (item.id == 'about-app') {
		url = '/pages/other/about-app'
	} else if (item.id == 'document') {
		url = '/pages/other/webview?title=' + encodeURI(t('index.docTitle')) + '&url=' + encodeURI('https://sinleui.pages.dev/')
	} else if (item.id == 'uniappx') {
		url = '/pages/other/webview?title=' + encodeURI(t('index.uniappxDocTitle')) + '&url=' + encodeURI('https://doc.dcloud.net.cn/uni-app-x/')
	} else if (item.id == 'ui') {
		url = '/pages/other/ui'
	}
	if (url != '') {
		goTo(url)
	}
}

function onTabbarChange(index: number): void {
	tabbarIndex.value = index
}
</script>


<style lang="scss">
.page-slot {
	flex: 1;
	min-height: 0px;
	flex-direction: column;
}
</style>
