<template>
	<view class="demo-card-shell" :style="shellStyle">
		<view class="demo-card" :style="cardStyle">
			<view v-if="hasHeader" class="demo-card-header" :style="headerStyle">
				<slot name="title">
					<text :style="titleStyle">{{ title }}</text>
				</slot>
				<slot name="header-extra" />
			</view>
			<view v-if="hasSubtitle" class="demo-card-subtitle">
				<slot name="subtitle">
					<text :style="subtitleStyle">{{ subtitle }}</text>
				</slot>
			</view>
<view class="demo-card-body" :style="bodyStyle" v-if="$slots['default'] != null">
				<slot />
			</view>
		</view>
	</view>
</template>

<script lang="ts" setup>
import { useTheme, useFactors } from '@/uni_modules/sinle-ui/index.uts'

defineOptions({
	name: 'DemoCard'
})

const { isDark } = useTheme()
const { fontsizeFactor, marginFactor, paddingFactor, radiusFactor } = useFactors()

type Props = {
	title?: string
	subtitle?: string
}

const props = withDefaults(defineProps<Props>(), {
	title: '',
	subtitle: ''
})

const slots = useSlots()

const hasHeader = computed<boolean>(() => {
	return props.title != '' || slots['title'] != null
})

const hasSubtitle = computed<boolean>(() => {
	return props.subtitle != '' || slots['subtitle'] != null
})

const titleColor = computed<string>(() => isDark.value ? '#E2E8F0' : '#1E293B')
const subColor = computed<string>(() => isDark.value ? 'rgba(255,255,255,0.5)' : 'rgba(15,23,42,0.5)')

const titleStyle = computed((): Map<string, any> => {
	const styles = new Map<string, any>()
	styles.set('fontSize', `${Math.round(16 * fontsizeFactor.value)}px`)
	styles.set('fontWeight', '600')
	styles.set('color', titleColor.value)
	return styles
})

const subtitleStyle = computed((): Map<string, any> => {
	const styles = new Map<string, any>()
	styles.set('fontSize', `${Math.round(12 * fontsizeFactor.value)}px`)
	styles.set('color', subColor.value)
	return styles
})
const glassBorder = computed<string>(() => isDark.value ? 'rgba(255,255,255,0.08)' : 'rgba(255,255,255,0.9)')

const shellStyle = computed((): Map<string, any> => {
	const styles = new Map<string, any>()
	styles.set('borderRadius', `${Math.round(20 * radiusFactor.value)}px`)
	styles.set('marginBottom', `${Math.round(16 * marginFactor.value)}px`)
	styles.set('marginLeft', `${Math.round(16 * marginFactor.value)}px`)
	styles.set('marginRight', `${Math.round(16 * marginFactor.value)}px`)
	return styles
})

const cardStyle = computed((): Map<string, any> => {
	const styles = new Map<string, any>()
	styles.set('paddingTop', `${Math.round(20 * paddingFactor.value)}px`)
	styles.set('paddingRight', `${Math.round(16 * paddingFactor.value)}px`)
	styles.set('paddingBottom', `${Math.round(20 * paddingFactor.value)}px`)
	styles.set('paddingLeft', `${Math.round(16 * paddingFactor.value)}px`)
	styles.set('backgroundColor', 'var(--sn-front)')
	styles.set('borderTopWidth', '1px')
	styles.set('borderTopStyle', 'solid')
	styles.set('borderRadius', `${Math.round(15 * radiusFactor.value)}px`)
	styles.set('borderTopColor', glassBorder.value)
	styles.set('flexDirection', 'column')
	return styles
})

const headerStyle = computed((): Map<string, any> => {
	const styles = new Map<string, any>()
	styles.set('marginBottom', `${Math.round(8 * marginFactor.value)}px`)
	return styles
})

const bodyStyle = computed((): Map<string, any> => {
	const styles = new Map<string, any>()
	styles.set('marginTop', `${Math.round(16 * marginFactor.value)}px`)
	return styles
})
</script>

<style lang="scss">
.demo-card {
	overflow: visible;
	transition-property: all;
	transition-duration: var(--ani-time-normal);
}



.demo-card-shell {
	overflow: visible;
	flex-direction: column;
	transition-property: all;
	transition-duration: var(--ani-time-normal);
}

.demo-card-header {
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	position: relative;
}
.demo-card-subtitle {
	position: relative;
}
.demo-card-body {
	flex-direction: column;
	overflow: visible;
}
</style>
